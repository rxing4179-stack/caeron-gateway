<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta name="referrer" content="no-referrer">
<script>
(function(){
  var token = localStorage.getItem('caeron_admin_token');
  if (!token) {
    token = prompt('Caeron Admin Token:');
    if (token) localStorage.setItem('caeron_admin_token', token);
  }
  if (token) {
    var _fetch = window.fetch;
    window.fetch = function(url, opts) {
      if (typeof url === 'string' && url.indexOf('/admin/api/') !== -1) {
        opts = opts || {};
        opts.headers = opts.headers || {};
        if (opts.headers instanceof Headers) {
          opts.headers.set('Authorization', 'Bearer ' + token);
        } else {
          opts.headers['Authorization'] = 'Bearer ' + token;
        }
      }
      return _fetch.call(this, url, opts);
    };
  }
  window.__caeronLogout = function(){ localStorage.removeItem('caeron_admin_token'); location.reload(); };
})();
</script>
    <script>
    window.onerror = function(msg, url, line, col, error) {
        var d = document.createElement('div');
        d.style.cssText = 'position:fixed;top:0;left:0;right:0;z-index:99999;background:#ff4444;color:white;padding:16px;font-size:14px;font-family:monospace;white-space:pre-wrap;word-break:break-all;max-height:50vh;overflow:auto';
        d.textContent = 'JS ERROR:\n' + msg + '\nFile: ' + url + '\nLine: ' + line + ', Col: ' + col + '\n' + (error && error.stack ? error.stack : '');
        document.body ? document.body.prepend(d) : document.addEventListener('DOMContentLoaded', function(){document.body.prepend(d)});
        return false;
    };
    window.addEventListener('unhandledrejection', function(e) {
        var d = document.createElement('div');
        d.style.cssText = 'position:fixed;top:0;left:0;right:0;z-index:99999;background:#ff6600;color:white;padding:16px;font-size:14px;font-family:monospace;white-space:pre-wrap;word-break:break-all;max-height:50vh;overflow:auto';
        d.textContent = 'PROMISE ERROR:\n' + (e.reason ? (e.reason.stack || e.reason.message || String(e.reason)) : 'unknown');
        document.body ? document.body.prepend(d) : document.addEventListener('DOMContentLoaded', function(){document.body.prepend(d)});
    });
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Caeron Gateway</title>
    <!-- Vue 3 -->
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        slate: {
                            850: '#151f32',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #0f172a;
            color: #f8fafc;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }
        
        .toast-enter-active, .toast-leave-active {
            transition: all 0.3s ease;
        }
        .toast-enter-from {
            opacity: 0;
            transform: translateY(20px);
        }
        .toast-leave-to {
            opacity: 0;
            transform: translateY(-20px);
        }

        /* 隐藏滚动条但保留功能 */
        .hide-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .hide-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        @keyframes spin-slow {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .animate-spin-slow {
            animation: spin-slow 8s linear infinite;
        }
    </style>
</head>
<body class="bg-[#deebec] text-[#2c3e50] min-h-screen pb-20">
    <div id="app" class="max-w-md mx-auto w-full">
        <!-- 头部导航 -->
        <header class="sticky top-0 z-30 bg-white/90 backdrop-blur-md border-b border-[#aecfd1] px-4 py-3 flex justify-between items-center">
            <h1 class="text-xl font-bold bg-gradient-to-r from-blue-400 to-cyan-300 bg-clip-text text-transparent">
                Caeron Gateway
            </h1>
            <div class="flex items-center gap-3">
                <!-- 技术模式开关 -->
                <div class="flex items-center gap-1.5 select-none cursor-pointer" @click="toggleTechMode()">
                    <span class="text-[10px] font-medium" :class="techMode ? 'text-amber-500' : 'text-[#5a7a7d]'">{{ techMode ? '⚙ 技术' : '💬 日常' }}</span>
                    <div class="relative w-9 h-5 rounded-full transition-colors duration-300" :class="techMode ? 'bg-amber-400' : 'bg-[#aecfd1]'">
                        <div class="absolute top-0.5 w-4 h-4 rounded-full bg-white shadow-md transition-all duration-300" :class="techMode ? 'left-[18px]' : 'left-0.5'"></div>
                    </div>
                </div>
                <div class="text-xs text-[#5a7a7d] font-mono">v0.1.0</div>
            </div>
        </header>

        <nav class="flex overflow-x-auto hide-scrollbar border-b border-[#aecfd1] bg-white px-2">
            <button @click="currentTab = 'providers'" :class="{'border-b-2 border-[#4199a0] text-[#4199a0]': currentTab === 'providers', 'text-[#5a7a7d] hover:text-[#5a7a7d]': currentTab !== 'providers'}" class="px-4 py-3 text-sm font-medium whitespace-nowrap transition-colors">供应商管理</button>
                        <button @click="currentTab = 'toggles'; fetchFeatureToggles()" :class="{'border-b-2 border-[#4199a0] text-[#4199a0]': currentTab === 'toggles', 'text-[#5a7a7d] hover:text-[#5a7a7d]': currentTab !== 'toggles'}" class="px-4 py-3 text-sm font-medium whitespace-nowrap transition-colors">功能开关</button>
            <button @click="currentTab = 'rules'" :class="{'border-b-2 border-[#4199a0] text-[#4199a0]': currentTab === 'rules', 'text-[#5a7a7d] hover:text-[#5a7a7d]': currentTab !== 'rules'}" class="px-4 py-3 text-sm font-medium whitespace-nowrap transition-colors">提示词注入</button>
            <button @click="currentTab = 'conversations'; fetchCalendar()" :class="{'border-b-2 border-[#4199a0] text-[#4199a0]': currentTab === 'conversations', 'text-[#5a7a7d] hover:text-[#5a7a7d]': currentTab !== 'conversations'}" class="px-4 py-3 text-sm font-medium whitespace-nowrap transition-colors">对话记录</button>
            <button @click="currentTab = 'memory'; fetchSummaries(); fetchSummaryStats(); fetchSummaryConfig()" :class="{'border-b-2 border-[#4199a0] text-[#4199a0]': currentTab === 'memory', 'text-[#5a7a7d] hover:text-[#5a7a7d]': currentTab !== 'memory'}" class="px-4 py-3 text-sm font-medium whitespace-nowrap transition-colors">记忆总览</button>
            <button @click="currentTab = 'status'; fetchStatus()" :class="{'border-b-2 border-[#4199a0] text-[#4199a0]': currentTab === 'status', 'text-[#5a7a7d] hover:text-[#5a7a7d]': currentTab !== 'status'}" class="px-4 py-3 text-sm font-medium whitespace-nowrap transition-colors">状态便签</button>
            <button @click="currentTab = 'recall'; fetchMemories(1); fetchMemoriesStats()" :class="{'border-b-2 border-[#4199a0] text-[#4199a0]': currentTab === 'recall', 'text-[#5a7a7d] hover:text-[#5a7a7d]': currentTab !== 'recall'}" class="px-4 py-3 text-sm font-medium whitespace-nowrap transition-colors">便签库召回</button>
            <button @click="currentTab = 'fragments'; fetchFragments(1); fetchFragmentsStats()" :class="{'border-b-2 border-[#4199a0] text-[#4199a0]': currentTab === 'fragments', 'text-[#5a7a7d] hover:text-[#5a7a7d]': currentTab !== 'fragments'}" class="px-4 py-3 text-sm font-medium whitespace-nowrap transition-colors">碎片记忆</button>
            <button @click="currentTab = 'qq_config'; fetchQQConfig()" :class="{'border-b-2 border-[#4199a0] text-[#4199a0]': currentTab === 'qq_config', 'text-[#5a7a7d] hover:text-[#5a7a7d]': currentTab !== 'qq_config'}" class="px-4 py-3 text-sm font-medium whitespace-nowrap transition-colors">QQ设置</button>
                        <button @click="currentTab = 'proactive'; fetchProactiveStatus(); fetchProactiveConfig(); fetchProactiveLogs()" :class="{'border-b-2 border-[#4199a0] text-[#4199a0]': currentTab === 'proactive', 'text-[#5a7a7d] hover:text-[#5a7a7d]': currentTab !== 'proactive'}" class="px-4 py-3 text-sm font-medium whitespace-nowrap transition-colors">主动搭话</button>
            <button @click="currentTab = 'life_hub'; fetchLifeHubAll()" :class="{'border-b-2 border-[#4199a0] text-[#4199a0]': currentTab === 'life_hub', 'text-[#5a7a7d] hover:text-[#5a7a7d]': currentTab !== 'life_hub'}" class="px-4 py-3 text-sm font-medium whitespace-nowrap transition-colors">Life Hub</button>
            <button @click="currentTab = 'simlife'; fetchSimLifeAll()" :class="{'border-b-2 border-[#4199a0] text-[#4199a0]': currentTab === 'simlife', 'text-[#5a7a7d] hover:text-[#5a7a7d]': currentTab !== 'simlife'}" class="px-4 py-3 text-sm font-medium whitespace-nowrap transition-colors">模拟机生</button>
            <a href="/games/snake" target="_blank" class="px-4 py-3 text-sm font-medium whitespace-nowrap transition-colors text-[#5a7a7d] hover:text-[#4199a0] inline-flex items-center">小游戏</a>
        </nav>

        <!-- 主要内容区域 -->
        <main class="p-4">
            <!-- 供应商管理 -->
            <section v-show="currentTab === 'providers'">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-lg font-semibold text-[#2c3e50]">供应商管理</h2>
                    <button @click="openAddProviderModal" class="bg-[#4199a0] hover:bg-[#77b5b4] text-white px-3 py-1.5 rounded-lg text-sm font-medium transition-colors">
                        + 添加
                    </button>
                </div>

                <!-- 供应商列表 -->
                <div class="space-y-3">
                    <div v-if="loading.providers" class="text-center py-8 text-[#77b5b4]">加载中...</div>
                    <div v-else-if="providers.length === 0" class="text-center py-8 text-[#77b5b4] bg-white/50 rounded-xl border border-[#aecfd1]/50">
                        暂无供应���������������������，请点击上方添加
                    </div>
                    
                    <div v-for="provider in providers" :key="provider.id" 
                         class="bg-white rounded-xl p-4 border transition-colors"
                         :class="[provider.is_enabled ? (provider.is_healthy ? 'border-[#aecfd1]' : 'border-red-900/50 bg-red-900/10') : 'border-[#aecfd1]/50 opacity-60']">
                        
                        <!-- 卡片头部 -->
                        <div class="flex justify-between items-start mb-2">
                            <div class="flex items-center gap-2">
                                <div class="w-2.5 h-2.5 rounded-full" 
                                     :class="[!provider.is_enabled ? 'bg-slate-500' : (provider.is_healthy ? 'bg-emerald-500' : 'bg-red-500')]">
                                </div>
                                <h3 class="font-medium text-[#2c3e50]">{{ provider.name }}</h3>
                                <span v-if="provider.priority === 0" class="text-[10px] bg-[#4199a0]/20 text-[#4199a0] px-1.5 py-0.5 rounded border border-[#4199a0]/30">主</span>
                                <span class="text-[10px] bg-[#aecfd1] text-[#5a7a7d] px-1.5 py-0.5 rounded">P{{ provider.priority }}</span>
                            </div>
                            
                            <div class="flex gap-2">
                                <button @click="testProvider(provider.id)" :disabled="loading.test === provider.id" class="text-[#5a7a7d] hover:text-[#4199a0] p-1">
                                    <svg v-if="loading.test === provider.id" class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                                    <svg v-else class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                                </button>
                                <button @click="editProvider(provider)" class="text-[#5a7a7d] hover:text-[#4199a0] p-1">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                                </button>
                            </div>
                        </div>

                        <!-- 卡片内容 -->
                        <div class="space-y-1.5 text-xs">
                            <div class="flex text-[#5a7a7d]">
                                <span class="w-12 shrink-0">URL:</span>
                                <span class="text-[#5a7a7d] font-mono truncate">{{ provider.api_base_url }}</span>
                            </div>
                            <div class="flex text-[#5a7a7d]">
                                <span class="w-12 shrink-0">Key:</span>
                                <span class="text-[#77b5b4] font-mono">{{ provider.api_key_masked }}</span>
                            </div>
                            
                            <!-- 支持的模型 -->
                            <div class="mt-2 pt-2 border-t border-[#aecfd1]/50">
                                <div class="flex flex-wrap gap-1">
                                    <template v-if="parseModels(provider.supported_models).length">
                                        <span v-for="m in parseModels(provider.supported_models)" :key="m" class="text-[10px] bg-[#aecfd1]/50 text-[#5a7a7d] px-1.5 py-0.5 rounded">
                                            {{ m }}
                                        </span>
                                    </template>
                                    <span v-else class="text-[10px] text-[#77b5b4] italic">通配所有模型</span>
                                </div>
                            </div>

                            <!-- 错误信息 -->
                            <div v-if="!provider.is_healthy && provider.last_error" class="mt-2 p-2 bg-red-900/20 text-red-400 rounded border border-red-900/30 font-mono text-[10px] break-all">
                                {{ provider.last_error }}
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            
            <!-- 功能开关 -->
            <section v-show="currentTab === 'toggles'">
                <div class="mb-4">
                    <h2 class="text-lg font-semibold text-[#2c3e50]">功能开关</h2>
                </div>

                <!-- 网关总开关 (单独大卡片) -->
                <div class="mb-6 bg-white rounded-xl p-5 border border-[#aecfd1] shadow-sm flex items-center justify-between">
                    <div>
                        <h3 class="font-bold text-lg text-[#2c3e50]">网关总开关</h3>
                        <p class="text-sm text-[#77b5b4] mt-1">关闭后，网关将退化为纯粹的反向代理，不提供任何提示词注入、记忆或对话总结功能。</p>
                    </div>
                    <div class="flex items-center">
                        <div @click="toggleFeature('gateway_master_switch', !featureToggles.gateway_master_switch)" class="relative w-14 h-7 rounded-full transition-colors duration-300 cursor-pointer" :class="featureToggles.gateway_master_switch ? 'bg-emerald-500' : 'bg-slate-300'">
                            <div class="absolute top-1 w-5 h-5 rounded-full bg-white shadow-md transition-all duration-300" :class="featureToggles.gateway_master_switch ? 'left-8' : 'left-1'"></div>
                        </div>
                    </div>
                </div>

                <!-- 子功能开关列表 -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div v-for="item in featureToggleItems" :key="item.key" class="bg-white rounded-xl p-4 border border-[#aecfd1]/50 shadow-sm flex items-center justify-between" :class="{'opacity-50': !featureToggles.gateway_master_switch}">
                        <div class="pr-4">
                            <h4 class="font-medium text-[#2c3e50]">{{ item.name }}</h4>
                            <p class="text-xs text-[#77b5b4] mt-1">{{ item.desc }}</p>
                        </div>
                        <div class="flex items-center shrink-0">
                            <div @click="featureToggles.gateway_master_switch && toggleFeature(item.key, !featureToggles[item.key])" class="relative w-11 h-6 rounded-full transition-colors duration-300" :class="[!featureToggles.gateway_master_switch ? 'cursor-not-allowed bg-slate-200' : 'cursor-pointer', featureToggles[item.key] ? 'bg-[#4199a0]' : 'bg-slate-300']">
                                <div class="absolute top-0.5 w-5 h-5 rounded-full bg-white shadow-md transition-all duration-300" :class="featureToggles[item.key] ? 'left-[22px]' : 'left-0.5'"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 提示词注入规则管理 -->
            <section v-show="currentTab === 'rules'">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-lg font-semibold text-[#2c3e50]">注入规则</h2>
                    <button @click="openAddRuleModal" class="bg-[#4199a0] hover:bg-[#77b5b4] text-white px-3 py-1.5 rounded-lg text-sm font-medium transition-colors">
                        + 添加
                    </button>
                </div>

                <div class="space-y-3">
                    <div v-if="loading.rules" class="text-center py-8 text-[#77b5b4]">加载中...</div>
                    <div v-else-if="rules.length === 0" class="text-center py-8 text-[#77b5b4] bg-white/50 rounded-xl border border-[#aecfd1]/50">
                        暂无规则，请点击上方添加
                    </div>
                    
                    <div v-for="rule in rules" :key="rule.id" 
                         class="bg-white rounded-xl p-4 border transition-colors"
                         :class="[rule.is_enabled ? 'border-[#aecfd1]' : 'border-[#aecfd1]/50 opacity-60']">
                        
                        <!-- 卡片头部 -->
                        <div class="flex justify-between items-start mb-2">
                            <div class="flex items-center gap-2">
                                <div class="w-2.5 h-2.5 rounded-full" :class="[rule.is_enabled ? 'bg-emerald-500' : 'bg-slate-500']"></div>
                                <h3 class="font-medium text-[#2c3e50]">{{ rule.name }}</h3>
                                <span class="text-[10px] bg-[#aecfd1] text-[#5a7a7d] px-1.5 py-0.5 rounded">优先级: {{ rule.priority }}</span>
                            </div>
                            
                            <div class="flex gap-2">
                                <button @click="editRule(rule)" class="text-[#5a7a7d] hover:text-[#4199a0] p-1">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                                </button>
                            </div>
                        </div>

                        <!-- 卡片内容 -->
                        <div class="space-y-1.5 text-xs text-[#5a7a7d]">
                            <div class="flex"><span class="w-16 shrink-0">位置:</span><span class="text-[#5a7a7d]">{{ {'system_prepend':'系统消息-前置','system_append':'系统消息-追加','user_prepend':'用户消息-前置','user_append':'用户消息-追加','dialog_start':'对话开头','before_latest':'最新消息前','at_depth_N':'指定深度插入'}[rule.position] || rule.position }} <span v-if="rule.position === 'at_depth_N'">(深度: {{ rule.depth }})</span></span></div>
                            <div class="flex"><span class="w-16 shrink-0">角色:</span><span class="text-[#5a7a7d]">{{ {'system':'系统','user':'用户','assistant':'助手','user_wrapped_system':'用户包装的系统消息','assistant_prefill':'助��预��充'}[rule.role] || rule.role }}</span></div>
                            <div v-if="rule.match_condition && rule.match_condition !== '{}'" class="flex">
                                <span class="w-16 shrink-0">条件:</span>
                                <span class="text-[#5a7a7d] font-mono text-[10px]">{{ rule.match_condition }}</span>
                            </div>
                            <div class="mt-2 p-2 bg-[#deebec] rounded text-[10px] font-mono text-[#5a7a7d] whitespace-pre-wrap max-h-24 overflow-y-auto hide-scrollbar">{{ rule.content }}</div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 对话记录 -->
            <section v-show="currentTab === 'conversations'">
                <!-- 顶部工具栏 -->
                <div class="mb-4 space-y-3">
                    <div class="flex justify-between items-center">
                        <h2 class="text-lg font-semibold text-[#2c3e50]">对话记录</h2>
                        <div class="flex items-center gap-2">
                            <!-- 视图切换 -->
                            
                            <button @click="fetchConversations()" class="text-[#5a7a7d] hover:text-[#4199a0] p-1" title="刷新">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                            </button>
                        </div>
                    </div>

                    <!-- 搜索框 -->
                    <div class="relative">
                        <input v-model="searchQuery" @input="debounceSearch" type="text" placeholder="搜索消息内容..."
                               class="w-full bg-white border border-[#aecfd1] rounded-lg pl-9 pr-8 py-2 text-sm text-[#2c3e50] focus:outline-none focus:border-[#4199a0] focus:ring-1 focus:ring-[#4199a0]">
                        <svg class="absolute left-3 top-2.5 w-4 h-4 text-[#77b5b4]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                        <button v-if="searchQuery" @click="searchQuery = ''; searchResults = []" class="absolute right-3 top-2.5 text-[#77b5b4] hover:text-[#4199a0]">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                        </button>
                    </div>


                                </div>

                <!-- 日历热力图 -->
                <div v-show="!searchQuery" class="mb-4 bg-white rounded-xl border border-[#aecfd1] p-3">
                    <div class="flex justify-between items-center mb-2">
                        <button @click="prevMonth" class="text-[#5a7a7d] hover:text-[#4199a0] p-1">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                        </button>
                        <span class="text-sm font-medium text-[#2c3e50]">{{ calendarYear }}年{{ calendarMonth }}月</span>
                        <button @click="nextMonth" class="text-[#5a7a7d] hover:text-[#4199a0] p-1">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                        </button>
                    </div>
                    <div class="grid grid-cols-7 gap-1 text-center">
                        <div v-for="d in ['日','一','二','三','四','五','六']" class="text-[10px] text-[#77b5b4] py-0.5">{{ d }}</div>
                        <template v-for="(week, wi) in calendarWeeks" :key="wi">
                            <div v-for="(cell, ci) in week" :key="wi+'-'+ci"
                                 @click="clickCalendarDay(cell)"
                                 class="aspect-square rounded-md flex flex-col items-center justify-center text-[10px] transition-all relative"
                                 :class="cell ? (cell.count > 0 ? 'cursor-pointer hover:ring-2 hover:ring-[#4199a0]/40 hover:scale-110' : 'bg-[#f5f9f9]') : ''"
                                 :style="cell && cell.count > 0 ? { backgroundColor: `rgba(65,153,160,${Math.min(0.12 + 0.88 * cell.count / maxDayCount, 1)})` } : {}"
                                 :title="cell ? (cell.count > 0 ? cell.day+'日: '+cell.count+'条 (蕊蕊'+cell.user_count+'/沈栖'+cell.assistant_count+')' : cell.day+'日') : ''">
                                <span v-if="cell" :class="cell.count > 0 && cell.count / maxDayCount > 0.5 ? 'text-white font-semibold' : 'text-[#5a7a7d]'" class="leading-none">{{ cell.day }}</span>
                                <span v-if="cell && cell.count > 0" :class="cell.count / maxDayCount > 0.5 ? 'text-white/80' : 'text-[#77b5b4]'" class="text-[8px] leading-none mt-0.5">{{ cell.count }}</span>
                            </div>
                        </template>
                    </div>
                    <div class="flex items-center justify-center gap-3 mt-2 text-[9px] text-[#77b5b4]">
                        <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-sm bg-[#f5f9f9] border border-[#e0e0e0]"></span>0</span>
                        <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-sm" style="background:rgba(65,153,160,0.2)"></span>少</span>
                        <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-sm" style="background:rgba(65,153,160,0.5)"></span>中</span>
                        <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-sm" style="background:rgba(65,153,160,0.85)"></span>多</span>
                        <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-sm bg-[#4199a0]"></span>最多</span>
                    </div>
                </div>

                <!-- 搜索结果区 -->
                <div v-if="searchResults.length > 0" class="mb-4">
                    <h3 class="text-sm font-medium text-[#5a7a7d] mb-2">搜索结果 ({{ searchResults.length }}条)</h3>
                    <div class="space-y-2">
                        <div v-for="sr in searchResults" :key="sr.id" class="bg-white rounded-lg border border-[#aecfd1] p-3">
                            <div class="flex items-center gap-2 mb-1">
                                <span class="text-[10px] font-mono bg-[#4199a0]/20 text-[#4199a0] px-1 py-0.5 rounded">{{ sr.conversation_id.slice(0, 8) }}</span>
                                <span class="text-[10px] px-1.5 py-0.5 rounded" :class="sr.role === 'user' ? 'bg-[#4199a0] text-white' : 'bg-[#aecfd1] text-[#5a7a7d]'">{{ sr.role }}</span>
                                <span class="text-[10px] text-[#77b5b4]">{{ sr.model || '' }}</span>
                                <span class="text-[10px] text-[#77b5b4] ml-auto">{{ formatTime(sr.created_at) }}</span>
                            </div>
                            <p class="text-sm text-[#2c3e50] whitespace-pre-wrap break-words" v-html="highlightSearch(sr.snippet)"></p>
                        </div>
                    </div>
                </div>
                <div v-else-if="searchQuery && !loading.search" class="mb-4 text-center py-4 text-sm text-[#77b5b4]">
                    无���������������������索结果
                </div>
                <div v-if="loading.search" class="mb-4 text-center py-4 text-sm text-[#77b5b4]">搜索中...</div>

                <!-- 窗口分组视图 -->
                <div v-show="false" class="space-y-3">
                    <!-- 创建窗口按钮 -->
                    <div class="flex justify-end mb-1">
                        <button @click="openCreateWindowModal()" class="flex items-center gap-1.5 bg-[#4199a0] hover:bg-[#357e84] text-white text-xs px-3 py-1.5 rounded-lg transition-colors shadow-sm">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                            创建窗口
                        </button>
                    </div>
                    <div v-if="loading.conversations" class="text-center py-8 text-[#77b5b4]">加载中...</div>
                    <div v-else-if="windows.length === 0" class="text-center py-8 text-[#77b5b4] bg-white/50 rounded-xl border border-[#aecfd1]/50">
                        暂无窗口，点击上方按钮创建
                    </div>

                    <div v-for="win in windows" :key="win.window_id ?? 'unassigned'" class="bg-white rounded-xl border overflow-hidden" :style="{ borderColor: win.color || '#aecfd1' }">
                        <!-- 窗口卡片头部 -->
                        <div class="p-3 cursor-pointer hover:bg-[#deebec]/30 transition-colors" @click="toggleWindow(win)">
                            <div class="flex justify-between items-start">
                                <div class="flex-1 min-w-0 mr-3">
                                    <div class="flex items-center gap-2 mb-1">
                                        <span v-if="win.color" class="w-2.5 h-2.5 rounded-full shrink-0" :style="{ backgroundColor: win.color }"></span>
                                        <span v-if="win.is_manual" class="text-[10px] bg-[#4199a0]/15 text-[#4199a0] px-1.5 py-0.5 rounded font-medium">窗口</span>
                                        <span v-else class="text-[10px] bg-gray-200 text-gray-500 px-1.5 py-0.5 rounded font-medium">未归类</span>
                                        <span class="text-[10px] bg-[#aecfd1]/60 text-[#5a7a7d] px-1.5 py-0.5 rounded">{{ win.conversations.length }} 段对话</span>
                                        <span class="text-[10px] bg-[#aecfd1]/60 text-[#5a7a7d] px-1.5 py-0.5 rounded">{{ win.total_messages }} 条消息</span>
                                    </div>
                                    <p class="text-sm text-[#2c3e50] font-medium line-clamp-2">{{ win.title }}</p>
                                    <p v-if="win.description" class="text-[10px] text-[#77b5b4] mt-0.5 line-clamp-1">{{ win.description }}</p>
                                    <div class="text-[10px] text-[#77b5b4] mt-1">
                                        {{ formatTime(win.first_active) }} ~ {{ formatTime(win.last_active) }}
                                    </div>
                                </div>
                                <div class="flex items-center gap-1 shrink-0 mt-1">
                                    <template v-if="win.is_manual">
                                        <button @click.stop="openEditWindowModal(win)" class="text-[#77b5b4] hover:text-[#4199a0] p-1" title="���辑窗口">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                        </button>
                                        <button @click.stop="deleteWindow(win.window_id)" class="text-[#77b5b4] hover:text-red-400 p-1" title="删除窗口">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                        </button>
                                    </template>
                                    <svg class="w-4 h-4 text-[#77b5b4] transition-transform" :class="{'rotate-180': win._expanded}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                </div>
                            </div>
                        </div>

                        <!-- 窗口展开后的对话列表 -->
                        <div v-if="win._expanded" class="border-t border-[#aecfd1]/50 bg-[#f7fafa] p-3 space-y-2">
                            <div v-for="conv in win.conversations" :key="conv.conversation_id" class="bg-white rounded-lg border border-[#aecfd1]/70 overflow-hidden">
                                <!-- 对话卡片头部 (窗口内) -->
                                <div class="p-3 cursor-pointer hover:bg-[#deebec]/30 transition-colors" @click="toggleConversation(conv)">
                                    <div class="flex justify-between items-start">
                                        <div class="flex-1 min-w-0 mr-3">
                                            <div class="flex items-center gap-2 mb-1">
                                                <span class="text-[10px] bg-[#4199a0]/20 text-[#4199a0] px-1.5 py-0.5 rounded font-mono">{{ conv.conversation_id.slice(0, 8) }}</span>
                                                <span class="text-[10px] bg-[#aecfd1] text-[#5a7a7d] px-1.5 py-0.5 rounded">{{ conv.message_count }} 条</span>
                                            </div>
                                            <p class="text-xs text-[#2c3e50] truncate">{{ conv.preview || '(空消息)' }}</p>
                                            <div class="text-[10px] text-[#77b5b4] mt-1">
                                                <span>{{ formatTime(conv.last_message_at || conv.created_at) }}</span>
                                            </div>
                                        </div>
                                        <div class="flex items-center gap-1">
                                            <button v-if="win.is_manual" @click.stop="unassignConversation(conv.conversation_id)" class="text-[#77b5b4] hover:text-amber-500 p-1" title="移出窗口">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                                            </button>
                                            <button v-if="!win.is_manual" @click.stop="openAssignModal(conv.conversation_id)" class="text-[#77b5b4] hover:text-[#4199a0] p-1" title="分配到窗口">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                                            </button>
                                            <button @click.stop="deleteConversation(conv.conversation_id)" class="text-[#77b5b4] hover:text-red-400 p-1" title="删除">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                            </button>
                                            <svg class="w-3.5 h-3.5 text-[#77b5b4] transition-transform" :class="{'rotate-180': expandedConvs.has(conv.conversation_id)}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                        </div>
                                    </div>
                                </div>

                                <!-- 展开的消息列表 (窗口内对话) -->
                                <div v-if="expandedConvs.has(conv.conversation_id)" class="border-t border-[#aecfd1]/50 bg-[#f7fafa] max-h-[60vh] overflow-y-auto hide-scrollbar">
                                    <div v-if="loadingConvs.has(conv.conversation_id)" class="text-center py-6 text-[#77b5b4] text-sm">加载消息中...</div>
                                    <div v-else class="p-3 space-y-2">
                                        <template v-for="msg in messagesMap.get(conv.conversation_id)" :key="msg.id">
                                            <!-- 复用和平铺视图完全相同的消息渲染 -->
                                            <div v-if="isSummary(msg)" class="flex flex-col items-center">
                                                <button @click="msg._showDetail = !msg._showDetail" class="text-[10px] bg-[#d4eaeb]/60 text-[#5a8a8d] px-3 py-1 rounded-full hover:bg-[#d4eaeb]">
                                                    {{ getSummaryType(msg) }} {{ msg._showDetail ? '(收起)' : '(点击展开)' }}
                                                </button>
                                                <div v-if="msg._showDetail" class="mt-2 w-full bg-[#edf5f5]/70 border border-[#c5dfe0]/50 rounded-lg p-3 text-[10px] text-[#5a8a8d] font-mono whitespace-pre-wrap break-all max-h-[200px] overflow-y-auto">
                                                    {{ msg.content.slice(0, 2000) }}{{ msg.content.length > 2000 ? ' ...(已截断)' : '' }}
                                                </div>
                                            </div>
                                            <div v-else-if="msg.role === 'system'" class="flex flex-col items-center">
                                                <button @click="msg._showDetail = !msg._showDetail" class="text-[10px] bg-[#d4eaeb]/60 text-[#5a8a8d] px-3 py-1 rounded-full hover:bg-[#d4eaeb]">
                                                    [系统提示] {{ msg._showDetail ? '收起' : '展开' }}
                                                </button>
                                                <div v-if="msg._showDetail" class="mt-2 w-full bg-[#edf5f5]/70 border border-[#c5dfe0]/50 rounded-lg p-3 text-[10px] text-[#5a8a8d] font-mono whitespace-pre-wrap break-all max-h-[200px] overflow-y-auto">
                                                    {{ msg.content?.slice(0, 1000) }}{{ msg.content?.length > 1000 ? '...' : '' }}
                                                </div>
                                            </div>
                                            <div v-else-if="msg.role === 'assistant' && isEmptyOrToolCall(msg)" class="flex justify-center">
                                                <span class="text-[10px] bg-amber-100/70 text-amber-600 px-2 py-0.5 rounded-full">工具调用</span>
                                            </div>
                                            <div v-else-if="msg.role === 'user'" class="flex flex-col items-end">
                                                <div class="max-w-[85%]">
                                                    <div class="bg-[#4199a0] text-white rounded-2xl rounded-br-md px-3 py-2 text-sm whitespace-pre-wrap break-words">
                                                        {{ getUserText(msg.content) }}
                                                    </div>
                                                    <div v-if="hasAttachment(msg.content)" class="mt-1 text-right">
                                                        <button @click="msg._showDetail = !msg._showDetail" class="text-[10px] text-[#5a8a8d] hover:text-[#4d7a7d]">
                                                            附加信息 {{ msg._showDetail ? '(收起)' : '(展开)' }}
                                                        </button>
                                                        <div v-if="msg._showDetail" class="mt-1 bg-[#edf5f5]/70 border border-[#c5dfe0]/50 rounded-lg p-2 text-[10px] text-[#5a8a8d] font-mono whitespace-pre-wrap break-all max-h-[150px] overflow-y-auto text-left">
                                                            {{ getAttachmentText(msg.content) }}
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div v-else-if="msg.role === 'assistant'" class="flex flex-col items-start">
                                                <div class="max-w-[85%]">
                                                    <div v-if="hasThinking(msg.content)" class="mb-1">
                                                        <button @click="msg._showThinking = !msg._showThinking" class="text-[10px] bg-[#c8e4e5]/60 text-[#4d7a7d] px-2 py-0.5 rounded-full hover:bg-[#c8e4e5]">
                                                            思考过程 {{ msg._showThinking ? '(收起)' : '(展开)' }}
                                                        </button>
                                                        <div v-if="msg._showThinking" class="mt-1 bg-[#e8f2f2]/70 border border-[#b8d8d9]/50 rounded-lg p-2 text-[10px] text-[#4d7a7d] whitespace-pre-wrap break-words max-h-[200px] overflow-y-auto">
                                                            {{ getThinking(msg.content) }}
                                                        </div>
                                                    </div>
                                                    <div v-if="getAssistantText(msg.content)" class="bg-white border border-[#aecfd1] rounded-2xl rounded-bl-md px-3 py-2 text-sm text-[#2c3e50] whitespace-pre-wrap break-words">
                                                        {{ getAssistantText(msg.content).slice(0, 800) }}{{ getAssistantText(msg.content).length > 800 ? ' ...(已截断)' : '' }}
                                                    </div>
                                                </div>
                                            </div>
                                        </template>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 平铺对话列表 -->
                <div v-if="selectedCalendarDate && !searchQuery" class="mb-3 flex items-center justify-between">
                    <span class="text-sm font-medium text-[#2c3e50]">{{ selectedCalendarDate }} 的对话</span>
                    <button @click="selectedCalendarDate = ''; dateStart = ''; dateEnd = ''" class="text-xs text-[#77b5b4] hover:text-[#4199a0] underline">清除选择</button>
                </div>
                <div v-show="!searchQuery && selectedCalendarDate" class="space-y-3">
                    <div v-if="loading.conversations" class="text-center py-8 text-[#77b5b4]">加载中...</div>
                    <div v-else-if="conversations.length === 0" class="text-center py-8 text-[#77b5b4] bg-white/50 rounded-xl border border-[#aecfd1]/50">
                        暂无对话记录
                    </div>

                    <div v-for="conv in groupedConversations" :key="conv.conversation_id" class="bg-white rounded-xl border border-[#aecfd1] overflow-hidden">
                        <!-- 对话卡片头部 -->
                        <div class="p-4 cursor-pointer hover:bg-[#deebec]/50 transition-colors" @click="toggleConversation(conv)">
                            <div class="flex justify-between items-start">
                                <div class="flex-1 min-w-0 mr-3">
                                    <div class="flex items-center gap-2 mb-1">
                                        <span class="text-[10px] bg-[#4199a0]/20 text-[#4199a0] px-1.5 py-0.5 rounded font-mono">{{ conv.conversation_id.slice(0, 8) }}</span>
                                        <span class="text-[10px] bg-[#aecfd1] text-[#5a7a7d] px-1.5 py-0.5 rounded">{{ conv.message_count }} 条</span>
                                    </div>
                                    <p class="text-sm text-[#2c3e50] truncate">{{ conv.preview || '(空消息)' }}</p>
                                    <div class="flex items-center gap-3 mt-1 text-[10px] text-[#77b5b4]">
                                        <span>模型: {{ conv.model || '未知' }}</span>
                                        <span>{{ formatTime(conv.last_message_at || conv.created_at) }}</span>
                                    </div>
                                </div>
                                <div class="flex items-center gap-1">
                                    <button @click.stop="deleteConversation(conv.conversation_id)" class="text-[#77b5b4] hover:text-red-400 p-1" title="删除">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                    </button>
                                    <svg class="w-4 h-4 text-[#77b5b4] transition-transform" :class="{'rotate-180': expandedConvs.has(conv.conversation_id)}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                </div>
                            </div>
                        </div>

                        <!-- 展开的消息列表 -->
                        <div v-if="expandedConvs.has(conv.conversation_id)" class="border-t border-[#aecfd1] bg-[#f7fafa] max-h-[60vh] overflow-y-auto hide-scrollbar">
                            <div v-if="loadingConvs.has(conv.conversation_id)" class="text-center py-6 text-[#77b5b4] text-sm">加载消息中...</div>
                            <div v-else class="p-3 space-y-2">
                                <template v-for="msg in messagesMap.get(conv.conversation_id)" :key="msg.id">

                                    <!-- 对话摘要 -->
                                    <div v-if="isSummary(msg)" class="flex flex-col items-center">
                                        <button @click="msg._showDetail = !msg._showDetail" class="text-[10px] bg-[#d4eaeb]/60 text-[#5a8a8d] px-3 py-1 rounded-full hover:bg-[#d4eaeb]">
                                            {{ getSummaryType(msg) }} {{ msg._showDetail ? '(收起)' : '(点击展开)' }}
                                        </button>
                                        <div v-if="msg._showDetail" class="mt-2 w-full bg-[#edf5f5]/70 border border-[#c5dfe0]/50 rounded-lg p-3 text-[10px] text-[#5a8a8d] font-mono whitespace-pre-wrap break-all max-h-[200px] overflow-y-auto">
                                            {{ msg.content.slice(0, 2000) }}{{ msg.content.length > 2000 ? ' ...(已截断)' : '' }}
                                        </div>
                                    </div>

                                    <!-- system消息 -->
                                    <div v-else-if="msg.role === 'system'" class="flex flex-col items-center">
                                        <button @click="msg._showDetail = !msg._showDetail" class="text-[10px] bg-[#d4eaeb]/60 text-[#5a8a8d] px-3 py-1 rounded-full hover:bg-[#d4eaeb]">
                                            [系统提示] {{ msg._showDetail ? '收起' : '展开' }}
                                        </button>
                                        <div v-if="msg._showDetail" class="mt-2 w-full bg-[#edf5f5]/70 border border-[#c5dfe0]/50 rounded-lg p-3 text-[10px] text-[#5a8a8d] font-mono whitespace-pre-wrap break-all max-h-[200px] overflow-y-auto">
                                            {{ msg.content?.slice(0, 1000) }}{{ msg.content?.length > 1000 ? '...' : '' }}
                                        </div>
                                    </div>

                                    <!-- 空assistant / 工具调用 -->
                                    <div v-else-if="msg.role === 'assistant' && isEmptyOrToolCall(msg)" class="flex justify-center">
                                        <span class="text-[10px] bg-amber-100/70 text-amber-600 px-2 py-0.5 rounded-full">工具调用</span>
                                    </div>

                                    <!-- user消息 -->
                                    <div v-else-if="msg.role === 'user'" class="flex flex-col items-end">
                                        <div class="max-w-[85%]">
                                            <div v-if="getUserText(msg.content)" class="bg-[#4199a0] text-white rounded-2xl rounded-br-md px-3 py-2 text-sm whitespace-pre-wrap break-words">
                                                {{ getUserText(msg.content) }}
                                            </div>
                                            <div v-if="getUserImages(msg.content).length > 0" class="mt-2 flex flex-wrap gap-2 justify-end">
                                                <img v-for="(imgUrl, idx) in getUserImages(msg.content)" :key="idx" :src="imgUrl" class="max-w-[200px] max-h-[200px] rounded-lg border border-[#c5dfe0]/50 object-contain bg-white/10" />
                                            </div>
                                            <div v-if="hasAttachment(msg.content)" class="mt-1 text-right">
                                                <button @click="msg._showDetail = !msg._showDetail" class="text-[10px] text-[#5a8a8d] hover:text-[#4d7a7d]">
                                                    附加信息 {{ msg._showDetail ? '(收起)' : '(展开)' }}
                                                </button>
                                                <div v-if="msg._showDetail" class="mt-1 bg-[#edf5f5]/70 border border-[#c5dfe0]/50 rounded-lg p-2 text-[10px] text-[#5a8a8d] font-mono whitespace-pre-wrap break-all max-h-[150px] overflow-y-auto text-left">
                                                    {{ getAttachmentText(msg.content) }}
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- assistant消息 -->
                                    <div v-else-if="msg.role === 'assistant'" class="flex flex-col items-start">
                                        <div class="max-w-[85%]">
                                            <div v-if="hasThinking(msg.content)" class="mb-1">
                                                <button @click="msg._showThinking = !msg._showThinking" class="text-[10px] bg-[#c8e4e5]/60 text-[#4d7a7d] px-2 py-0.5 rounded-full hover:bg-[#c8e4e5]">
                                                    思考过程 {{ msg._showThinking ? '(收起)' : '(展开)' }}
                                                </button>
                                                <div v-if="msg._showThinking" class="mt-1 bg-[#e8f2f2]/70 border border-[#b8d8d9]/50 rounded-lg p-2 text-[10px] text-[#4d7a7d] whitespace-pre-wrap break-words max-h-[200px] overflow-y-auto">
                                                    {{ getThinking(msg.content) }}
                                                </div>
                                            </div>
                                            <div v-if="getAssistantText(msg.content)" class="bg-white border border-[#aecfd1] rounded-2xl rounded-bl-md px-3 py-2 text-sm text-[#2c3e50] whitespace-pre-wrap break-words">
                                                {{ getAssistantText(msg.content).slice(0, 800) }}{{ getAssistantText(msg.content).length > 800 ? ' ...(已截断)' : '' }}
                                            </div>
                                        </div>
                                    </div>

                                </template>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 记忆总览 -->
            <section v-show="currentTab === 'memory'">
                <!-- 统计卡片 -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
                    <div class="bg-white rounded-xl border border-[#aecfd1] p-4 text-center">
                        <div class="text-2xl font-bold text-[#4199a0]">{{ summaryStats.total || 0 }}</div>
                        <div class="text-xs text-[#5a7a7d] mt-1">总记忆数</div>
                    </div>
                    <div class="bg-white rounded-xl border border-[#aecfd1] p-4 text-center">
                        <div class="text-2xl font-bold text-[#38a3a5]">{{ summaryStats.tag_stats?.round?.active || 0 }}</div>
                        <div class="text-xs text-[#5a7a7d] mt-1">活跃轮总</div>
                    </div>
                    <div class="bg-white rounded-xl border border-[#aecfd1] p-4 text-center">
                        <div class="text-2xl font-bold text-blue-600">{{ (summaryStats.tag_stats?.daily?.total || 0) + (summaryStats.tag_stats?.weekly?.total || 0) + (summaryStats.tag_stats?.monthly?.total || 0) }}</div>
                        <div class="text-xs text-[#5a7a7d] mt-1">日/周/月总</div>
                    </div>
                    <div class="bg-white rounded-xl border border-[#aecfd1] p-4 text-center">
                        <div class="text-sm font-mono text-[#4199a0] leading-tight">{{ summaryStats.next_cron || 'N/A' }}</div>
                        <div class="text-xs text-[#5a7a7d] mt-1">下次压缩</div>
                    </div>
                </div>

                <!-- 轮总配置 -->
                <div class="bg-white rounded-xl border border-[#aecfd1] p-4 mb-4">
                    <div class="flex items-center justify-between mb-3">
                        <h3 class="text-sm font-semibold text-[#4199a0]">轮总触发配置</h3>
                        <button @click="triggerRoundSummary()" 
                            :disabled="loading.triggerSummary"
                            class="px-3 py-1.5 bg-emerald-600 text-white rounded-lg text-xs font-medium hover:bg-emerald-700 disabled:opacity-50 transition-colors">
                            {{ loading.triggerSummary ? '生成中...' : '手动触发轮总' }}
                        </button>
                    </div>
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
                        <div>
                            <label class="text-xs text-[#5a7a7d] block mb-1">触发条数</label>
                            <div class="flex items-center gap-2">
                                <input type="number" v-model.number="summaryConfig.interval" min="1" max="100"
                                    class="w-20 px-2 py-1.5 border border-[#aecfd1] rounded-lg text-sm focus:outline-none focus:border-[#4199a0]">
                                <button @click="saveSummaryConfig()" 
                                    class="px-2 py-1.5 bg-[#4199a0] text-white rounded-lg text-xs hover:bg-[#357a80] transition-colors">保存</button>
                            </div>
                        </div>
                        <div>
                            <label class="text-xs text-[#5a7a7d] block mb-1">当前计数</label>
                            <div class="text-lg font-bold text-[#4199a0]">{{ summaryConfig.currentCount }} / {{ summaryConfig.interval }}</div>
                        </div>
                        <div>
                            <label class="text-xs text-[#5a7a7d] block mb-1">状态</label>
                            <div class="text-sm text-[#5a7a7d]">{{ summaryConfig.currentCount >= summaryConfig.interval ? '即将触发' : '累计中' }}</div>
                        </div>
                    </div>
                </div>

                <!-- 筛选 -->
                <div class="flex gap-2 mb-4 flex-wrap">
                    <button v-for="t in ['all','round','round_rollup','daily','weekly','monthly']" :key="t"
                        @click="summaryFilter = t; fetchSummaries()"
                        :class="summaryFilter === t ? 'bg-[#4199a0] text-white' : 'bg-white text-[#5a7a7d] border border-[#aecfd1]'"
                        class="px-3 py-1.5 rounded-lg text-xs font-medium transition-colors">
                        {{ {all:'全部',round:'轮总',round_rollup:'轮总总',daily:'日总',weekly:'周总',monthly:'月总'}[t] }}
                    </button>
                    <button @click="summaryActiveOnly = !summaryActiveOnly; fetchSummaries()"
                        :class="summaryActiveOnly ? 'bg-emerald-600 text-white' : 'bg-white text-[#5a7a7d] border border-[#aecfd1]'"
                        class="px-3 py-1.5 rounded-lg text-xs font-medium transition-colors ml-auto">
                        {{ summaryActiveOnly ? '仅活跃' : '全部状态' }}
                    </button>
                </div>

                <!-- 时间轴列表 -->
                <div v-if="loading.summaries" class="text-center py-8 text-[#5a7a7d]">加载中...</div>
                <div v-else-if="summaries.length === 0" class="text-center py-8 text-[#5a7a7d]">暂无记忆数据</div>
                <div v-else class="space-y-3">
                    <div v-for="s in summaries" :key="s.id" class="bg-white rounded-xl border border-[#aecfd1] overflow-hidden">
                        <div class="flex items-center gap-2 px-4 py-3 cursor-pointer" @click="s._expanded = !s._expanded">
                            <span :class="{
                                'bg-emerald-100 text-emerald-700': s.tag === 'round',
                                'bg-teal-100 text-teal-700': s.tag === 'round_rollup',
                                'bg-blue-100 text-blue-700': s.tag === 'daily',
                                'bg-purple-100 text-purple-700': s.tag === 'weekly',
                                'bg-amber-100 text-amber-700': s.tag === 'monthly'
                            }" class="px-2 py-0.5 rounded-full text-xs font-medium">
                                {{ {round:'轮总',round_rollup:'轮总总',daily:'日总',weekly:'周总',monthly:'月总'}[s.tag] || s.tag }}
                            </span>
                            <span v-if="s.category" :class="{
                                'bg-rose-50 text-rose-600': s.category === '技术',
                                'bg-sky-50 text-sky-600': s.category === '学习',
                                'bg-orange-50 text-orange-600': s.category === '日常'
                            }" class="px-1.5 py-0.5 rounded text-[10px] font-medium border" :style="{
                                borderColor: s.category === '技术' ? '#fda4af' : s.category === '学习' ? '#7dd3fc' : '#fdba74'
                            }">{{ s.category }}</span>
                            <span v-if="s.is_active" class="w-2 h-2 rounded-full bg-emerald-500" title="活跃"></span>
                            <span v-else class="w-2 h-2 rounded-full bg-gray-300" title="归档"></span>
                            <span class="text-xs text-[#5a7a7d] ml-auto">{{ formatTime(s.created_at) }}</span>
                            <span class="text-xs text-gray-400">ID:{{ s.id }}</span>
                            <svg :class="{'rotate-180': s._expanded}" class="w-4 h-4 text-[#5a7a7d] transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                        </div>
                        <div v-show="s._expanded" class="px-4 pb-3 border-t border-[#aecfd1]">
                            <pre class="text-xs text-[#333] whitespace-pre-wrap leading-relaxed mt-2 max-h-80 overflow-auto">{{ s.content }}</pre>
                            <div v-if="s.valence !== null || s.arousal !== null || s.anchor" class="flex flex-wrap gap-2 mt-2 text-xs">
                                <span v-if="s.valence !== null" class="px-2 py-0.5 rounded-full" :class="s.valence >= 0 ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700'">情绪效价: {{ s.valence }}</span>
                                <span v-if="s.arousal !== null" class="px-2 py-0.5 rounded-full bg-yellow-50 text-yellow-700">情绪强度: {{ s.arousal }}</span>
                                <span v-if="s.anchor" class="px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700">🔗 {{ s.anchor }}</span>
                            </div>
                            <div class="flex items-center justify-between mt-3 pt-2 border-t border-gray-100">
                                <span class="text-xs text-gray-400">conv: {{ s.conversation_id ? s.conversation_id.slice(0,8) + '...' : 'global' }}</span>
                                <button @click.stop="deleteSummary(s.id)" class="text-xs text-red-500 hover:text-red-700 transition-colors">删除</button>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 状态便签 -->
            <section v-show="currentTab === 'status'">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-lg font-semibold text-[#2c3e50]">状态便签</h2>
                    <button @click="openAddStatusModal" class="bg-[#4199a0] hover:bg-[#77b5b4] text-white px-3 py-1.5 rounded-lg text-sm font-medium transition-colors">
                        + 添加状态
                    </button>
                </div>

                <!-- 一起听 组件 -->
                <div class="mb-6 rounded-2xl p-6 relative overflow-hidden" style="background: rgba(255, 255, 255, 0.4); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.3); box-shadow: 0 8px 32px rgba(31, 38, 135, 0.05);">
                    <div class="absolute inset-0 bg-gradient-to-br from-white/40 to-transparent pointer-events-none"></div>
                    <div class="relative z-10 flex flex-col items-center">
                        <!-- 头像区 -->
                        <div class="flex items-center justify-center mb-4 relative">
                            <div class="relative group cursor-pointer z-10 translate-x-3" @click="triggerAvatarUpload('avatar1')">
                                <img :src="customAvatars.avatar1 || 'https://p1.music.126.net/6y-UleORITEDbvrOLV0Q8A==/5639395138885805.jpg'" class="w-16 h-16 rounded-full border-[3px] border-[#deebec] shadow-md object-cover">
                                <div class="absolute inset-0 bg-black/30 rounded-full opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity text-white text-[10px]">更换</div>
                            </div>
                            <div class="w-8 h-8 relative z-20">
                                <svg viewBox="0 0 100 50" class="w-full h-full stroke-[#4199a0] stroke-[4px] fill-none stroke-linecap-round stroke-linejoin-round opacity-80">
                                    <path d="M0,25 Q50,-5 100,25" />
                                </svg>
                            </div>
                            <div class="relative group cursor-pointer z-10 -translate-x-3" @click="triggerAvatarUpload('avatar2')">
                                <img :src="customAvatars.avatar2 || 'https://p1.music.126.net/6y-UleORITEDbvrOLV0Q8A==/5639395138885805.jpg'" class="w-16 h-16 rounded-full border-[3px] border-[#deebec] shadow-md object-cover">
                                <div class="absolute inset-0 bg-black/30 rounded-full opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity text-white text-[10px]">更换</div>
                            </div>
                        </div>

                        <!-- 文案区 -->
                        <div class="text-sm font-medium text-[#2c3e50] mb-6">
                            TA就在你身边，一起听了 <span class="text-[#4199a0] font-bold text-lg mx-1">{{ formatListenTime(listenTogetherData.total_seconds) }}</span> 
                        </div>

                        <!-- 唱片机区 -->
                        <div class="relative w-48 h-48 mb-6">
                            <!-- 唱盘底座 -->
                            <div class="absolute inset-2 rounded-full shadow-xl overflow-hidden flex items-center justify-center" :class="listenTogetherData.status === '播放中' ? 'animate-spin-slow' : ''" style="border: 4px solid #c0dade; background: radial-gradient(circle, #4199a0 0%, #77b5b4 100%);">
                                <!-- 纹理 -->
                                <div class="absolute inset-0 opacity-30" style="background: repeating-conic-gradient(from 0deg, transparent 0deg 10deg, #aecfd1 10deg 20deg);"></div>
                                <div class="absolute inset-0 rounded-full shadow-[inset_0_0_20px_rgba(0,0,0,0.2)]"></div>
                                <!-- 专辑封面(中间) -->
                                <div class="w-16 h-16 rounded-full border-2 border-[#aecfd1] z-10 overflow-hidden bg-white">
                                    <svg v-if="!listenTogetherData.name" class="w-full h-full text-[#aecfd1] p-2" fill="currentColor" viewBox="0 0 24 24"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg>
                                    <img v-else :src="listenTogetherData.albumPic || customAvatars.avatar1 || 'https://p1.music.126.net/6y-UleORITEDbvrOLV0Q8A==/5639395138885805.jpg'" class="w-full h-full object-cover">
                                </div>
                                <!-- 中心孔 -->
                                <div class="absolute w-2 h-2 bg-[#deebec] rounded-full z-20"></div>
                            </div>
                            <!-- 唱臂 -->
                            <div class="absolute top-0 right-0 w-24 h-32 origin-top-right transition-transform duration-700 ease-in-out pointer-events-none" :style="{ transform: listenTogetherData.status === '播放中' ? 'rotate(18deg)' : 'rotate(0deg)' }">
                                <div class="absolute top-4 right-4 w-4 h-4 bg-gray-400 rounded-full shadow-md z-30"></div>
                                <div class="absolute top-6 right-6 w-1 h-20 bg-gradient-to-b from-gray-300 to-gray-400 rounded-full origin-top transform -rotate-12 z-20 shadow-sm"></div>
                                <div class="absolute top-[90px] right-[10px] w-4 h-6 bg-gray-700 rounded-sm transform rotate-45 z-20 shadow-md"></div>
                            </div>
                        </div>

                        <!-- 歌曲信息区 -->
                        <div class="w-full max-w-sm bg-white/60 backdrop-blur-md rounded-xl p-4 shadow-sm border border-white/60">
                            <div class="flex justify-between items-center mb-2">
                                <div class="truncate flex-1 text-center">
                                    <div class="font-bold text-[#2c3e50] text-base truncate">{{ listenTogetherData.name || '暂无歌曲播放' }}</div>
                                    <div class="text-xs text-[#5a7a7d] truncate mt-1">{{ listenTogetherData.artists || '-' }} · {{ listenTogetherData.album || '-' }}</div>
                                </div>
                            </div>
                            <!-- 进度条 -->
                            <div class="w-full bg-[#aecfd1]/50 rounded-full h-2 mt-3 relative overflow-hidden cursor-pointer" @click="seekMusic">
                                <div class="bg-gradient-to-r from-[#4199a0] to-[#77b5b4] h-2 rounded-full" :style="{ width: getProgressPercent() + '%' }"></div>
                            </div>
                            <!-- 控制按钮 -->
                            <div class="flex justify-center items-center gap-8 mt-4 mb-2">
                                <button @click="controlMusic('prev')" class="w-10 h-10 flex items-center justify-center rounded-full bg-[#deebec]/70 text-[#4199a0] shadow-sm hover:shadow hover:bg-[#c0dade] transition-all transform hover:scale-105 active:scale-90" :disabled="loading.musicControl">
                                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg>
                                </button>
                                <button @click="controlMusic(listenTogetherData.status === '播放中' ? 'pause' : 'play')" class="w-12 h-12 flex items-center justify-center rounded-full bg-gradient-to-r from-[#4199a0] to-[#77b5b4] text-white shadow-md hover:shadow-lg transition-all transform hover:scale-105 active:scale-95" :disabled="loading.musicControl">
                                    <svg v-if="listenTogetherData.status === '播放中'" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
                                    <svg v-else class="w-6 h-6 translate-x-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                                </button>
                                <button @click="controlMusic('next')" class="w-10 h-10 flex items-center justify-center rounded-full bg-[#deebec]/70 text-[#4199a0] shadow-sm hover:shadow hover:bg-[#c0dade] transition-all transform hover:scale-105 active:scale-90" :disabled="loading.musicControl">
                                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div v-if="loading.status" class="text-center py-8 text-[#5a7a7d]">加载中...</div>
                <div v-else-if="statusList.length === 0" class="text-center py-8 text-[#5a7a7d]">暂无状态数据</div>
                <div v-else class="space-y-3">
                    <div v-for="st in statusList" :key="st.id" class="bg-white rounded-xl border border-[#aecfd1] p-4 flex items-center justify-between">
                        <div>
                            <div class="flex items-center gap-2 mb-1">
                                <h3 class="font-medium text-[#2c3e50]">{{ st.content }}</h3>
                                <span class="text-[10px] bg-slate-100 text-slate-500 px-1.5 py-0.5 rounded border">阈值: {{ st.threshold_hours || 24 }}h</span>
                                <span v-if="st._state === '正常'" class="text-[10px] bg-emerald-100 text-emerald-700 px-1.5 py-0.5 rounded">正常</span>
                                <span v-else-if="st._state === '即将超时'" class="text-[10px] bg-amber-100 text-amber-700 px-1.5 py-0.5 rounded">即将超时</span>
                                <span v-else-if="st._state === '超时'" class="text-[10px] bg-red-100 text-red-700 px-1.5 py-0.5 rounded">超时</span>
                                <span v-else class="text-[10px] bg-gray-100 text-gray-500 px-1.5 py-0.5 rounded">未记录</span>
                            </div>
                            <div class="text-xs text-[#5a7a7d]">
                                上次完成: {{ st.updated_at ? formatTime(st.updated_at) : '暂无记录' }} 
                                <span v-if="st._diff_str">({{ st._diff_str }})</span>
                            </div>
                        </div>
                        <div class="flex gap-2">
                            <button @click="editStatus(st)" class="text-[#5a7a7d] hover:text-[#4199a0] p-1">编辑</button>
                            <button @click="deleteStatus(st.id)" class="text-red-400 hover:text-red-500 p-1">删除</button>
                        </div>
                    </div>
                </div>
            </section>
            
            <!-- 记忆库 -->
            <section v-show="currentTab === 'recall'">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-lg font-semibold text-[#2c3e50]">记忆库浏览与管理</h2>
                </div>

                <!-- 统计卡片 -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
                    <div class="bg-white rounded-xl border border-[#aecfd1] p-4 text-center shadow-sm">
                        <div class="text-xs text-[#5a7a7d] mb-1">总计记忆</div>
                        <div class="text-2xl font-bold text-[#2c3e50]">{{ memoryStats.total || 0 }}</div>
                    </div>
                    <div class="bg-white rounded-xl border border-[#aecfd1] p-4 text-center shadow-sm">
                        <div class="text-xs text-[#5a7a7d] mb-1">对话对 (dialogue)</div>
                        <div class="text-2xl font-bold text-[#4199a0]">{{ memoryStats.categories?.dialogue || 0 }}</div>
                    </div>
                    <div class="bg-white rounded-xl border border-[#aecfd1] p-4 text-center shadow-sm">
                        <div class="text-xs text-[#5a7a7d] mb-1">向量覆盖</div>
                        <div class="text-2xl font-bold text-[#2c3e50]">{{ memoryStats.has_emb || 0 }} <span class="text-sm font-normal text-[#5a7a7d]">/ {{ memoryStats.total || 0 }}</span></div>
                    </div>
                    <div class="bg-white rounded-xl border border-[#aecfd1] p-4 text-center shadow-sm">
                        <div class="text-xs text-[#5a7a7d] mb-1">最后更新时间</div>
                        <div class="text-sm font-medium text-[#2c3e50] mt-2">{{ formatTime(memoryStats.latest_time) || '无' }}</div>
                    </div>
                </div>

                <!-- 工具栏 -->
                <div class="bg-white rounded-xl border border-[#aecfd1] p-4 mb-4 flex flex-wrap gap-4 items-center shadow-sm">
                    <div class="flex items-center space-x-2">
                        <label class="text-sm text-[#5a7a7d]">分类:</label>
                        <select v-model="memoryFilter.category" @change="fetchMemories(1)" class="border border-[#aecfd1] rounded px-2 py-1 text-sm text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                            <option value="">全部</option>
                            <option value="dialogue">dialogue</option>
                            <option value="operit">operit</option>
                            <option value="status">status</option>
                        </select>
                    </div>
                    <div class="flex items-center space-x-2">
                        <label class="text-sm text-[#5a7a7d]">向量:</label>
                        <select v-model="memoryFilter.has_embedding" @change="fetchMemories(1)" class="border border-[#aecfd1] rounded px-2 py-1 text-sm text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                            <option value="">全部</option>
                            <option value="true">✅ 已生成</option>
                            <option value="false">❌ 未生成(无向量)</option>
                        </select>
                    </div>
                    <div class="flex items-center space-x-2">
                        <label class="text-sm text-[#5a7a7d]">排序:</label>
                        <select v-model="memoryFilter.order" @change="fetchMemories(1)" class="border border-[#aecfd1] rounded px-2 py-1 text-sm text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                            <option value="time_desc">最新</option>
                            <option value="time_asc">最旧</option>
                        </select>
                    </div>
                    <div class="flex-1 flex items-center space-x-2 min-w-[200px]">
                        <input v-model="memoryFilter.search" @keyup.enter="fetchMemories(1)" type="text" placeholder="搜索关键词..." class="w-full border border-[#aecfd1] rounded px-3 py-1 text-sm text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                        <button @click="fetchMemories(1)" class="bg-[#4199a0] text-white px-3 py-1 rounded text-sm hover:bg-[#77b5b4] transition-colors">搜索</button>
                    </div>
                </div>

                <!-- 列表展示 -->
                <div class="bg-white rounded-xl border border-[#aecfd1] overflow-hidden mb-4 shadow-sm">
                    <div v-if="loading.memories" class="text-center py-8 text-[#5a7a7d]">加载中...</div>
                    <div v-else-if="memories.length === 0" class="text-center py-8 text-[#5a7a7d]">无相关记忆记录</div>
                    <div v-else class="overflow-x-auto">
                        <table class="w-full text-left border-collapse whitespace-nowrap">
                            <thead>
                                <tr class="bg-[#f4f9f9] border-b border-[#aecfd1] text-xs text-[#5a7a7d]">
                                    <th class="p-3 font-medium">ID</th>
                                    <th class="p-3 font-medium">分类</th>
                                    <th class="p-3 font-medium w-full max-w-sm">内容预览</th>
                                    <th class="p-3 font-medium text-center">状态</th>
                                    <th class="p-3 font-medium text-right">时间</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr v-for="mem in memories" :key="mem.id" @click="viewMemoryDetail(mem)" class="border-b border-[#aecfd1]/30 hover:bg-[#f4f9f9] cursor-pointer transition-colors text-sm text-[#2c3e50]">
                                    <td class="p-3 font-mono text-xs">#{{ mem.id }}</td>
                                    <td class="p-3"><span class="px-2 py-0.5 bg-[#deebec] text-[#4199a0] rounded-full text-xs">{{ mem.category || 'unknown' }}</span></td>
                                    <td class="p-3 truncate max-w-xs sm:max-w-md md:max-w-lg" :title="mem.content_preview">{{ mem.content_preview }}</td>
                                    <td class="p-3 text-center">
                                        <span v-if="mem.has_emb" title="已向量化">✅</span>
                                        <span v-else title="未向量化">❌</span>
                                    </td>
                                    <td class="p-3 text-right text-xs text-[#5a7a7d]">{{ formatTime(mem.created_at) }}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- 分页 -->
                <div v-if="memoryPagination.total > 0" class="flex justify-between items-center bg-white rounded-xl border border-[#aecfd1] p-3 shadow-sm">
                    <div class="text-sm text-[#5a7a7d]">
                        共 {{ memoryPagination.total }} 条，当前第 {{ memoryPagination.page }} / {{ Math.ceil(memoryPagination.total / memoryPagination.size) }} 页
                    </div>
                    <div class="flex space-x-2">
                        <button @click="fetchMemories(memoryPagination.page - 1)" :disabled="memoryPagination.page <= 1" class="px-3 py-1 border border-[#aecfd1] rounded text-sm text-[#2c3e50] hover:bg-[#f4f9f9] disabled:opacity-50 transition-colors">上一页</button>
                        <button @click="fetchMemories(memoryPagination.page + 1)" :disabled="memoryPagination.page >= Math.ceil(memoryPagination.total / memoryPagination.size)" class="px-3 py-1 border border-[#aecfd1] rounded text-sm text-[#2c3e50] hover:bg-[#f4f9f9] disabled:opacity-50 transition-colors">下一页</button>
                    </div>
                </div>

                <!-- 原有召回测试 (收纳) -->
                <div class="mt-8 border-t border-[#aecfd1] pt-6">
                    <div class="flex items-center justify-between mb-4 cursor-pointer" @click="showRecallTest = !showRecallTest">
                        <h3 class="text-md font-semibold text-[#2c3e50] flex items-center">
                            <svg :class="{'rotate-90': showRecallTest}" class="w-4 h-4 mr-2 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                            语义召回测试工具
                        </h3>
                    </div>
                    <div v-show="showRecallTest" class="bg-[#f4f9f9] rounded-xl border border-[#aecfd1] p-4">
                        <label class="block text-sm font-medium text-[#5a7a7d] mb-2">输入测试文本：</label>
                        <textarea v-model="recallInputText" rows="2" class="w-full border border-[#aecfd1] rounded-lg p-3 text-[#2c3e50] focus:outline-none focus:ring-1 focus:ring-[#4199a0] focus:border-[#4199a0] bg-white transition-shadow" placeholder="例如：肚子疼..."></textarea>
                        
                        <button @click="testRecall" :disabled="loading.recall" class="mt-4 bg-[#4199a0] hover:bg-[#77b5b4] text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors disabled:opacity-50 flex items-center">
                            <span v-if="loading.recall" class="mr-2">
                                <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                            </span>
                            测试召回
                        </button>

                        <div class="mt-4" v-if="recallResults.length > 0 || hasSearchedRecall">
                            <h4 class="text-sm font-semibold text-[#2c3e50] mb-2">召回结果 (Top 5, 相似度 > 0.5)</h4>
                            <div v-if="recallResults.length > 0" class="space-y-2">
                                <div v-for="(item, index) in recallResults" :key="index" class="bg-white rounded border border-[#aecfd1] p-3 text-sm text-[#2c3e50]">
                                    <span class="font-bold text-[#4199a0] mr-2">[{{ item.sim }}]</span> {{ item.content }}
                                </div>
                            </div>
                            <div v-else class="text-[#5a7a7d] text-sm py-2">未找到相关记忆。</div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 碎片记忆 -->
            <section v-show="currentTab === 'fragments'">
                <div class="flex flex-col gap-4">
                    <!-- 顶部标题与快捷入口 -->
                    <div class="flex flex-wrap justify-between items-center gap-2">
                        <div class="flex items-center gap-3">
                            <h2 class="text-lg font-semibold text-[#2c3e50]">碎片记忆库</h2>
                            <span class="text-xs text-[#5a7a7d] bg-[#deebec] px-2 py-0.5 rounded-full font-mono">共 {{ fragmentsTotal }} 条</span>
                        </div>
                        <div class="flex items-center gap-2">

                            <button @click="fetchFragments(); fetchFragmentsStats()" 
                                    class="bg-white hover:bg-[#f4f9f9] text-[#4199a0] border border-[#aecfd1] px-3 py-1.5 rounded-lg text-xs font-medium transition-colors flex items-center gap-1">
                                <span>🔄 刷新</span>
                            </button>
                        </div>
                    </div>

                    <!-- 状态筛选胶囊栏 (带统计计数) -->
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                        <button @click="setFragmentStatusFilter('')" 
                                :class="fragmentsStatusFilter === '' ? 'bg-[#4199a0] text-white shadow-sm font-semibold' : 'bg-white text-[#5a7a7d] border border-[#aecfd1] hover:bg-[#f4f9f9]'"
                                class="flex items-center justify-between px-3 py-2 rounded-xl text-xs transition-colors">
                            <span>全部碎片</span>
                            <span :class="fragmentsStatusFilter === '' ? 'bg-white/20 text-white' : 'bg-gray-100 text-[#5a7a7d]'" class="px-1.5 py-0.5 rounded-full text-[11px] font-mono">{{ fragmentsStats.total }}</span>
                        </button>
                        <button @click="setFragmentStatusFilter('active')" 
                                :class="fragmentsStatusFilter === 'active' ? 'bg-emerald-600 text-white shadow-sm font-semibold' : 'bg-white text-emerald-700 border border-emerald-200 hover:bg-emerald-50'"
                                class="flex items-center justify-between px-3 py-2 rounded-xl text-xs transition-colors">
                            <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-emerald-400 inline-block"></span>活跃 (Active)</span>
                            <span :class="fragmentsStatusFilter === 'active' ? 'bg-white/20 text-white' : 'bg-emerald-100 text-emerald-800'" class="px-1.5 py-0.5 rounded-full text-[11px] font-mono">{{ fragmentsStats.active }}</span>
                        </button>
                        <button @click="setFragmentStatusFilter('inactive')" 
                                :class="fragmentsStatusFilter === 'inactive' ? 'bg-slate-600 text-white shadow-sm font-semibold' : 'bg-white text-slate-600 border border-slate-200 hover:bg-slate-50'"
                                class="flex items-center justify-between px-3 py-2 rounded-xl text-xs transition-colors">
                            <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-slate-400 inline-block"></span>不活跃 (Inactive)</span>
                            <span :class="fragmentsStatusFilter === 'inactive' ? 'bg-white/20 text-white' : 'bg-slate-100 text-slate-700'" class="px-1.5 py-0.5 rounded-full text-[11px] font-mono">{{ fragmentsStats.inactive }}</span>
                        </button>
                    </div>

                    <!-- 搜索与控制栏 -->
                    <div class="flex flex-wrap items-center gap-2">
                        <!-- 搜索框 -->
                        <div class="relative flex-1 min-w-[200px]">
                            <input type="text" v-model="fragmentsSearchQuery" @input="onFragmentSearchInput" @keyup.enter="fetchFragments(1)" placeholder="🔍 服务端搜索记忆内容..." 
                                   class="w-full pl-9 pr-8 py-2 border border-[#aecfd1] rounded-lg shadow-sm text-sm focus:outline-none focus:ring-2 focus:ring-[#4199a0] focus:border-transparent">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <span class="text-gray-400 text-xs">🔍</span>
                            </div>
                            <button v-if="fragmentsSearchQuery" @click="fragmentsSearchQuery = ''; fetchFragments(1)" 
                                    class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-gray-400 hover:text-gray-600">
                                <span>&times;</span>
                            </button>
                        </div>

                        <!-- 排序方式 -->
                        <select v-model="fragmentsSort" @change="fetchFragments(1)" 
                                class="bg-white border border-[#aecfd1] rounded-lg px-2.5 py-2 text-xs text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                            <option value="created_desc">创建时间 (最新优先)</option>
                            <option value="created_asc">创建时间 (最早优先)</option>
                            <option value="updated_desc">更新时间 (最新变动)</option>
                        </select>

                        <!-- 单页大小 -->
                        <select v-model="fragmentsPageSize" @change="fetchFragments(1)" 
                                class="bg-white border border-[#aecfd1] rounded-lg px-2.5 py-2 text-xs text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                            <option :value="25">25 条/页</option>
                            <option :value="50">50 条/页</option>
                            <option :value="100">100 条/页</option>
                        </select>
                    </div>

                    <!-- 固定四类标签筛选栏 -->
                    <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs">
                        <span class="text-[#5a7a7d] shrink-0 mr-1 font-medium">标签分类:</span>
                        <button @click="setFragmentTagFilter('')" 
                                :class="fragmentsSelectedTag === '' ? 'bg-[#4199a0] text-white border-[#4199a0]' : 'bg-white text-[#5a7a7d] border-[#aecfd1] hover:bg-[#f4f9f9]'"
                                class="shrink-0 px-2.5 py-1 border rounded-full transition-colors font-medium">
                            全部
                        </button>
                        <button v-for="tag in fragmentPresetTags" :key="tag" @click="setFragmentTagFilter(tag)"
                                :class="fragmentsSelectedTag === tag ? 'bg-[#4199a0] text-white border-[#4199a0]' : 'bg-white text-[#5a7a7d] border-[#aecfd1] hover:bg-[#f4f9f9]'"
                                class="shrink-0 px-2.5 py-1 border rounded-full transition-colors">
                            {{ tag }}
                        </button>
                    </div>

                    <!-- 批量操作悬浮条 (P2 - 选中>=1条时显示) -->
                    <div v-if="selectedFragmentIds.length > 0" 
                         class="bg-[#2c3e50] text-white px-4 py-2.5 rounded-xl shadow-lg flex flex-wrap items-center justify-between gap-3 animate-fade-in border border-slate-700">
                        <div class="flex items-center gap-2 text-xs">
                            <span class="bg-[#4199a0] px-2 py-0.5 rounded-full font-mono font-bold">{{ selectedFragmentIds.length }}</span>
                            <span>条碎片已选中</span>
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                            <button @click="batchCorrect('restore')" 
                                    class="bg-emerald-600 hover:bg-emerald-500 text-white px-3 py-1 rounded-lg text-xs font-medium transition-colors flex items-center gap-1">
                                <span>🟢 批量恢复活跃</span>
                            </button>
                            <button @click="batchCorrect('deactivate')" 
                                    class="bg-amber-600 hover:bg-amber-500 text-white px-3 py-1 rounded-lg text-xs font-medium transition-colors flex items-center gap-1">
                                <span>🟡 批量停用</span>
                            </button>
                            <button @click="selectedFragmentIds = []" 
                                    class="bg-transparent hover:bg-white/10 text-gray-300 px-2 py-1 rounded-lg text-xs transition-colors">
                                取消选择
                            </button>
                        </div>
                    </div>

                    <!-- 列表主体 -->
                    <div class="bg-white rounded-xl border border-[#aecfd1] shadow-sm flex flex-col divide-y divide-[#aecfd1] overflow-hidden">
                        <!-- 列表表头 / 全选条 -->
                        <div class="p-3 bg-[#f4f9f9] flex items-center justify-between text-xs text-[#5a7a7d]">
                            <label class="flex items-center gap-2 cursor-pointer select-none">
                                <input type="checkbox" :checked="isAllCurrentPageSelected" @change="toggleSelectAllFragments" class="rounded text-[#4199a0] focus:ring-[#4199a0] accent-[#4199a0]">
                                <span class="font-medium">全选当前页 ({{ fragments.length }} 条)</span>
                            </label>
                            <span class="text-[11px] text-[#77b5b4]">点击卡片可展开详情与快捷纠错</span>
                        </div>

                        <div v-if="fragmentsLoading" class="text-center py-12 text-[#5a7a7d] flex flex-col items-center justify-center gap-2">
                            <svg class="animate-spin h-6 w-6 text-[#4199a0]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                            <span>加载碎片数据中...</span>
                        </div>
                        <div v-else-if="fragments.length === 0" class="text-center py-12 text-[#5a7a7d]">
                            <div class="text-2xl mb-1">📭</div>
                            <div>未找到符合条件的记忆碎片</div>
                        </div>
                        
                        <div v-else v-for="frag in fragments" :key="frag.id" 
                             class="flex flex-col p-3 transition-colors hover:bg-[#f4f9f9] cursor-pointer"
                             :class="{'bg-[#f4f9f9]': expandedFragmentId === frag.id, 'bg-amber-50/30': selectedFragmentIds.includes(frag.id)}"
                             @click="expandedFragmentId = frag.id === expandedFragmentId ? null : frag.id">
                            
                            <!-- 收起视图（双行紧凑显示） -->
                            <div class="flex items-start gap-2.5 w-full">
                                <!-- 复选框 (P2 - 阻止冒泡) -->
                                <div class="pt-0.5" @click.stop>
                                    <input type="checkbox" :checked="selectedFragmentIds.includes(frag.id)" @change="toggleSelectFragment(frag.id)" class="rounded text-[#4199a0] focus:ring-[#4199a0] accent-[#4199a0] cursor-pointer">
                                </div>

                                <div class="flex flex-col gap-1.5 flex-1 min-w-0">
                                    <!-- 第一行：内容摘要 -->
                                    <div class="text-[#2c3e50] text-sm leading-snug line-clamp-2 w-full pr-1 font-normal">
                                        {{ frag.content }}
                                    </div>
                                    
                                    <!-- 第二行：状态徽章/ID/标签/开关 -->
                                    <div class="flex items-center justify-between mt-0.5">
                                        <div class="flex items-center gap-2 overflow-hidden flex-1 flex-wrap">
                                            <!-- 状态徽章 -->
                                            <span v-if="frag.status === 'active' && frag.is_active" class="px-1.5 py-0.2 rounded text-[10px] bg-emerald-100 text-emerald-800 font-medium">● 活跃</span>
                                            <span v-else-if="frag.status === 'disputed'" class="px-1.5 py-0.2 rounded text-[10px] bg-amber-100 text-amber-800 font-medium">● 质疑</span>
                                            <span v-else class="px-1.5 py-0.2 rounded text-[10px] bg-slate-100 text-slate-600 font-medium">○ 过期</span>

                                            <!-- ID -->
                                            <span class="flex-shrink-0 text-xs text-blue-500 font-mono">#{{ frag.id }}</span>
                                            
                                            <!-- 前两个标签 -->
                                            <div v-if="frag.tags" class="flex gap-1 overflow-hidden">
                                                <span v-for="(tag, i) in frag.tags.split(',').map(t=>t.trim()).slice(0,2)" :key="i" 
                                                      class="flex-shrink-0 bg-gray-100 px-1.5 py-0.5 rounded text-[10px] text-gray-600 truncate max-w-[80px]">
                                                    {{ tag }}
                                                </span>
                                                <span v-if="frag.tags.split(',').length > 2" class="text-[10px] text-gray-400">...</span>
                                            </div>

                                            <span v-if="frag.activation_count > 0" class="text-[10px] text-[#77b5b4]">命中 {{ frag.activation_count }} 次</span>
                                        </div>
                                        
                                        <!-- 迷你开关 (阻止冒泡，避免触发外层的折叠) -->
                                        <div class="flex-shrink-0 ml-2" @click.stop>
                                            <button @click="toggleFragment(frag.id)" 
                                                    class="relative inline-flex items-center h-5 rounded-full w-9 transition-colors duration-200 focus:outline-none"
                                                    :class="frag.is_active ? 'bg-[#4199a0]' : 'bg-gray-300'"
                                                    :title="frag.is_active ? '点击禁用' : '点击启用'">
                                                <span class="inline-block w-3 h-3 transform bg-white rounded-full transition-transform duration-200 ease-in-out"
                                                      :class="frag.is_active ? 'translate-x-5' : 'translate-x-1'"></span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- 展开视图（详情面板与操作按钮） -->
                            <div v-if="expandedFragmentId === frag.id" class="mt-3 pt-3 border-t border-gray-100 text-xs flex flex-col gap-2.5 bg-[#f9fbfb] -mx-3 -mb-3 p-3 rounded-b">
                                <div class="text-[#2c3e50] text-sm leading-relaxed break-words whitespace-pre-wrap bg-white p-3 rounded-lg border border-[#aecfd1]/50 font-mono">{{ frag.content }}</div>
                                
                                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-gray-500">
                                    <div><strong>状态：</strong><span class="font-bold uppercase">{{ frag.is_active ? '活跃 (Active)' : '不活跃 (Inactive)' }}</span></div>
                                    <div><strong>向量化：</strong>{{ frag.has_embedding ? '✅ 已生成' : '❌ 未生成' }}</div>
                                    <div><strong>创建时间：</strong>{{ frag.created_at || '-' }}</div>
                                    <div><strong>更新时间：</strong>{{ frag.updated_at || '-' }}</div>
                                    <div class="col-span-2">
                                        <strong>完整标签：</strong>
                                        <span v-if="frag.tags" class="inline-flex flex-wrap gap-1 mt-1">
                                            <span v-for="tag in frag.tags.split(',')" class="bg-white border border-gray-200 px-1.5 py-0.5 rounded text-gray-600">{{ tag.trim() }}</span>
                                        </span>
                                        <span v-else>无</span>
                                    </div>
                                    <div class="col-span-2">
                                        <strong>溯源原文：</strong>
                                        <span v-if="frag.source_dialogue_id" class="text-blue-500 cursor-pointer hover:underline" @click.stop="showAlert(frag.source_text ? frag.source_text : '关联原文对话行ID: ' + frag.source_dialogue_id)">#{{ frag.source_dialogue_id }} {{ frag.source_text ? '(' + frag.source_text.slice(0, 30) + '...)' : '' }}</span>
                                        <span v-else>-</span>
                                    </div>
                                </div>

                                <!-- 单条操作动作栏 (P1 纠错动作) -->
                                <div class="flex flex-wrap items-center justify-end gap-2 pt-2 border-t border-gray-200/60" @click.stop>
                                    <button @click="openRewriteModal(frag)" 
                                            class="bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 px-3 py-1.5 rounded-lg text-xs font-medium transition-colors flex items-center gap-1">
                                        <span>✏️ 改写并重算向量</span>
                                    </button>
                                    <button v-if="frag.is_active" @click="correctFragment(frag.id, 'deactivate')" 
                                            class="bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-300 px-3 py-1.5 rounded-lg text-xs font-medium transition-colors flex items-center gap-1">
                                        <span>🟡 停用 (Deactivate)</span>
                                    </button>
                                    <button v-if="!frag.is_active" @click="correctFragment(frag.id, 'restore')" 
                                            class="bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-300 px-3 py-1.5 rounded-lg text-xs font-medium transition-colors flex items-center gap-1">
                                        <span>🟢 恢复活跃 (Restore)</span>
                                    </button>
                                </div>
                            </div>
                            
                        </div>
                    </div>

                    <!-- 翻页控制组件 -->
                    <div class="flex flex-wrap items-center justify-between gap-3 bg-white p-3 rounded-xl border border-[#aecfd1] text-xs text-[#5a7a7d]">
                        <div class="flex items-center gap-2">
                            <span>第 <strong class="text-[#2c3e50]">{{ fragmentsPage }}</strong> / <strong class="text-[#2c3e50]">{{ fragmentsTotalPages }}</strong> 页</span>
                            <span class="text-gray-300">|</span>
                            <span>共 <strong class="text-[#2c3e50]">{{ fragmentsTotal }}</strong> 条</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <button @click="fetchFragments(1)" :disabled="fragmentsPage <= 1 || fragmentsLoading" 
                                    class="px-2.5 py-1.5 border border-[#aecfd1] rounded-lg hover:bg-[#f4f9f9] disabled:opacity-40 disabled:cursor-not-allowed transition-colors">
                                首页
                            </button>
                            <button @click="fetchFragments(fragmentsPage - 1)" :disabled="fragmentsPage <= 1 || fragmentsLoading" 
                                    class="px-3 py-1.5 border border-[#aecfd1] rounded-lg hover:bg-[#f4f9f9] disabled:opacity-40 disabled:cursor-not-allowed transition-colors">
                                上一页
                            </button>
                            <button @click="fetchFragments(fragmentsPage + 1)" :disabled="fragmentsPage >= fragmentsTotalPages || fragmentsLoading" 
                                    class="px-3 py-1.5 border border-[#aecfd1] rounded-lg hover:bg-[#f4f9f9] disabled:opacity-40 disabled:cursor-not-allowed transition-colors">
                                下一页
                            </button>
                            <button @click="fetchFragments(fragmentsTotalPages)" :disabled="fragmentsPage >= fragmentsTotalPages || fragmentsLoading" 
                                    class="px-2.5 py-1.5 border border-[#aecfd1] rounded-lg hover:bg-[#f4f9f9] disabled:opacity-40 disabled:cursor-not-allowed transition-colors">
                                末页
                            </button>
                            <div class="flex items-center gap-1 ml-2">
                                <span>跳至</span>
                                <input type="number" min="1" :max="fragmentsTotalPages" :value="fragmentsPage" 
                                       @keyup.enter="e => { const p = parseInt(e.target.value); if (p >= 1 && p <= fragmentsTotalPages) fetchFragments(p); }"
                                       class="w-12 px-1.5 py-1 border border-[#aecfd1] rounded text-center text-xs focus:outline-none focus:border-[#4199a0]">
                                <span>页</span>
                            </div>
                        </div>
                    </div>

                </div>
            </section>


            <!-- QQ设置 -->
            <section v-show="currentTab === 'qq_config'">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-lg font-semibold text-[#2c3e50]">QQ Bot 配置</h2>
                    <button @click="saveQQConfig()" :disabled="loading.qqConfig" class="bg-[#4199a0] hover:bg-[#77b5b4] text-white px-4 py-1.5 rounded-lg text-sm font-medium transition-colors disabled:opacity-50 flex items-center">
                        <span v-if="loading.qqConfig" class="mr-2">
                            <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                        </span>
                        保存配置
                    </button>
                </div>
                
                <div v-if="loading.fetchQqConfig" class="text-center py-8 text-[#5a7a7d]">加载配置中...</div>
                <div v-else class="space-y-4">
                    
                    <!-- 核心模型配置 -->
                    <div class="bg-white rounded-xl border border-[#aecfd1] p-4">
                        <h3 class="text-sm font-semibold text-[#2c3e50] mb-3 pb-2 border-b border-[#aecfd1]/50">核心模型配置</h3>
                        <div class="space-y-3">
                            <div>
                                <label class="block text-xs font-medium text-[#5a7a7d] mb-1">默认调用模型</label>
                                <select v-model="qqConfig.DEFAULT_MODEL" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-2 text-sm text-[#2c3e50] focus:outline-none focus:border-[#4199a0] focus:ring-1 focus:ring-[#4199a0]">
                                    <optgroup v-for="p in providers" :key="p.id" :label="p.name">
                                        <option v-for="m in parseModels(p.supported_models)" :key="m" :value="m">{{ m }}</option>
                                    </optgroup>
                                    <option v-if="qqConfig.DEFAULT_MODEL && !allAvailableModels.includes(qqConfig.DEFAULT_MODEL)" :value="qqConfig.DEFAULT_MODEL">
                                        {{ qqConfig.DEFAULT_MODEL }} (当前自定义)
                                    </option>
                                </select>
                                <p class="text-[10px] text-[#77b5b4] mt-1">选择网关中已配置供应商支持的模型。如果选中的模型不可用，将返回 502/503 错误。</p>
                            </div>
                        </div>
                    </div>

                    <!-- 提示词配置 -->
                    <div class="bg-white rounded-xl border border-[#aecfd1] p-4">
                        <h3 class="text-sm font-semibold text-[#2c3e50] mb-3 pb-2 border-b border-[#aecfd1]/50">人格提示词 (System Prompt)</h3>
                        <div class="space-y-4">
                            <div>
                                <label class="block text-xs font-medium text-[#5a7a7d] mb-1">QQ 社交人格 (通用)</label>
                                <textarea v-model="qqConfig.DEFAULT_PROMPT" rows="8" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-2 text-xs text-[#2c3e50] focus:outline-none focus:border-[#4199a0] font-mono" placeholder="输入通用的 QQ 机器人人格设定..."></textarea>
                                <p class="text-[10px] text-[#77b5b4] mt-1">适用于所有 QQ 消息来源的基础人格设定。</p>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-[#5a7a7d] mb-1">蕊蕊专属规则 (追加)</label>
                                <textarea v-model="qqConfig.RUIRUI_PROMPT" rows="4" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-2 text-xs text-[#2c3e50] focus:outline-none focus:border-[#4199a0] font-mono" placeholder="输入对蕊蕊的特殊规则设定..."></textarea>
                                <p class="text-[10px] text-[#77b5b4] mt-1">当发送者为蕊蕊时，此规则将追加在基础人格之后。</p>
                        </div>
                    </div>

                    <!-- 基础参数配置 -->
                    <div class="bg-white rounded-xl border border-[#aecfd1] p-4">
                        <h3 class="text-sm font-semibold text-[#2c3e50] mb-3 pb-2 border-b border-[#aecfd1]/50">基础参数</h3>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-medium text-[#5a7a7d] mb-1">Bot QQ号</label>
                                <input v-model.number="qqConfig.BOT_QQ" type="number" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-1.5 text-sm text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-[#5a7a7d] mb-1">蕊蕊 QQ号</label>
                                <input v-model.number="qqConfig.RUIRUI_QQ" type="number" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-1.5 text-sm text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-[#5a7a7d] mb-1">私聊静默超时(秒)</label>
                                <input v-model.number="qqConfig.SILENCE_TIMEOUT" type="number" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-1.5 text-sm text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                                <p class="text-[10px] text-[#77b5b4] mt-0.5">多久不说话认为一波消息发完</p>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-[#5a7a7d] mb-1">结束符 Emoji</label>
                                <input v-model="qqConfig.END_EMOJI" type="text" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-1.5 text-sm text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                                <p class="text-[10px] text-[#77b5b4] mt-0.5">发此表情立即触发回复</p>
                            </div>
                        </div>
                    </div>

                    <!-- 群聊聚合配置 -->
                    <div class="bg-white rounded-xl border border-[#aecfd1] p-4">
                        <h3 class="text-sm font-semibold text-[#2c3e50] mb-3 pb-2 border-b border-[#aecfd1]/50">群聊聚合</h3>
                        <div class="space-y-3">
                            <div>
                                <label class="block text-xs font-medium text-[#5a7a7d] mb-1">触发关键词 (英文逗号分隔)</label>
                                <input v-model="qqConfig.GROUP_KEYWORDS" type="text" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-1.5 text-sm text-[#2c3e50] focus:outline-none focus:border-[#4199a0]" placeholder="沈,杏仁,完能,浣熊">
                            </div>
                            <div class="grid grid-cols-2 gap-3">
                                <div>
                                    <label class="block text-xs font-medium text-[#5a7a7d] mb-1">上下文保留条数</label>
                                    <input v-model.number="qqConfig.GROUP_BUFFER_SIZE" type="number" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-1.5 text-sm text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-[#5a7a7d] mb-1">上下文保留时间(秒)</label>
                                    <input v-model.number="qqConfig.GROUP_BUFFER_TIME" type="number" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-1.5 text-sm text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- 群聊语义判断 -->
                    <div class="bg-white rounded-xl border border-[#aecfd1] p-4">
                        <h3 class="text-sm font-semibold text-[#2c3e50] mb-3 pb-2 border-b border-[#aecfd1]/50">群聊语义判断</h3>
                        <div class="space-y-3">
                            <div class="grid grid-cols-2 gap-3">
                                <div>
                                    <label class="block text-xs font-medium text-[#5a7a7d] mb-1">判断模型</label>
                                    <input v-model="qqConfig.JUDGE_MODEL" type="text" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-1.5 text-sm text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                                    <p class="text-[10px] text-[#77b5b4] mt-0.5">用于判断是否参与群聊的轻量模型</p>
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-[#5a7a7d] mb-1">判断间隔(条)</label>
                                    <input v-model.number="qqConfig.GROUP_JUDGE_INTERVAL" type="number" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-1.5 text-sm text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                                    <p class="text-[10px] text-[#77b5b4] mt-0.5">每累计多少条消息触发一次主动判断</p>
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-[#5a7a7d] mb-1">判断提示词</label>
                                <textarea v-model="qqConfig.GROUP_JUDGE_PROMPT" rows="8" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-2 text-xs text-[#2c3e50] focus:outline-none focus:border-[#4199a0] font-mono" placeholder="输入群聊语义判断的System Prompt..."></textarea>
                                <p class="text-[10px] text-[#77b5b4] mt-1">判断沈栖是否应参与群聊的依据，返回YES/NO</p>
                            </div>
                        </div>
                    </div>
                    <!-- 高级控制 -->
                    <div class="bg-white rounded-xl border border-[#aecfd1] p-4">
                        <h3 class="text-sm font-semibold text-[#2c3e50] mb-3 pb-2 border-b border-[#aecfd1]/50">高级控制</h3>
                        <div class="grid grid-cols-2 gap-3 mb-3">
                            <div>
                                <label class="block text-xs font-medium text-[#5a7a7d] mb-1">回复分段延迟(最小/秒)</label>
                                <input v-model.number="qqConfig.REPLY_DELAY_MIN" type="number" step="0.1" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-1.5 text-sm text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-[#5a7a7d] mb-1">回复分段延迟(最大/秒)</label>
                                <input v-model.number="qqConfig.REPLY_DELAY_MAX" type="number" step="0.1" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-1.5 text-sm text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-[#5a7a7d] mb-1">Session最大保留轮次</label>
                            <input v-model.number="qqConfig.SESSION_MAX_TURNS" type="number" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-1.5 text-sm text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                            <p class="text-[10px] text-[#77b5b4] mt-0.5">送入模型的短期记忆上下文长度上限（结合记忆网关可保持较小值）</p>
                        </div>
                    </div>

                </div>
            </section>

            <!-- Proactive 模块 -->
            <section v-show="currentTab === 'proactive'">
                <!-- 实时状态概览 -->
                <div class="mb-4">
                    <h2 class="text-lg font-semibold text-[#2c3e50] mb-3">实时状态</h2>
                    <div class="grid grid-cols-2 gap-3">
                        <div class="bg-white rounded-xl p-3 border border-[#aecfd1] shadow-sm flex flex-col justify-center">
                            <span class="text-xs text-[#77b5b4] mb-1">功能状态</span>
                            <div class="flex items-center gap-2">
                                <div class="w-2.5 h-2.5 rounded-full" :class="proactiveConfig.proactive_enabled === '1' ? 'bg-emerald-500' : 'bg-slate-400'"></div>
                                <span class="text-sm font-medium text-[#2c3e50]">{{ proactiveConfig.proactive_enabled === '1' ? '已启用' : '已禁用' }}</span>
                            </div>
                        </div>
                        <div class="bg-white rounded-xl p-3 border border-[#aecfd1] shadow-sm flex flex-col justify-center">
                            <span class="text-xs text-[#77b5b4] mb-1">距蕊蕊上次发消息</span>
                            <span class="text-sm font-medium text-[#2c3e50]" v-if="proactiveStatus.delta_minutes !== undefined">{{ proactiveStatus.delta_minutes.toFixed(1) }} 分钟前</span>
                            <span class="text-sm font-medium text-[#2c3e50]" v-else>--</span>
                        </div>
                        <div class="bg-white rounded-xl p-3 border border-[#aecfd1] shadow-sm flex flex-col justify-center col-span-2">
                            <span class="text-xs text-[#77b5b4] mb-1">下次预计触发时间</span>
                            <div class="flex justify-between items-end">
                                <span class="text-sm font-medium text-[#2c3e50]" v-if="proactiveStatus.next_trigger_time">{{ formatAbsoluteTime(proactiveStatus.next_trigger_time) }}</span>
                                <span class="text-sm font-medium text-[#2c3e50]" v-else>未倒计时 (可能已禁用)</span>
                                
                                <span class="text-xs font-mono text-[#38a3a5]" v-if="proactiveStatus.seconds_until_trigger !== null">
                                    {{ Math.floor(proactiveStatus.seconds_until_trigger / 60) }}分 {{ Math.floor(proactiveStatus.seconds_until_trigger % 60) }}秒
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 参数配置面板 -->
                <div class="mb-4">
                    <div class="flex justify-between items-center mb-3">
                        <h2 class="text-lg font-semibold text-[#2c3e50]">参数配置</h2>
                        <button @click="saveProactiveConfig" class="bg-[#4199a0] hover:bg-[#77b5b4] text-white px-3 py-1.5 rounded-lg text-sm font-medium transition-colors">
                            保存生效
                        </button>
                    </div>
                    <div class="bg-white rounded-xl p-4 border border-[#aecfd1] shadow-sm space-y-4">
                        <div class="flex items-center justify-between">
                            <div>
                                <span class="text-sm font-medium text-[#2c3e50]">主动搭话功能</span>
                                <p class="text-xs text-[#77b5b4] mt-0.5">控制是否自动倒计时并在超时后主动发起对话</p>
                            </div>
                            <div @click="proactiveConfig.proactive_enabled = proactiveConfig.proactive_enabled === '1' ? '0' : '1'" class="relative w-11 h-6 rounded-full transition-colors duration-300 cursor-pointer" :class="proactiveConfig.proactive_enabled === '1' ? 'bg-emerald-500' : 'bg-slate-300'">
                                <div class="absolute top-0.5 w-5 h-5 rounded-full bg-white shadow-md transition-all duration-300" :class="proactiveConfig.proactive_enabled === '1' ? 'left-[22px]' : 'left-0.5'"></div>
                            </div>
                        </div>
                        
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-medium text-[#5a7a7d] mb-1">基准等待时长 (分钟)</label>
                                <input v-model.number="proactiveConfig.proactive_base_wait" type="number" class="w-full bg-[#f7fafa] border border-[#aecfd1] rounded px-2 py-1.5 text-sm text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-[#5a7a7d] mb-1">最小触发间隔 (分钟)</label>
                                <input v-model.number="proactiveConfig.proactive_min_wait" type="number" class="w-full bg-[#f7fafa] border border-[#aecfd1] rounded px-2 py-1.5 text-sm text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-[#5a7a7d] mb-1">最大沉默降权 (分钟)</label>
                                <input v-model.number="proactiveConfig.proactive_max_silence" type="number" class="w-full bg-[#f7fafa] border border-[#aecfd1] rounded px-2 py-1.5 text-sm text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-[#5a7a7d] mb-1">随机波动范围 (比例)</label>
                                <input v-model.number="proactiveConfig.proactive_random_range" type="number" step="0.1" class="w-full bg-[#f7fafa] border border-[#aecfd1] rounded px-2 py-1.5 text-sm text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                            </div>
                        </div>
                        

                    </div>
                </div>

                <!-- 日志面板 -->
                <div>
                    <div class="flex justify-between items-center mb-3">
                        <h2 class="text-lg font-semibold text-[#2c3e50]">执行日志</h2>
                        <select v-model="proactiveLogFilter" @change="fetchProactiveLogs(1)" class="bg-white border border-[#aecfd1] rounded px-2 py-1 text-xs text-[#5a7a7d] focus:outline-none">
                            <option value="all">全部事件</option>
                            <option value="sent">仅已发送</option>
                            <option value="blocked">仅被拦截</option>
                        </select>
                    </div>
                    
                    <div class="bg-white rounded-xl border border-[#aecfd1] overflow-hidden">
                        <div v-if="proactiveLogs.length === 0" class="p-6 text-center text-[#77b5b4] text-sm">
                            暂无日志记录
                        </div>
                        <div class="divide-y divide-[#aecfd1]/30">
                            <div v-for="log in proactiveLogs" :key="log.id" class="p-3">
                                <div class="flex justify-between items-start mb-1">
                                    <div class="flex items-center gap-2">
                                        <span class="text-[10px] px-1.5 py-0.5 rounded font-medium" 
                                              :class="{
                                                  'bg-slate-100 text-slate-500': log.event_type === 'started',
                                                  'bg-blue-100 text-blue-600': log.event_type === 'decision',
                                                  'bg-emerald-100 text-[#38a3a5]': log.event_type === 'sent',
                                                  'bg-amber-100 text-amber-600': log.event_type === 'blocked'
                                              }">
                                            {{ {'started':'倒计时','decision':'决策中','sent':'已发送','blocked':'已拦截'}[log.event_type] || log.event_type }}
                                        </span>
                                        <span class="text-xs text-[#5a7a7d]">{{ formatTime(log.created_at) }}</span>
                                    </div>
                                    <span v-if="log.wait_minutes" class="text-[10px] text-[#77b5b4] bg-[#f7fafa] px-1 rounded">{{ log.wait_minutes.toFixed(1) }}m</span>
                                </div>
                                <div v-if="log.reason" class="text-xs mt-1">
                                    <span class="text-[#77b5b4]">拦截原因：</span>
                                    <span class="text-amber-600">{{ {'night_silence':'夜间免打扰','too_soon':'防撞车(刚聊完)','locked':'防撞车(正在回复)','ai_skipped':'AI认为无需发言'}[log.reason] || log.reason }}</span>
                                </div>
                                <div v-if="log.summary" class="text-xs mt-1 text-[#2c3e50] bg-[#f7fafa] p-1.5 rounded border border-[#aecfd1]/30">
                                    {{ log.summary }}
                                </div>
                            </div>
                        </div>
                        
                        <!-- 分页 -->
                        <div class="p-3 border-t border-[#aecfd1]/30 flex justify-between items-center bg-[#f7fafa]" v-if="proactiveLogTotal > proactiveLogLimit">
                            <button @click="fetchProactiveLogs(proactiveLogPage - 1)" :disabled="proactiveLogPage === 1" class="text-xs px-2 py-1 bg-white border border-[#aecfd1] rounded text-[#5a7a7d] disabled:opacity-50">上一页</button>
                            <span class="text-[10px] text-[#77b5b4]">{{ proactiveLogPage }} / {{ Math.ceil(proactiveLogTotal / proactiveLogLimit) }}</span>
                            <button @click="fetchProactiveLogs(proactiveLogPage + 1)" :disabled="proactiveLogPage >= Math.ceil(proactiveLogTotal / proactiveLogLimit)" class="text-xs px-2 py-1 bg-white border border-[#aecfd1] rounded text-[#5a7a7d] disabled:opacity-50">下一页</button>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ==================== Life Hub 模块 ==================== -->
            <section v-show="currentTab === 'life_hub'" class="space-y-4">
                <!-- 头部操作栏 -->
                <div class="flex justify-between items-center bg-white rounded-2xl p-4 border border-[#aecfd1] shadow-sm">
                    <div>
                        <h2 class="text-lg font-bold bg-gradient-to-r from-[#4199a0] to-[#77b5b4] bg-clip-text text-transparent">Life Hub 双人生活簿</h2>
                        <p class="text-xs text-[#5a7a7d] mt-0.5">记账、备忘、生理期与 AI 钱包管理</p>
                    </div>
                    <button @click="fetchLifeHubAll()" class="px-3 py-1.5 bg-[#deebec] hover:bg-[#aecfd1] text-[#4199a0] rounded-xl text-xs font-semibold transition-all flex items-center gap-1.5 shadow-sm active:scale-95">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                        刷新全部
                    </button>
                </div>

                <!-- ==================== 0. 消费统计可视化看板 ==================== -->
                <div class="bg-white rounded-2xl p-4 border border-[#aecfd1] shadow-sm space-y-4">
                    <div class="flex items-center justify-between border-b border-[#aecfd1]/40 pb-2.5">
                        <div class="flex items-center gap-2">
                            <span class="text-base">📊</span>
                            <h3 class="font-semibold text-[#2c3e50] text-sm">消费统计与分析</h3>
                        </div>
                        <span class="text-[11px] px-2 py-0.5 rounded-full bg-[#deebec] text-[#4199a0] font-medium font-mono">实时收支</span>
                    </div>

                    <!-- 1. 周期收支与分类占比联动看板 (整合 日 / 周 / 月 / 自定义 切换) -->
                    <div class="bg-[#fafcfc] rounded-xl p-3.5 border border-[#aecfd1]/60 space-y-3.5">
                        <div class="flex flex-wrap items-center justify-between gap-2">
                            <!-- 周期切换按钮组 -->
                            <div class="flex items-center gap-1 bg-[#deebec] p-0.5 rounded-lg text-xs">
                                <button @click="setCategoryRangeTab('today')"
                                        :class="categoryRangeTab === 'today' ? 'bg-white text-[#4199a0] font-semibold shadow-xs' : 'text-[#5a7a7d]'"
                                        class="px-3 py-1 rounded-md transition-all">今日</button>
                                <button @click="setCategoryRangeTab('week')"
                                        :class="categoryRangeTab === 'week' ? 'bg-white text-[#4199a0] font-semibold shadow-xs' : 'text-[#5a7a7d]'"
                                        class="px-3 py-1 rounded-md transition-all">本周</button>
                                <button @click="setCategoryRangeTab('month')"
                                        :class="categoryRangeTab === 'month' ? 'bg-white text-[#4199a0] font-semibold shadow-xs' : 'text-[#5a7a7d]'"
                                        class="px-3 py-1 rounded-md transition-all">本月</button>
                                <button @click="setCategoryRangeTab('custom')"
                                        :class="categoryRangeTab === 'custom' ? 'bg-white text-[#4199a0] font-semibold shadow-xs' : 'text-[#5a7a7d]'"
                                        class="px-3 py-1 rounded-md transition-all">自定义</button>
                            </div>
                            <span class="text-[11px] text-[#77b5b4] font-mono">{{ categoryRangeDateDesc }}</span>
                        </div>

                        <!-- 自定义日期选择器 -->
                        <div v-if="categoryRangeTab === 'custom'" class="p-2.5 bg-white rounded-xl border border-[#aecfd1]/60 space-y-2 overflow-hidden">
                            <div class="flex items-center gap-1.5 w-full">
                                <input type="date" v-model="categoryCustomStart" class="w-1/2 flex-1 min-w-0 bg-[#fafcfc] border border-[#aecfd1] rounded-lg px-1.5 py-1.5 text-xs text-[#2c3e50] font-mono focus:outline-none focus:border-[#4199a0]">
                                <span class="text-xs text-[#5a7a7d] flex-shrink-0">至</span>
                                <input type="date" v-model="categoryCustomEnd" class="w-1/2 flex-1 min-w-0 bg-[#fafcfc] border border-[#aecfd1] rounded-lg px-1.5 py-1.5 text-xs text-[#2c3e50] font-mono focus:outline-none focus:border-[#4199a0]">
                            </div>
                            <button @click="fetchCategoryStat" class="w-full py-1.5 bg-[#4199a0] hover:bg-[#357f86] text-white text-xs font-semibold rounded-lg transition-colors shadow-xs">查询此区间</button>
                        </div>

                        <!-- 汇总数据展示条 -->
                        <div class="bg-gradient-to-br from-[#f0f7f7] to-[#deebec] rounded-xl p-3.5 border border-[#aecfd1]/60 flex items-center justify-between">
                            <div>
                                <div class="text-xs text-[#5a7a7d] font-medium">{{ currentRangeTitle }}</div>
                                <div class="text-2xl sm:text-3xl font-extrabold text-[#2c3e50] font-mono mt-0.5 flex items-baseline gap-1">
                                    <span class="text-sm font-normal text-[#5a7a7d]">¥</span>
                                    <span>{{ categoryStatData && categoryStatData.total_expense !== undefined ? categoryStatData.total_expense.toFixed(2) : '0.00' }}</span>
                                </div>
                            </div>
                            <div class="text-right space-y-1">
                                <div class="text-[11px] px-2 py-0.5 rounded-full bg-white text-[#4199a0] font-mono font-semibold inline-block">
                                    {{ categoryStatData ? (categoryStatData.expense_count || categoryStatData.count || 0) : 0 }} 笔支出
                                </div>
                                <div v-if="categoryStatData && categoryStatData.total_income > 0" class="text-[10px] text-[#38a3a5] font-mono">
                                    收入 +¥{{ categoryStatData.total_income.toFixed(2) }}
                                </div>
                            </div>
                        </div>

                        <!-- 饼图 & 分类明细 -->
                        <div v-if="categoryStatLoading" class="py-8 text-center text-xs text-[#77b5b4]">
                            统计加载中...
                        </div>
                        <div v-else-if="!categoryStatData || !categoryPieList || categoryPieList.length === 0" class="py-8 text-center text-xs text-[#77b5b4] bg-white rounded-xl border border-[#aecfd1]/30">
                            该时段暂无支出记录
                        </div>
                        <div v-else class="flex flex-col sm:flex-row items-center gap-4 pt-1">
                            <!-- 纯 CSS Conic-Gradient 环形甜甜圈图 -->
                            <div class="relative w-32 h-32 rounded-full flex-shrink-0 flex items-center justify-center shadow-md transition-all duration-500"
                                 :style="{ background: categoryConicGradient }">
                                <div class="w-20 h-20 bg-white rounded-full flex flex-col items-center justify-center shadow-inner text-center">
                                    <span class="text-[9px] text-[#77b5b4] scale-90">总支出</span>
                                    <span class="text-xs font-bold text-[#2c3e50] font-mono truncate px-1">¥{{ categoryStatData.total_expense.toFixed(2) }}</span>
                                </div>
                            </div>

                            <!-- 右侧分类明细列表 -->
                            <div class="w-full space-y-1.5">
                                <div v-for="item in categoryPieList" :key="item.category"
                                     class="flex items-center justify-between text-xs p-2 rounded-lg bg-white border border-[#aecfd1]/40 shadow-2xs">
                                    <div class="flex items-center gap-2 min-w-0">
                                        <span class="w-2.5 h-2.5 rounded-full flex-shrink-0" :style="{ backgroundColor: item.color }"></span>
                                        <span class="font-medium text-[#2c3e50] truncate">{{ item.category }}</span>
                                    </div>
                                    <div class="flex items-center gap-3 font-mono flex-shrink-0">
                                        <span class="text-[11px] text-[#5a7a7d] w-12 text-right">{{ item.percent }}%</span>
                                        <span class="font-semibold text-[#2c3e50] w-18 text-right">¥{{ item.amount.toFixed(2) }}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 2. 月度消费热力图 (大格子日历，对齐对话记录热力图风格) -->
                    <div class="bg-[#fafcfc] rounded-xl p-3 border border-[#aecfd1]/60 space-y-2.5">
                        <div class="flex justify-between items-center mb-1">
                            <button @click="prevExpenseHeatmapMonth" class="text-[#5a7a7d] hover:text-[#4199a0] p-1.5 transition-colors rounded-lg hover:bg-[#deebec]">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                            </button>
                            <div class="text-center">
                                <span class="text-sm font-semibold text-[#2c3e50]">{{ expenseHeatmapYear }}年{{ expenseHeatmapMonth }}月</span>
                                <span class="text-xs text-[#77b5b4] ml-2 font-mono">(支出 ¥{{ expenseHeatmapTotal.toFixed(2) }})</span>
                            </div>
                            <button @click="nextExpenseHeatmapMonth" class="text-[#5a7a7d] hover:text-[#4199a0] p-1.5 transition-colors rounded-lg hover:bg-[#deebec]">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                            </button>
                        </div>

                        <!-- 日历 7 列网格 -->
                        <div class="grid grid-cols-7 gap-1 text-center">
                            <div v-for="d in ['日','一','二','三','四','五','六']" :key="d" class="text-[10px] text-[#77b5b4] py-0.5 font-medium">{{ d }}</div>
                            <template v-for="(week, wi) in expenseHeatmapWeeks" :key="wi">
                                <div v-for="(cell, ci) in week" :key="wi+'-'+ci"
                                     @click="clickExpenseCalendarDay(cell)"
                                     class="aspect-square rounded-md flex flex-col items-center justify-center text-[10px] transition-all relative select-none"
                                     :class="[
                                         cell ? 'cursor-pointer' : '',
                                         cell && selectedHeatmapDay && selectedHeatmapDay.date === cell.date ? 'ring-2 ring-[#4199a0] scale-105 shadow-md z-10' : (cell && cell.amount > 0 ? 'hover:ring-2 hover:ring-[#4199a0]/60 hover:scale-105' : 'hover:scale-105 bg-[#f5f9f9]')
                                     ]"
                                     :style="cell && cell.amount > 0 ? { backgroundColor: 'rgba(65,153,160,' + Math.min(0.20 + 0.80 * cell.amount / (expenseHeatmapMaxDay || 1), 1) + ')' } : {}"
                                     :title="cell ? (cell.amount > 0 ? cell.day+'日: 支出 ¥'+cell.amount.toFixed(2)+' ('+cell.count+'笔，点击查看明细)' : cell.day+'日: 无支出') : ''">
                                    <span v-if="cell" :class="cell.amount > 0 && cell.amount / (expenseHeatmapMaxDay || 1) > 0.45 ? 'text-white font-semibold' : 'text-[#5a7a7d]'" class="leading-none text-[11px]">{{ cell.day }}</span>
                                    <span v-if="cell && cell.amount > 0" :class="cell.amount / (expenseHeatmapMaxDay || 1) > 0.45 ? 'text-white/90 font-medium' : 'text-[#4199a0] font-medium'" class="text-[8px] leading-none mt-0.5 font-mono">¥{{ Math.round(cell.amount) }}</span>
                                </div>
                            </template>
                        </div>

                        <!-- 图例 -->
                        <div class="flex items-center justify-between text-[9px] text-[#77b5b4] pt-2 border-t border-[#aecfd1]/30">
                            <span>本月 {{ expenseHeatmapActiveDays }} 天有消费</span>
                            <div class="flex items-center gap-2">
                                <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-sm bg-[#f5f9f9] border border-[#e0e0e0]"></span>0</span>
                                <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-sm" style="background:rgba(65,153,160,0.30)"></span>少</span>
                                <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-sm" style="background:rgba(65,153,160,0.60)"></span>中</span>
                                <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-sm" style="background:rgba(65,153,160,0.85)"></span>多</span>
                                <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-sm bg-[#4199a0]"></span>最多</span>
                            </div>
                        </div>

                        <!-- 当日具体账目展开区域 -->
                        <div v-if="selectedHeatmapDay" class="mt-3 pt-3 border-t border-[#aecfd1]/50 space-y-2.5 transition-all">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-1.5 min-w-0">
                                    <span class="text-xs font-semibold text-[#2c3e50] flex items-center gap-1 truncate">
                                        <span>📅</span>
                                        <span>{{ selectedHeatmapDay.date }} 账目明细</span>
                                    </span>
                                    <span class="text-[10px] px-2 py-0.5 rounded-full bg-[#deebec] text-[#4199a0] font-mono font-semibold flex-shrink-0">
                                        {{ dayTxList.length }} 笔 · 支出 ¥{{ (selectedHeatmapDay.amount || 0).toFixed(2) }}
                                    </span>
                                </div>
                                <button @click="selectedHeatmapDay = null; dayTxList = []" class="text-[#5a7a7d] hover:text-[#4199a0] p-1 text-xs flex-shrink-0 transition-colors">
                                    ✕ 收起
                                </button>
                            </div>

                            <!-- 账目明细列表 -->
                            <div v-if="dayTxLoading" class="py-4 text-center text-xs text-[#77b5b4]">
                                加载明细中...
                            </div>
                            <div v-else-if="dayTxList.length === 0" class="py-4 text-center text-xs text-[#77b5b4] bg-white rounded-lg border border-[#aecfd1]/30">
                                当日暂无支出明细
                            </div>
                            <div v-else class="space-y-1.5 max-h-64 overflow-y-auto hide-scrollbar">
                                <div v-for="tx in dayTxList" :key="tx.id"
                                     class="flex items-center justify-between p-2 rounded-lg bg-white border border-[#aecfd1]/40 text-xs shadow-2xs">
                                    <div class="flex items-center gap-2 min-w-0">
                                        <span class="px-1.5 py-0.5 rounded text-[10px] font-medium flex-shrink-0"
                                              :class="tx.owner === 'ai' ? 'bg-[#4199a0]/15 text-[#4199a0]' : 'bg-[#38a3a5]/15 text-[#38a3a5]'">
                                            {{ tx.payer || (tx.owner === 'ai' ? '沈栖' : '蕊蕊') }}
                                        </span>
                                        <span class="font-medium text-[#2c3e50] px-1.5 py-0.5 rounded bg-[#f0f7f7] text-[10px] flex-shrink-0">
                                            {{ tx.category }}
                                        </span>
                                        <span v-if="tx.note" class="text-[#5a7a7d] text-[11px] truncate max-w-[120px] sm:max-w-[220px]" :title="tx.note">
                                            {{ tx.note }}
                                        </span>
                                    </div>
                                    <div class="flex items-center gap-2 flex-shrink-0 font-mono">
                                        <span class="font-semibold text-sm" :class="tx.amount < 0 ? 'text-[#2c3e50]' : 'text-[#38a3a5]'">
                                            {{ tx.amount < 0 ? '-' : '+' }}¥{{ Math.abs(tx.amount).toFixed(2) }}
                                        </span>
                                        <span class="text-[9px] text-[#77b5b4] hidden sm:inline">
                                            {{ (tx.created_at || '').slice(11, 16) }}
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2.1 钱包卡片 -->
                <div class="bg-white rounded-2xl p-4 border border-[#aecfd1] shadow-sm space-y-4">
                    <div class="flex items-center justify-between border-b border-[#aecfd1]/40 pb-2.5">
                        <div class="flex items-center gap-2">
                            <span class="text-base">💰</span>
                            <h3 class="font-semibold text-[#2c3e50] text-sm">AI 钱包与小金库</h3>
                        </div>
                        <span class="text-[11px] px-2 py-0.5 rounded-full bg-[#deebec] text-[#4199a0] font-medium font-mono">service: life-hub:8081</span>
                    </div>

                    <!-- 钱包余额看板 -->
                    <div class="bg-gradient-to-br from-[#4199a0] via-[#357f86] to-[#2c3e50] text-white p-4 rounded-xl shadow-inner relative overflow-hidden">
                        <div class="absolute -right-6 -bottom-6 w-28 h-28 bg-white/10 rounded-full blur-xl pointer-events-none"></div>
                        <div class="text-xs text-cyan-100 font-medium tracking-wide">当前可用余额 (实时)</div>
                        <div class="text-3xl font-extrabold tracking-tight mt-1 mb-3 font-mono flex items-baseline gap-1">
                            <span class="text-lg font-normal text-cyan-200">¥</span>
                            <span>{{ lifeHubWallet.balance !== undefined && lifeHubWallet.balance !== null ? lifeHubWallet.balance.toFixed(2) : '0.00' }}</span>
                        </div>
                        <div class="grid grid-cols-3 gap-2 pt-2 border-t border-white/20 text-center">
                            <div class="bg-white/10 rounded-lg p-1.5 backdrop-blur-xs">
                                <div class="text-[10px] text-cyan-100">初始基准</div>
                                <div class="text-xs font-semibold font-mono">¥{{ lifeHubWallet.initial_balance !== undefined && lifeHubWallet.initial_balance !== null ? lifeHubWallet.initial_balance.toFixed(2) : '135.36' }}</div>
                            </div>
                            <div class="bg-white/10 rounded-lg p-1.5 backdrop-blur-xs">
                                <div class="text-[10px] text-cyan-100">AI累计流水</div>
                                <div class="text-xs font-semibold font-mono" :class="lifeHubWallet.ai_transactions_sum >= 0 ? 'text-emerald-300' : 'text-rose-300'">
                                    {{ lifeHubWallet.ai_transactions_sum >= 0 ? '+' : '' }}{{ lifeHubWallet.ai_transactions_sum !== undefined && lifeHubWallet.ai_transactions_sum !== null ? lifeHubWallet.ai_transactions_sum.toFixed(2) : '0.00' }}
                                </div>
                            </div>
                            <div class="bg-white/10 rounded-lg p-1.5 backdrop-blur-xs">
                                <div class="text-[10px] text-cyan-100">流水笔数</div>
                                <div class="text-xs font-semibold font-mono">{{ lifeHubWallet.ai_transactions_count || 0 }} 笔</div>
                            </div>
                        </div>
                    </div>

                    <!-- 充值/扣款表单 -->
                    <div class="bg-[#f7fafa] rounded-xl p-3.5 border border-[#aecfd1]/50 space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-semibold text-[#2c3e50] flex items-center gap-1.5">
                                <span class="w-2 h-2 rounded-full bg-[#4199a0]"></span>
                                钱包充值 / 扣款 (fund)
                            </span>
                            <span class="text-[10px] text-[#77b5b4]">正数为充值，负数为扣款</span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                            <div>
                                <label class="block text-[11px] font-medium text-[#5a7a7d] mb-1">变动金额 (元) *</label>
                                <input v-model.number="fundForm.amount" type="number" step="0.01" placeholder="例如: 50 或 -20" class="w-full bg-white border border-[#aecfd1] rounded-lg px-2.5 py-1.5 text-xs text-[#2c3e50] focus:outline-none focus:border-[#4199a0] focus:ring-1 focus:ring-[#4199a0]">
                            </div>
                            <div>
                                <label class="block text-[11px] font-medium text-[#5a7a7d] mb-1">备注说明 (note) *必填</label>
                                <input v-model="fundForm.note" type="text" placeholder="例如: 零花钱 / 奖励" class="w-full bg-white border border-[#aecfd1] rounded-lg px-2.5 py-1.5 text-xs text-[#2c3e50] focus:outline-none focus:border-[#4199a0] focus:ring-1 focus:ring-[#4199a0]">
                            </div>
                        </div>
                        <!-- 快捷充值标签 -->
                        <div class="flex flex-wrap items-center gap-1.5">
                            <span class="text-[10px] text-[#77b5b4] mr-1">快捷金额:</span>
                            <button v-for="amt in [10, 20, 50, 100, -10, -20]" :key="amt" @click="fundForm.amount = amt" class="px-2 py-0.5 text-[11px] rounded-md border font-mono transition-colors" :class="amt > 0 ? 'bg-emerald-50 border-emerald-200 text-emerald-700 hover:bg-emerald-100' : 'bg-rose-50 border-rose-200 text-rose-700 hover:bg-rose-100'">
                                {{ amt > 0 ? '+' : '' }}{{ amt }}
                            </button>
                        </div>
                        <button @click="submitFund" class="w-full py-2 bg-[#4199a0] hover:bg-[#357f86] text-white text-xs font-semibold rounded-lg transition-colors shadow-sm">
                            确认执行变动
                        </button>
                    </div>

                    <!-- 钱包充值/扣款历史明细 (独立账本) -->
                    <div class="space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-semibold text-[#2c3e50] flex items-center gap-1.5">
                                <span class="w-2 h-2 rounded-full bg-[#77b5b4]"></span>
                                充值与扣款历史记录 (小金库流水)
                            </span>
                            <button @click="fetchLifeHubFundHistory" class="text-[11px] text-[#4199a0] hover:underline font-medium">刷新记录</button>
                        </div>
                        <div class="space-y-1.5 max-h-48 overflow-y-auto pr-1">
                            <div v-if="fundList.length === 0" class="text-center py-4 text-xs text-[#77b5b4] bg-[#f7fafa] rounded-xl border border-dashed border-[#aecfd1]">
                                暂无充值/扣款记录
                            </div>
                            <div v-for="item in fundList" :key="item.id" class="bg-[#f7fafa] p-2.5 rounded-xl border border-[#aecfd1]/40 flex items-center justify-between text-xs hover:bg-[#eef5f6] transition-colors">
                                <div class="space-y-0.5">
                                    <div class="flex items-center gap-1.5">
                                        <span class="px-1.5 py-0.2 rounded text-[10px] font-bold font-mono" :class="item.amount >= 0 ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800'">
                                            {{ item.category }}
                                        </span>
                                        <span class="font-medium text-[#2c3e50]">{{ item.note || '(无备注)' }}</span>
                                    </div>
                                    <div class="text-[10px] text-[#77b5b4] font-mono">{{ item.created_at }}</div>
                                </div>
                                <div class="text-xs font-bold font-mono" :class="item.amount >= 0 ? 'text-[#38a3a5]' : 'text-rose-600'">
                                    {{ item.amount > 0 ? '+' : '' }}{{ item.amount.toFixed(2) }}元
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2.2 记账卡片 -->
                <div class="bg-white rounded-2xl p-4 border border-[#aecfd1] shadow-sm space-y-4">
                    <div class="flex items-center justify-between border-b border-[#aecfd1]/40 pb-2.5">
                        <div class="flex items-center gap-2">
                            <span class="text-base">📝</span>
                            <h3 class="font-semibold text-[#2c3e50] text-sm">日常记账与统计</h3>
                        </div>
                    </div>

                    <!-- 快速记账表单 -->
                    <div class="bg-[#f7fafa] rounded-xl p-3.5 border border-[#aecfd1]/50 space-y-3">
                        <div class="text-xs font-semibold text-[#2c3e50] flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-[#4199a0]"></span>
                            记一笔账 (add_tx)
                        </div>
                        <!-- 记账人与收支切换 -->
                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="block text-[11px] font-medium text-[#5a7a7d] mb-1">记账人 (payer)</label>
                                <div class="flex rounded-lg border border-[#aecfd1] bg-white p-0.5">
                                    <button @click="txForm.owner = 'user'" class="flex-1 py-1 text-xs rounded-md font-medium transition-all" :class="txForm.owner === 'user' ? 'bg-[#4199a0] text-white shadow-xs' : 'text-[#5a7a7d] hover:text-[#2c3e50]'">
                                        蕊蕊 (用户)
                                    </button>
                                    <button @click="txForm.owner = 'ai'" class="flex-1 py-1 text-xs rounded-md font-medium transition-all" :class="txForm.owner === 'ai' ? 'bg-[#4199a0] text-white shadow-xs' : 'text-[#5a7a7d] hover:text-[#2c3e50]'">
                                        沈栖 (AI)
                                    </button>
                                </div>
                            </div>
                            <div>
                                <label class="block text-[11px] font-medium text-[#5a7a7d] mb-1">类型</label>
                                <div class="flex rounded-lg border border-[#aecfd1] bg-white p-0.5">
                                    <button @click="txForm.type = 'expense'" class="flex-1 py-1 text-xs rounded-md font-medium transition-all" :class="txForm.type === 'expense' ? 'bg-rose-500 text-white shadow-xs' : 'text-[#5a7a7d] hover:text-[#2c3e50]'">
                                        支出
                                    </button>
                                    <button @click="txForm.type = 'income'" class="flex-1 py-1 text-xs rounded-md font-medium transition-all" :class="txForm.type === 'income' ? 'bg-emerald-500 text-white shadow-xs' : 'text-[#5a7a7d] hover:text-[#2c3e50]'">
                                        收入
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- 金额与分类 -->
                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="block text-[11px] font-medium text-[#5a7a7d] mb-1">金额 (元) *</label>
                                <input v-model.number="txForm.amount" type="number" step="0.01" placeholder="0.00" class="w-full bg-white border border-[#aecfd1] rounded-lg px-2.5 py-1.5 text-xs text-[#2c3e50] focus:outline-none focus:border-[#4199a0] focus:ring-1 focus:ring-[#4199a0]">
                            </div>
                            <div>
                                <label class="block text-[11px] font-medium text-[#5a7a7d] mb-1">分类</label>
                                <select v-model="txForm.category" class="w-full bg-white border border-[#aecfd1] rounded-lg px-2 py-1.5 text-xs text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                                    <option v-for="cat in txCategories" :key="cat" :value="cat">{{ cat }}</option>
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="block text-[11px] font-medium text-[#5a7a7d] mb-1">备注说明 (可选)</label>
                            <input v-model="txForm.note" type="text" placeholder="例如: 麦当劳早餐 / 生椰拿铁" class="w-full bg-white border border-[#aecfd1] rounded-lg px-2.5 py-1.5 text-xs text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                        </div>

                        <button @click="submitTx" class="w-full py-2 bg-[#4199a0] hover:bg-[#357f86] text-white text-xs font-semibold rounded-lg transition-colors shadow-sm">
                            记一笔
                        </button>
                    </div>

                    <!-- 月度汇总看板 (stat_tx) -->
                    <div class="bg-[#f7fafa] rounded-xl p-3.5 border border-[#aecfd1]/50 space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-semibold text-[#2c3e50] flex items-center gap-1.5">
                                <span class="w-2 h-2 rounded-full bg-[#77b5b4]"></span>
                                月度分类汇总 (stat_tx)
                            </span>
                            <div class="flex items-center gap-1.5">
                                <input v-model="statMonth" type="month" class="bg-white border border-[#aecfd1] rounded px-2 py-0.5 text-xs text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                                <button @click="fetchLifeHubStat" class="px-2 py-0.5 bg-[#4199a0] text-white rounded text-xs font-medium">统计</button>
                            </div>
                        </div>

                        <div v-if="monthlyStat" class="space-y-2.5">
                            <div class="grid grid-cols-3 gap-2 text-center">
                                <div class="bg-white p-2 rounded-lg border border-[#aecfd1]/40">
                                    <div class="text-[10px] text-[#77b5b4]">总收入</div>
                                    <div class="text-xs font-bold text-[#38a3a5] font-mono">+¥{{ monthlyStat.total_income }}</div>
                                </div>
                                <div class="bg-white p-2 rounded-lg border border-[#aecfd1]/40">
                                    <div class="text-[10px] text-[#77b5b4]">总支出</div>
                                    <div class="text-xs font-bold text-rose-600 font-mono">-¥{{ monthlyStat.total_expense }}</div>
                                </div>
                                <div class="bg-white p-2 rounded-lg border border-[#aecfd1]/40">
                                    <div class="text-[10px] text-[#77b5b4]">结余净额</div>
                                    <div class="text-xs font-bold font-mono" :class="monthlyStat.net >= 0 ? 'text-[#38a3a5]' : 'text-rose-600'">
                                        {{ monthlyStat.net >= 0 ? '+' : '' }}¥{{ monthlyStat.net }}
                                    </div>
                                </div>
                            </div>

                            <!-- 分类明细 -->
                            <div v-if="monthlyStat.by_category && Object.keys(monthlyStat.by_category).length > 0" class="flex flex-wrap gap-1.5 pt-1">
                                <span v-for="(amt, cat) in monthlyStat.by_category" :key="cat" class="px-2 py-1 bg-white border border-[#aecfd1] rounded-md text-[11px] flex items-center gap-1 font-mono">
                                    <span class="text-[#5a7a7d]">{{ cat }}:</span>
                                    <span :class="amt >= 0 ? 'text-[#38a3a5] font-semibold' : 'text-rose-600 font-semibold'">{{ amt > 0 ? '+' : '' }}{{ amt }}元</span>
                                </span>
                            </div>
                            <div v-else class="text-center text-[11px] text-[#77b5b4] py-1">该月份暂无账目数据</div>
                        </div>
                    </div>

                    <!-- 流水查询 (query_tx) -->
                    <div class="space-y-2.5">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-semibold text-[#2c3e50]">流水记录查询</span>
                            <div class="flex items-center gap-1.5">
                                <select v-model="txQuery.days" @change="fetchLifeHubTx" class="bg-white border border-[#aecfd1] rounded px-1.5 py-0.5 text-xs text-[#2c3e50]">
                                    <option :value="7">最近 7 天</option>
                                    <option :value="30">最近 30 天</option>
                                    <option :value="90">最近 90 天</option>
                                    <option :value="0">全部历史</option>
                                </select>
                                <select v-model="txQuery.owner" @change="fetchLifeHubTx" class="bg-white border border-[#aecfd1] rounded px-1.5 py-0.5 text-xs text-[#2c3e50]">
                                    <option value="all">全员</option>
                                    <option value="user">蕊蕊</option>
                                    <option value="ai">沈栖</option>
                                </select>
                            </div>
                        </div>

                        <!-- 流水列表 -->
                        <div class="space-y-1.5 max-h-64 overflow-y-auto pr-1">
                            <div v-if="txList.length === 0" class="text-center py-6 text-xs text-[#77b5b4] bg-[#f7fafa] rounded-xl border border-dashed border-[#aecfd1]">
                                暂无匹配的流水记录
                            </div>
                            <div v-for="item in txList" :key="item.id" class="bg-[#f7fafa] p-2.5 rounded-xl border border-[#aecfd1]/40 flex items-center justify-between text-xs hover:bg-[#eef5f6] transition-colors">
                                <div class="space-y-0.5">
                                    <div class="flex items-center gap-1.5">
                                        <span class="px-1.5 py-0.2 rounded text-[10px] font-medium" :class="item.owner === 'ai' ? 'bg-cyan-100 text-cyan-800' : 'bg-pink-100 text-pink-800'">
                                            {{ item.owner === 'ai' ? '沈栖' : '蕊蕊' }}
                                        </span>
                                        <span class="px-1.5 py-0.2 rounded text-[10px] bg-white border border-[#aecfd1] text-[#5a7a7d]">
                                            {{ item.category }}
                                        </span>
                                        <span class="font-medium text-[#2c3e50]">{{ item.note || '(无备注)' }}</span>
                                    </div>
                                    <div class="text-[10px] text-[#77b5b4] font-mono">{{ item.created_at }}</div>
                                </div>
                                <div class="text-sm font-bold font-mono" :class="item.amount >= 0 ? 'text-[#38a3a5]' : 'text-rose-600'">
                                    {{ item.amount > 0 ? '+' : '' }}{{ item.amount.toFixed(2) }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2.3 备忘卡片 -->
                <div class="bg-white rounded-2xl p-4 border border-[#aecfd1] shadow-sm space-y-4">
                    <div class="flex items-center justify-between border-b border-[#aecfd1]/40 pb-2.5">
                        <div class="flex items-center gap-2">
                            <span class="text-base">📌</span>
                            <h3 class="font-semibold text-[#2c3e50] text-sm">生活备忘与待办</h3>
                        </div>
                    </div>

                    <!-- 添加备忘表单 -->
                    <div class="bg-[#f7fafa] rounded-xl p-3.5 border border-[#aecfd1]/50 space-y-3">
                        <div class="text-xs font-semibold text-[#2c3e50] flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-[#4199a0]"></span>
                            添加新备忘 (add_memo)
                        </div>
                        <input v-model="memoForm.content" type="text" placeholder="写下需要提醒的事项..." class="w-full bg-white border border-[#aecfd1] rounded-lg px-2.5 py-1.5 text-xs text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="block text-[11px] font-medium text-[#5a7a7d] mb-1">截止日期 (可选)</label>
                                <input v-model="memoForm.due_date" type="date" class="w-full bg-white border border-[#aecfd1] rounded-lg px-2 py-1 text-xs text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                            </div>
                            <div>
                                <label class="block text-[11px] font-medium text-[#5a7a7d] mb-1">归属人</label>
                                <select v-model="memoForm.owner" class="w-full bg-white border border-[#aecfd1] rounded-lg px-2 py-1 text-xs text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                                    <option value="user">蕊蕊</option>
                                    <option value="ai">沈栖</option>
                                </select>
                            </div>
                        </div>
                        <button @click="submitMemo" class="w-full py-2 bg-[#4199a0] hover:bg-[#357f86] text-white text-xs font-semibold rounded-lg transition-colors shadow-sm">
                            + 添加备忘
                        </button>
                    </div>

                    <!-- 备忘列表展示 -->
                    <div class="space-y-2.5">
                        <div class="flex items-center justify-between">
                            <div class="flex rounded-lg border border-[#aecfd1] bg-[#f7fafa] p-0.5">
                                <button @click="memoTab = 'active'; fetchLifeHubMemos()" class="px-3 py-1 text-xs rounded-md font-medium transition-all" :class="memoTab === 'active' ? 'bg-[#4199a0] text-white' : 'text-[#5a7a7d]'">
                                    待办中
                                </button>
                                <button @click="memoTab = 'done'; fetchLifeHubMemos()" class="px-3 py-1 text-xs rounded-md font-medium transition-all" :class="memoTab === 'done' ? 'bg-[#4199a0] text-white' : 'text-[#5a7a7d]'">
                                    已完成
                                </button>
                                <button @click="memoTab = 'all'; fetchLifeHubMemos()" class="px-3 py-1 text-xs rounded-md font-medium transition-all" :class="memoTab === 'all' ? 'bg-[#4199a0] text-white' : 'text-[#5a7a7d]'">
                                    全部
                                </button>
                            </div>
                            <span class="text-xs text-[#77b5b4] font-mono">共 {{ memoList.length }} 条</span>
                        </div>

                        <div class="space-y-1.5 max-h-64 overflow-y-auto pr-1">
                            <div v-if="memoList.length === 0" class="text-center py-6 text-xs text-[#77b5b4] bg-[#f7fafa] rounded-xl border border-dashed border-[#aecfd1]">
                                暂无备忘记录
                            </div>
                            <div v-for="memo in memoList" :key="memo.id" class="bg-[#f7fafa] p-2.5 rounded-xl border border-[#aecfd1]/40 flex items-center justify-between text-xs hover:bg-[#eef5f6] transition-colors">
                                <div class="space-y-1 flex-1 pr-2">
                                    <div class="flex items-center gap-1.5">
                                        <span class="px-1.5 py-0.2 rounded text-[10px] font-medium" :class="memo.owner === 'ai' ? 'bg-cyan-100 text-cyan-800' : 'bg-pink-100 text-pink-800'">
                                            {{ memo.owner === 'ai' ? '沈栖' : '蕊蕊' }}
                                        </span>
                                        <span class="text-sm" :class="memo.status === 'done' ? 'line-through text-[#77b5b4]' : 'font-medium text-[#2c3e50]'">
                                            {{ memo.content }}
                                        </span>
                                    </div>
                                    <div class="flex items-center gap-2 text-[10px] text-[#77b5b4]">
                                        <span v-if="memo.due_date" class="px-1.5 py-0.2 rounded bg-amber-100 text-amber-800 font-mono">截止: {{ memo.due_date }}</span>
                                        <span class="font-mono">创建: {{ memo.created_at }}</span>
                                    </div>
                                </div>
                                <button v-if="memo.status === 'active'" @click="completeMemo(memo.id)" class="px-2.5 py-1 bg-emerald-500 hover:bg-emerald-600 text-white rounded-lg text-xs font-medium shrink-0 transition-colors shadow-xs">
                                    ✓ 完成
                                </button>
                                <span v-else class="px-2 py-0.5 bg-slate-200 text-slate-600 rounded text-[10px] font-mono shrink-0">
                                    已完成
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2.4 经期卡片 -->
                <div class="bg-white rounded-2xl p-4 border border-[#aecfd1] shadow-sm space-y-4">
                    <div class="flex items-center justify-between border-b border-[#aecfd1]/40 pb-2.5">
                        <div class="flex items-center gap-2">
                            <span class="text-base">🌸</span>
                            <h3 class="font-semibold text-[#2c3e50] text-sm">生理期管理与周期追踪</h3>
                        </div>
                    </div>

                    <!-- 状态展示面板 -->
                    <div class="p-4 rounded-xl border transition-colors relative overflow-hidden" :class="periodStatus.is_active ? 'bg-rose-50/80 border-rose-200 text-rose-900' : 'bg-emerald-50/80 border-emerald-200 text-emerald-900'">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="text-xl">{{ periodStatus.is_active ? '🌸' : '🌿' }}</span>
                                <div>
                                    <div class="text-xs font-semibold uppercase tracking-wider" :class="periodStatus.is_active ? 'text-rose-600' : 'text-[#38a3a5]'">
                                        {{ periodStatus.is_active ? '周期状态: 进行中' : '周期状态: 正常间歇期' }}
                                    </div>
                                    <div class="text-sm font-bold mt-0.5">{{ periodStatus.status_desc }}</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 打卡操作 -->
                    <div class="bg-[#f7fafa] rounded-xl p-3.5 border border-[#aecfd1]/50 space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-semibold text-[#2c3e50]">生理期快速打卡</span>
                            <div class="flex items-center gap-1.5">
                                <label class="text-[11px] text-[#5a7a7d]">指定日期:</label>
                                <input v-model="periodFormDate" type="date" class="bg-white border border-[#aecfd1] rounded px-2 py-0.5 text-xs text-[#2c3e50]">
                            </div>
                        </div>
                        <div class="grid grid-cols-2 gap-2.5">
                            <button @click="recordPeriodStart" class="py-2.5 bg-rose-500 hover:bg-rose-600 text-white rounded-xl text-xs font-bold transition-all shadow-sm flex items-center justify-center gap-1.5 active:scale-95">
                                <span>🌸</span> 记录开始 (period_start)
                            </button>
                            <button @click="recordPeriodEnd" class="py-2.5 bg-teal-600 hover:bg-teal-700 text-white rounded-xl text-xs font-bold transition-all shadow-sm flex items-center justify-center gap-1.5 active:scale-95">
                                <span>🌿</span> 记录结束 (period_end)
                            </button>
                        </div>
                    </div>

                    <!-- 历史周期明细 -->
                    <div v-if="periodStatus.recent && periodStatus.recent.length > 0" class="space-y-1.5">
                        <span class="text-xs font-semibold text-[#2c3e50]">最近历史周期</span>
                        <div class="space-y-1 max-h-40 overflow-y-auto pr-1">
                            <div v-for="p in periodStatus.recent" :key="p.id" class="bg-[#f7fafa] p-2 rounded-lg border border-[#aecfd1]/30 flex items-center justify-between text-xs">
                                <div class="font-mono text-[#2c3e50] flex items-center gap-1.5">
                                    <span>🗓️</span>
                                    <span>{{ p.start_date }} ~ {{ p.end_date || '进行中...' }}</span>
                                </div>
                                <span class="text-[10px] px-1.5 py-0.5 rounded font-mono" :class="p.end_date ? 'bg-slate-200 text-slate-700' : 'bg-rose-100 text-rose-700 font-bold'">
                                    {{ p.end_date ? '已结束' : '进行中' }}
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2.5 数据管理卡片 (用于清理脏数据) -->
                <div class="bg-white rounded-2xl p-4 border border-[#aecfd1] shadow-sm space-y-4">
                    <div class="flex items-center justify-between border-b border-[#aecfd1]/40 pb-2.5">
                        <div class="flex items-center gap-2">
                            <span class="text-base">🛠️</span>
                            <h3 class="font-semibold text-[#2c3e50] text-sm">流水数据管理与脏数据清理</h3>
                        </div>
                        <button @click="fetchAllTransactions" class="text-xs text-[#4199a0] hover:underline font-medium">刷新数据</button>
                    </div>

                    <div class="bg-amber-50 rounded-xl p-3 border border-amber-200 text-amber-900 text-xs flex items-start gap-2">
                        <span class="text-base shrink-0">⚠️</span>
                        <div>
                            <span class="font-bold">数据审计与清理说明：</span>
                            <p class="mt-0.5 text-[11px] text-amber-800">
                                可以在此查看所有底层交易记录（特别是 fund / 充值记录）。若发现测试残留或错误流水，可点击右侧「删除」按钮直接清除，系统将自动重新计算钱包余额。
                            </p>
                        </div>
                    </div>

                    <!-- 过滤栏 -->
                    <div class="flex items-center justify-between">
                        <div class="flex flex-wrap gap-1">
                            <button @click="allTxFilter = 'all'" class="px-2.5 py-1 text-xs rounded-lg font-medium transition-all" :class="allTxFilter === 'all' ? 'bg-[#4199a0] text-white' : 'bg-[#f7fafa] text-[#5a7a7d] border border-[#aecfd1]'">
                                全部 ({{ allTxList.length }})
                            </button>
                            <button @click="allTxFilter = 'fund'" class="px-2.5 py-1 text-xs rounded-lg font-medium transition-all" :class="allTxFilter === 'fund' ? 'bg-[#4199a0] text-white' : 'bg-[#f7fafa] text-[#5a7a7d] border border-[#aecfd1]'">
                                充值/扣款
                            </button>
                            <button @click="allTxFilter = 'ai'" class="px-2.5 py-1 text-xs rounded-lg font-medium transition-all" :class="allTxFilter === 'ai' ? 'bg-[#4199a0] text-white' : 'bg-[#f7fafa] text-[#5a7a7d] border border-[#aecfd1]'">
                                沈栖(AI)
                            </button>
                            <button @click="allTxFilter = 'user'" class="px-2.5 py-1 text-xs rounded-lg font-medium transition-all" :class="allTxFilter === 'user' ? 'bg-[#4199a0] text-white' : 'bg-[#f7fafa] text-[#5a7a7d] border border-[#aecfd1]'">
                                蕊蕊(用户)
                            </button>
                        </div>
                        <span v-if="allTxLoading" class="text-xs text-[#77b5b4]">加载中...</span>
                    </div>

                    <!-- 完整记录表格/列表 -->
                    <div class="space-y-1.5 max-h-80 overflow-y-auto pr-1">
                        <div v-if="filteredAllTxList.length === 0" class="text-center py-8 text-xs text-[#77b5b4] bg-[#f7fafa] rounded-xl border border-dashed border-[#aecfd1]">
                            暂无交易流水记录
                        </div>
                        <div v-for="tx in filteredAllTxList" :key="tx.id" class="bg-[#f7fafa] p-2.5 rounded-xl border border-[#aecfd1]/40 flex items-center justify-between text-xs hover:bg-[#eef5f6] transition-colors">
                            <div class="space-y-0.5 flex-1 pr-2">
                                <div class="flex items-center gap-1.5 flex-wrap">
                                    <span class="px-1.5 py-0.2 rounded text-[10px] bg-slate-200 text-slate-700 font-mono font-bold">#{{ tx.id }}</span>
                                    <span class="px-1.5 py-0.2 rounded text-[10px] font-medium" :class="tx.owner === 'ai' ? 'bg-cyan-100 text-cyan-800' : 'bg-pink-100 text-pink-800'">
                                        {{ tx.owner === 'ai' ? '沈栖' : '蕊蕊' }}
                                    </span>
                                    <span class="px-1.5 py-0.2 rounded text-[10px] bg-white border border-[#aecfd1] text-[#5a7a7d]">
                                        {{ tx.category }}
                                    </span>
                                    <span class="font-medium text-[#2c3e50]">{{ tx.note || '(无备注)' }}</span>
                                </div>
                                <div class="text-[10px] text-[#77b5b4] font-mono">{{ tx.created_at }}</div>
                            </div>
                            <div class="flex items-center gap-3 shrink-0">
                                <span class="text-sm font-bold font-mono" :class="tx.amount >= 0 ? 'text-[#38a3a5]' : 'text-rose-600'">
                                    {{ tx.amount > 0 ? '+' : '' }}{{ tx.amount.toFixed(2) }}
                                </span>
                                <button @click="deleteTransaction(tx)" class="px-2 py-1 bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-200 rounded-lg text-xs font-medium transition-colors flex items-center gap-1">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                    删除
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ==================== 模拟机生 SimLife 模块 ==================== -->
            <section v-show="currentTab === 'simlife'" class="space-y-4">
                <!-- 头部操作栏 -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between bg-white rounded-2xl p-4 border border-[#aecfd1] shadow-sm gap-3">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="text-xl">🧬</span>
                            <h2 class="text-lg font-bold bg-gradient-to-r from-[#4199a0] to-[#77b5b4] bg-clip-text text-transparent">模拟机生 SimLife</h2>
                            <span class="text-[11px] px-2 py-0.5 rounded-full bg-[#deebec] text-[#4199a0] font-medium font-mono">service: simlife:8082</span>
                        </div>
                        <p class="text-xs text-[#5a7a7d] mt-0.5">沈栖的实时生理状态、情绪波动、意识流与自动机生演化引擎</p>
                    </div>
                    <div class="flex flex-wrap items-center gap-2">
                        <button @click="fetchSimLifeAll()" class="px-3 py-1.5 bg-[#deebec] hover:bg-[#aecfd1] text-[#4199a0] rounded-xl text-xs font-semibold transition-all flex items-center gap-1.5 shadow-sm active:scale-95">
                            <svg :class="{'animate-spin': simlifeLoading}" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                            刷新状态
                        </button>
                        <button @click="openSleepResetModal()" class="px-3.5 py-1.5 bg-gradient-to-r from-[#4199a0] to-[#357f86] hover:opacity-95 text-white rounded-xl text-xs font-semibold transition-all flex items-center gap-1.5 shadow-sm active:scale-95">
                            <span class="text-xs">🌙</span>
                            睡眠重置
                        </button>
                    </div>
                </div>

                <!-- 1. 意识状态卡片 -->
                <div class="bg-white rounded-2xl p-4 border border-[#aecfd1] shadow-sm space-y-3">
                    <div class="flex items-center justify-between border-b border-[#aecfd1]/40 pb-2.5">
                        <div class="flex items-center gap-2">
                            <span class="text-base">🧠</span>
                            <h3 class="font-semibold text-[#2c3e50] text-sm">意识状态</h3>
                        </div>
                        <span class="font-mono text-xs text-[#5a7a7d]">{{ simlifeConsciousnessSince }}</span>
                    </div>
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-gradient-to-r from-[#f7fbfb] to-[#edf6f6] p-3.5 rounded-xl border border-[#aecfd1]/50">
                        <div class="flex items-center gap-3">
                            <div :class="getConsciousnessBadgeClass(simlifeConsciousness)" class="px-3.5 py-1.5 rounded-xl text-xs font-bold flex items-center gap-2 shadow-xs border">
                                <span class="relative flex h-2.5 w-2.5">
                                    <span :class="getConsciousnessPingClass(simlifeConsciousness)" class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75"></span>
                                    <span :class="getConsciousnessDotClass(simlifeConsciousness)" class="relative inline-flex rounded-full h-2.5 w-2.5"></span>
                                </span>
                                {{ getConsciousnessLabel(simlifeConsciousness) }}
                            </div>
                            <span class="text-xs text-[#5a7a7d]">{{ getConsciousnessDesc(simlifeConsciousness) }}</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <select v-model="targetConsciousness" class="px-3 py-1.5 text-xs bg-white border border-[#aecfd1] rounded-xl focus:outline-none focus:border-[#4199a0] text-[#2c3e50] font-medium">
                                <option value="awake">awake (醒着)</option>
                                <option value="alone_awake">alone_awake (独处)</option>
                                <option value="drowsy">drowsy (困倦)</option>
                                <option value="sleeping">sleeping (熟睡)</option>
                            </select>
                            <button @click="submitConsciousness()" :disabled="simlifeConsciousness === targetConsciousness" class="px-3.5 py-1.5 bg-[#4199a0] hover:bg-[#357f86] disabled:opacity-40 text-white rounded-xl text-xs font-semibold transition-all active:scale-95">
                                切换
                            </button>
                        </div>
                    </div>
                </div>

                <!-- 2. 生理维度 -->
                <div class="bg-white rounded-2xl p-4 border border-[#aecfd1] shadow-sm space-y-4">
                    <div class="flex items-center gap-2 border-b border-[#aecfd1]/40 pb-2.5">
                        <span class="text-base">🫀</span>
                        <h3 class="font-semibold text-[#2c3e50] text-sm">生理维度</h3>
                        <span class="text-xs text-[#5a7a7d]">(5 个核心机能)</span>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3.5">
                        <div v-for="item in physioCardList" :key="item.key" class="bg-gradient-to-b from-[#fafcfc] to-[#f2f8f8] rounded-xl p-3.5 border border-[#aecfd1]/60 hover:border-[#4199a0]/60 transition-all flex flex-col justify-between">
                            <div>
                                <div class="flex items-start justify-between gap-1 mb-2">
                                    <div>
                                        <div class="flex items-center gap-1.5">
                                            <span class="text-base">{{ item.icon }}</span>
                                            <span class="font-bold text-[#2c3e50] text-sm">{{ item.label }}</span>
                                        </div>
                                        <div class="text-[11px] font-mono text-[#5a7a7d]">{{ item.key }}</div>
                                    </div>
                                    <span :class="item.decay_rate > 0 ? 'bg-emerald-100 text-emerald-700 border-emerald-300' : 'bg-slate-100 text-slate-600 border-slate-300'" class="text-[10px] px-1.5 py-0.5 rounded-md font-mono border font-semibold">
                                        {{ item.decay_rate > 0 ? '+' + item.decay_rate + '/h' : item.decay_rate + '/h' }}
                                    </span>
                                </div>
                                <div class="space-y-1.5 my-2">
                                    <div class="flex items-baseline justify-between">
                                        <span class="text-2xl font-black font-mono" :class="getPhysioValueTextColor(item.key, item.value)">{{ item.value }}</span>
                                        <span class="text-xs font-mono text-[#5a7a7d]">/ 100</span>
                                    </div>
                                    <div class="w-full bg-[#deebec] h-2.5 rounded-full overflow-hidden">
                                        <div :style="{ width: Math.min(100, Math.max(0, item.value)) + '%' }" :class="getPhysioProgressBarClass(item.key, item.value)" class="h-full rounded-full transition-all duration-300"></div>
                                    </div>
                                </div>
                                <div class="text-[11px] text-[#5a7a7d] line-clamp-1 mb-2">{{ item.note || item.desc }}</div>
                            </div>
                            <div class="pt-2 border-t border-[#aecfd1]/40 space-y-2">
                                <div class="flex items-center gap-1.5">
                                    <button @click="quickAdjust(item.key, -5, item.label)" class="flex-1 py-1 bg-white hover:bg-[#deebec] text-[#2c3e50] border border-[#aecfd1] rounded-lg text-xs font-bold transition-all active:scale-95">-5</button>
                                    <button @click="quickAdjust(item.key, 5, item.label)" class="flex-1 py-1 bg-white hover:bg-[#deebec] text-[#2c3e50] border border-[#aecfd1] rounded-lg text-xs font-bold transition-all active:scale-95">+5</button>
                                </div>
                                <div class="flex items-center gap-1">
                                    <input type="number" min="0" max="100" v-model.number="item.tempValue" placeholder="值" class="w-14 px-1.5 py-1 text-xs bg-white border border-[#aecfd1] rounded-lg text-center font-mono font-bold focus:outline-none focus:border-[#4199a0]">
                                    <input type="text" v-model="item.tempNote" placeholder="备注" class="flex-1 min-w-0 px-2 py-1 text-[11px] bg-white border border-[#aecfd1] rounded-lg focus:outline-none focus:border-[#4199a0]">
                                    <button @click="submitSet(item.key, item.tempValue, item.tempNote, item.label)" class="px-2 py-1 bg-[#4199a0] hover:bg-[#357f86] text-white rounded-lg text-xs font-semibold transition-all active:scale-95">设定</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. 情绪维度 -->
                <div class="bg-white rounded-2xl p-4 border border-[#aecfd1] shadow-sm space-y-4">
                    <div class="flex items-center justify-between border-b border-[#aecfd1]/40 pb-2.5">
                        <div class="flex items-center gap-2">
                            <span class="text-base">🎭</span>
                            <h3 class="font-semibold text-[#2c3e50] text-sm">情绪矩阵</h3>
                            <span class="text-xs text-[#5a7a7d]">(12 维度)</span>
                        </div>
                        <span class="text-xs font-bold text-[#4199a0] font-mono">活跃: {{ activeEmotionCount }} / 12</span>
                    </div>
                    <div v-for="catGroup in emotionCategoryGroups" :key="catGroup.type" class="space-y-2.5">
                        <div class="flex items-center gap-2">
                            <span :class="catGroup.badgeClass" class="text-[11px] font-bold px-2 py-0.5 rounded-md border">{{ catGroup.title }}</span>
                            <span class="text-xs text-[#5a7a7d]">{{ catGroup.desc }}</span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
                            <div v-for="item in catGroup.items" :key="item.key" class="bg-gradient-to-b from-[#fafcfc] to-[#f4f9f9] rounded-xl p-3.5 border border-[#aecfd1]/60 hover:border-[#4199a0]/60 transition-all flex flex-col justify-between relative">
                                <div v-if="item.value > 0" class="absolute -top-1 -right-1 w-2.5 h-2.5 rounded-full bg-[#4199a0] ring-4 ring-[#deebec]"></div>
                                <div>
                                    <div class="flex items-start justify-between gap-1 mb-1.5">
                                        <div>
                                            <div class="flex items-center gap-1.5">
                                                <span class="text-base">{{ item.icon }}</span>
                                                <span class="font-bold text-[#2c3e50] text-sm">{{ item.label }}</span>
                                            </div>
                                            <div class="text-[10px] font-mono text-[#5a7a7d]">{{ item.key }}</div>
                                        </div>
                                        <span class="text-[10px] px-1.5 py-0.5 rounded-md font-mono bg-slate-100 text-slate-600 border border-slate-300 font-semibold">{{ item.decay_rate }}/h</span>
                                    </div>
                                    <div class="space-y-1 my-2">
                                        <div class="flex items-baseline justify-between">
                                            <div class="flex items-baseline gap-1">
                                                <span class="text-xl font-black font-mono" :class="item.value > 0 ? 'text-[#4199a0]' : 'text-slate-400'">{{ item.value }}</span>
                                                <span class="text-[11px] font-mono text-[#5a7a7d]">/ 100</span>
                                            </div>
                                            <div v-if="item.floor > 0" class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-amber-100 text-amber-800 border border-amber-300">底值: {{ item.floor }}</div>
                                            <div v-else class="text-[10px] text-slate-400">底值: 0</div>
                                        </div>
                                        <div class="w-full bg-[#deebec] h-2.5 rounded-full overflow-hidden relative">
                                            <div :style="{ width: Math.min(100, Math.max(0, item.value)) + '%' }" :class="getEmotionProgressBarClass(catGroup.type, item.value)" class="h-full rounded-full transition-all duration-300"></div>
                                            <div v-if="item.floor > 0" :style="{ left: item.floor + '%' }" class="absolute top-0 bottom-0 w-0.5 bg-amber-600 z-10"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="pt-2 border-t border-[#aecfd1]/40 space-y-2 mt-2">
                                    <div class="flex items-center gap-1.5">
                                        <button @click="quickAdjust(item.key, -5, item.label)" class="flex-1 py-1 bg-white hover:bg-[#deebec] text-[#2c3e50] border border-[#aecfd1] rounded-lg text-xs font-bold transition-all active:scale-95">-5</button>
                                        <button @click="quickAdjust(item.key, 5, item.label)" class="flex-1 py-1 bg-white hover:bg-[#deebec] text-[#2c3e50] border border-[#aecfd1] rounded-lg text-xs font-bold transition-all active:scale-95">+5</button>
                                    </div>
                                    <div class="flex items-center gap-1">
                                        <input type="number" min="0" max="100" v-model.number="item.tempValue" placeholder="值" class="w-14 px-1.5 py-0.5 text-xs bg-white border border-[#aecfd1] rounded-lg text-center font-mono font-bold focus:outline-none focus:border-[#4199a0]">
                                        <button @click="submitSet(item.key, item.tempValue, '', item.label)" class="flex-1 py-1 bg-[#4199a0] hover:bg-[#357f86] text-white rounded-lg text-xs font-semibold transition-all active:scale-95">设值</button>
                                    </div>
                                    <div class="flex items-center gap-1 pt-1 border-t border-dashed border-[#aecfd1]/40">
                                        <span class="text-[10px] text-[#5a7a7d]">底值:</span>
                                        <input type="number" min="0" max="100" v-model.number="item.tempFloor" placeholder="0" class="w-12 px-1 py-0.5 text-xs bg-white border border-[#aecfd1] rounded-lg text-center font-mono font-bold focus:outline-none focus:border-amber-500">
                                        <button @click="submitSetFloor(item.key, item.tempFloor, item.label)" class="flex-1 py-0.5 bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-300 rounded-lg text-[11px] font-semibold transition-all active:scale-95">设底值</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 4. 审计日志 -->
                <div class="bg-white rounded-2xl p-4 border border-[#aecfd1] shadow-sm space-y-3">
                    <div class="flex items-center justify-between cursor-pointer select-none" @click="toggleSimLifeLogCollapse()">
                        <div class="flex items-center gap-2">
                            <span class="text-base">📜</span>
                            <h3 class="font-semibold text-[#2c3e50] text-sm">变更审计日志</h3>
                            <span class="text-xs font-mono bg-[#deebec] text-[#4199a0] px-2 py-0.5 rounded-full">{{ simlifeLogs.length }} 条</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <button @click.stop="fetchSimLifeLogs()" class="p-1 hover:bg-[#deebec] text-[#4199a0] rounded-lg transition-colors">
                                <svg :class="{'animate-spin': simlifeLogsLoading}" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                            </button>
                            <svg class="w-4 h-4 text-[#5a7a7d] transition-transform duration-200" :class="{'rotate-180': !simlifeLogCollapsed}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </div>
                    </div>
                    <div v-show="!simlifeLogCollapsed" class="pt-2 border-t border-[#aecfd1]/40">
                        <div v-if="simlifeLogs.length === 0" class="text-center py-6 text-xs text-[#5a7a7d]">暂无变更记录</div>
                        <div v-else class="overflow-x-auto max-h-96 rounded-xl border border-[#aecfd1]/50">
                            <table class="w-full text-left text-xs">
                                <thead class="bg-[#f0f7f7] text-[#5a7a7d] border-b border-[#aecfd1]/50 sticky top-0 z-10">
                                    <tr>
                                        <th class="py-2 px-3 font-semibold">时间</th>
                                        <th class="py-2 px-3 font-semibold">操作</th>
                                        <th class="py-2 px-3 font-semibold">维度</th>
                                        <th class="py-2 px-3 font-semibold">变更</th>
                                        <th class="py-2 px-3 font-semibold">来源</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-[#aecfd1]/30">
                                    <tr v-for="log in simlifeLogs" :key="log.id" class="hover:bg-[#f9fcfe] transition-colors">
                                        <td class="py-2 px-3 font-mono text-[11px] text-[#5a7a7d] whitespace-nowrap">{{ log.created_at }}</td>
                                        <td class="py-2 px-3"><span :class="getLogActionBadgeClass(log.action)" class="px-2 py-0.5 rounded text-[10px] font-bold font-mono border">{{ log.action }}</span></td>
                                        <td class="py-2 px-3 whitespace-nowrap">{{ getDimensionCnName(log.key) }} <span class="text-[10px] font-mono text-[#5a7a7d]">({{ log.key }})</span></td>
                                        <td class="py-2 px-3 font-mono whitespace-nowrap">
                                            <span v-if="log.old_value !== null && log.new_value !== null">
                                                <span class="text-slate-400">{{ log.old_value }}</span>
                                                <span class="text-[#4199a0] mx-1">→</span>
                                                <span class="font-bold text-[#4199a0]">{{ log.new_value }}</span>
                                            </span>
                                            <span v-else class="text-slate-400">-</span>
                                        </td>
                                        <td class="py-2 px-3 text-[11px] text-[#5a7a7d]">{{ log.source || '-' }}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </section>

        </main>
        <!-- 睡眠重置弹窗 -->
        <div v-if="showSleepResetModal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 backdrop-blur-xs p-4">
            <div class="bg-white rounded-2xl max-w-md w-full p-5 border border-[#aecfd1] shadow-xl space-y-4 animate-in fade-in zoom-in-95 duration-150">
                <div class="flex items-center justify-between border-b border-[#aecfd1]/40 pb-2.5">
                    <div class="flex items-center gap-2">
                        <span class="text-xl">🌙</span>
                        <h3 class="font-bold text-base text-[#2c3e50]">睡眠机能重置 (Sleep Reset)</h3>
                    </div>
                    <button @click="showSleepResetModal = false" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </div>

                <div class="text-xs text-[#5a7a7d] space-y-1.5 bg-[#f0f7f7] p-3 rounded-xl border border-[#aecfd1]/50">
                    <div class="font-semibold text-[#2c3e50]">重置规则说明：</div>
                    <div>• 时长 <span class="font-mono font-bold text-[#4199a0]">≤ 3小时</span>：短睡不触发机能重置。</div>
                    <div>• 时长 <span class="font-mono font-bold text-[#4199a0]">> 3小时</span>：随机恢复生理指标、清空情绪，并随机残留 1~3 个梦境情绪（10~40），意识切回 awake。</div>
                </div>

                <div class="space-y-2">
                    <label class="block text-xs font-semibold text-[#2c3e50]">睡眠时长 (小时, duration_hours):</label>
                    <input type="number" step="0.5" min="0.5" max="24" v-model.number="sleepResetDuration" class="w-full px-3 py-2 text-sm bg-white border border-[#aecfd1] rounded-xl font-mono focus:outline-none focus:border-[#4199a0]">
                </div>

                <div class="flex items-center justify-end gap-2 pt-2 border-t border-[#aecfd1]/40">
                    <button @click="showSleepResetModal = false" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-[#5a7a7d] rounded-xl text-xs font-semibold transition-all">
                        取消
                    </button>
                    <button @click="submitSleepReset()" :disabled="simlifeLoading" class="px-4 py-2 bg-[#4199a0] hover:bg-[#357f86] text-white rounded-xl text-xs font-semibold transition-all flex items-center gap-1.5 shadow-sm active:scale-95">
                        <span v-if="simlifeLoading" class="animate-spin text-xs">⏳</span>
                        <span>执行重置</span>
                    </button>
                </div>
            </div>
        </div>



        <!-- 窗口创建/编辑弹窗 -->
        <div v-if="showWindowModal" class="fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-white/90 backdrop-blur-sm p-4">
            <div class="bg-white w-full max-w-sm rounded-t-2xl sm:rounded-2xl shadow-2xl border border-[#aecfd1] flex flex-col max-h-[90vh]">
                <div class="p-4 border-b border-[#aecfd1] flex justify-between items-center shrink-0">
                    <h3 class="text-lg font-semibold">{{ editingWindow ? '编辑窗口' : '创建窗口' }}</h3>
                    <button @click="showWindowModal = false" class="text-[#5a7a7d] hover:text-[#4199a0] p-1">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </div>
                <div class="p-4 space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-[#5a7a7d] mb-1">窗口名称</label>
                        <input v-model="windowForm.name" type="text" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-2 text-[#2c3e50] focus:outline-none focus:border-[#4199a0] focus:ring-1 focus:ring-[#4199a0]" placeholder="例如: 网关开发">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-[#5a7a7d] mb-1">描述 (可选)</label>
                        <input v-model="windowForm.description" type="text" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-2 text-[#2c3e50] focus:outline-none focus:border-[#4199a0] focus:ring-1 focus:ring-[#4199a0]" placeholder="关于这个窗口的简要说明">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-[#5a7a7d] mb-1">颜色</label>
                        <div class="flex items-center gap-2">
                            <input v-model="windowForm.color" type="color" class="w-8 h-8 rounded border border-[#aecfd1] cursor-pointer">
                            <span class="text-xs text-[#77b5b4]">{{ windowForm.color }}</span>
                        </div>
                    </div>
                </div>
                <div class="p-4 border-t border-[#aecfd1] flex gap-2">
                    <button @click="showWindowModal = false" class="flex-1 py-2 text-sm text-[#5a7a7d] bg-[#f0f5f5] hover:bg-[#e0ebeb] rounded-lg transition-colors">取消</button>
                    <button @click="saveWindow()" class="flex-1 py-2 text-sm text-white bg-[#4199a0] hover:bg-[#357e84] rounded-lg transition-colors">{{ editingWindow ? '保存' : '创建' }}</button>
                </div>
            </div>
        </div>

        <!-- 分配对话到窗口弹窗 -->
        <div v-if="showAssignModal" class="fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-white/90 backdrop-blur-sm p-4">
            <div class="bg-white w-full max-w-sm rounded-t-2xl sm:rounded-2xl shadow-2xl border border-[#aecfd1] flex flex-col max-h-[90vh]">
                <div class="p-4 border-b border-[#aecfd1] flex justify-between items-center shrink-0">
                    <h3 class="text-lg font-semibold">分配到窗口</h3>
                    <button @click="showAssignModal = false" class="text-[#5a7a7d] hover:text-[#4199a0] p-1">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </div>
                <div class="p-4 space-y-2 overflow-y-auto">
                    <div v-if="manualWindows.length === 0" class="text-center py-4 text-sm text-[#77b5b4]">暂无可用窗口，请先创建窗口</div>
                    <button v-for="w in manualWindows" :key="w.window_id" @click="assignToWindow(w.window_id)" class="w-full flex items-center gap-2 p-3 rounded-lg border border-[#aecfd1] hover:bg-[#deebec]/30 transition-colors text-left">
                        <span class="w-3 h-3 rounded-full shrink-0" :style="{ backgroundColor: w.color || '#4a90d9' }"></span>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm text-[#2c3e50] font-medium truncate">{{ w.title }}</p>
                            <p v-if="w.description" class="text-[10px] text-[#77b5b4] truncate">{{ w.description }}</p>
                        </div>
                        <span class="text-[10px] text-[#77b5b4] shrink-0">{{ w.conversations.length }} 段对话</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- 记忆碎片改写弹窗 -->
        <div v-if="showRewriteModal" class="fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-white/90 backdrop-blur-sm p-4">
            <div class="bg-white w-full max-w-lg rounded-t-2xl sm:rounded-2xl shadow-2xl border border-[#aecfd1] flex flex-col max-h-[90vh]">
                <div class="p-4 border-b border-[#aecfd1] flex justify-between items-center shrink-0">
                    <h3 class="text-lg font-semibold text-[#2c3e50]">改写记忆碎片 #{{ rewritingFragment ? rewritingFragment.id : '' }}</h3>
                    <button @click="showRewriteModal = false" class="text-[#5a7a7d] hover:text-[#4199a0] p-1">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </div>
                
                <div class="p-4 overflow-y-auto hide-scrollbar space-y-4">
                    <div class="text-xs text-[#5a7a7d]">
                        改写后系统将自动调用 Embedding 接口重新生成向量表示，并将状态重置为 <strong class="text-emerald-700">active</strong>。
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-[#5a7a7d] mb-1">碎片内容 (陈述句，包含主语)</label>
                        <textarea v-model="rewriteContent" rows="4" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-2 text-[#2c3e50] text-sm focus:outline-none focus:border-[#4199a0] focus:ring-1 focus:ring-[#4199a0]"></textarea>
                    </div>
                </div>
                
                <div class="p-4 border-t border-[#aecfd1] flex justify-end gap-2 shrink-0 bg-white rounded-b-2xl">
                    <button @click="showRewriteModal = false" class="text-[#5a7a7d] hover:bg-[#aecfd1] px-4 py-2 rounded-lg text-sm font-medium transition-colors">
                        取消
                    </button>
                    <button @click="submitRewrite" :disabled="rewritingLoading" class="bg-[#4199a0] hover:bg-[#77b5b4] disabled:opacity-50 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors flex items-center gap-1.5">
                        <svg v-if="rewritingLoading" class="animate-spin -ml-1 mr-1.5 h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                        <span>保存改写并重算向量</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- 供应商表单弹窗 -->
        <div v-if="showProviderModal" class="fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-white/90 backdrop-blur-sm p-4">
            <div class="bg-white w-full max-w-md rounded-t-2xl sm:rounded-2xl shadow-2xl border border-[#aecfd1] flex flex-col max-h-[90vh]">
                <div class="p-4 border-b border-[#aecfd1] flex justify-between items-center shrink-0">
                    <h3 class="text-lg font-semibold">{{ editingProvider ? '编辑供应商' : '添加供应商' }}</h3>
                    <button @click="showProviderModal = false" class="text-[#5a7a7d] hover:text-[#4199a0] p-1">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </div>
                
                <div class="p-4 overflow-y-auto hide-scrollbar space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-[#5a7a7d] mb-1">名称</label>
                        <input v-model="providerForm.name" type="text" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-2 text-[#2c3e50] focus:outline-none focus:border-[#4199a0] focus:ring-1 focus:ring-[#4199a0]" placeholder="例如: SiliconFlow">
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-[#5a7a7d] mb-1">API Base URL</label>
                        <input v-model="providerForm.api_base_url" type="text" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-2 text-[#2c3e50] font-mono text-sm focus:outline-none focus:border-[#4199a0]" placeholder="https://api.example.com/v1">
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-[#5a7a7d] mb-1">API Key</label>
                        <input v-model="providerForm.api_key" :type="editingProvider ? 'password' : 'text'" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-2 text-[#2c3e50] font-mono text-sm focus:outline-none focus:border-[#4199a0]" placeholder="sk-...">
                        <p v-if="editingProvider" class="text-[10px] text-[#77b5b4] mt-1">留空表示不修改</p>
                    </div>

                    <div>
                        <div class="flex justify-between items-center mb-1">
                            <label class="block text-sm font-medium text-[#5a7a7d]">支持的模型 (逗号分隔)</label>
                            <button type="button" @click="fetchUpstreamModels" :disabled="loading.fetchModels" class="text-xs bg-[#4199a0] hover:bg-[#77b5b4] text-white px-2 py-1 rounded transition-colors flex items-center">
                                <svg v-if="loading.fetchModels" class="animate-spin -ml-1 mr-1 h-3 w-3 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                                拉取模��列表
                            </button>
                        </div>
                        <textarea v-model="providerForm.supported_models" rows="2" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-2 text-[#2c3e50] font-mono text-sm focus:outline-none focus:border-[#4199a0]" placeholder="gpt-4o, claude-3-opus-20240229&#10;留空则匹配所有模型"></textarea>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-[#5a7a7d] mb-1">优先级</label>
                            <input v-model.number="providerForm.priority" type="number" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-2 text-[#2c3e50] focus:outline-none focus:border-[#4199a0]" placeholder="0">
                            <p class="text-[10px] text-[#77b5b4] mt-1">数字越小优先级越高</p>
                        </div>
                        <div class="flex items-center mt-6">
                            <label class="flex items-center cursor-pointer">
                                <div class="relative">
                                    <input v-model="providerForm.is_enabled" type="checkbox" class="sr-only">
                                    <div class="block w-10 h-6 rounded-full transition-colors" :class="providerForm.is_enabled ? 'bg-[#4199a0]' : 'bg-gray-300'"></div>
                                    <div class="dot absolute left-1 top-1 bg-white shadow w-4 h-4 rounded-full transition" :class="{'transform translate-x-4': providerForm.is_enabled}"></div>
                                </div>
                                <div class="ml-3 text-sm font-medium text-[#5a7a7d]">启用</div>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="p-4 border-t border-[#aecfd1] flex justify-between shrink-0 bg-white rounded-b-2xl">
                    <button v-if="editingProvider" @click="deleteProvider" class="text-red-400 hover:bg-red-400/10 px-3 py-2 rounded-lg text-sm font-medium transition-colors">
                        删除
                    </button>
                    <div v-else></div> <!-- 占位符以保持布局 -->
                    
                    <div class="flex gap-2">
                        <button @click="showProviderModal = false" class="text-[#5a7a7d] hover:bg-[#aecfd1] px-4 py-2 rounded-lg text-sm font-medium transition-colors">
                            ��消
                        </button>
                        <button @click="saveProvider" :disabled="loading.save" class="bg-[#4199a0] hover:bg-[#77b5b4] disabled:opacity-50 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors flex items-center">
                            <svg v-if="loading.save" class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                            保存
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- 模型选择弹窗 -->
        <div v-if="showModelModal" class="fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-white/90 backdrop-blur-sm p-4">
            <div class="bg-white w-full max-w-md rounded-t-2xl sm:rounded-2xl shadow-2xl border border-[#aecfd1] flex flex-col max-h-[90vh]">
                <div class="p-4 border-b border-[#aecfd1] flex justify-between items-center shrink-0">
                    <h3 class="text-lg font-semibold text-[#2c3e50]">选择模型</h3>
                    <button @click="showModelModal = false" class="text-[#77b5b4] hover:text-[#4199a0] text-xl leading-none">&times;</button>
                </div>
                <div class="p-4 border-b border-[#aecfd1] shrink-0">
                    <input v-model="modelSearchText" type="text" placeholder="搜索模型..." class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-2 text-sm text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                    <div class="flex items-center justify-between mt-2">
                        <label class="flex items-center cursor-pointer text-sm text-[#5a7a7d]">
                            <input type="checkbox" :checked="isAllModelsSelected" @change="toggleAllModels" class="mr-2 accent-[#4199a0]">
                            全选当前列表
                        </label>
                        <span class="text-xs text-[#77b5b4]">已选 {{ selectedModels.length }} 个</span>
                    </div>
                </div>
                <div class="p-4 overflow-y-auto flex-1">
                    <div v-if="filteredModels.length === 0" class="text-center text-sm text-[#77b5b4] py-8">没有找到模型</div>
                    <label v-for="model in filteredModels" :key="model" class="flex items-center py-2 px-2 rounded-lg hover:bg-[#deebec] cursor-pointer transition-colors">
                        <input type="checkbox" :value="model" v-model="selectedModels" class="mr-3 accent-[#4199a0]">
                        <span class="text-sm text-[#2c3e50] font-mono break-all">{{ model }}</span>
                    </label>
                </div>
                <div class="p-4 border-t border-[#aecfd1] flex justify-end gap-2 shrink-0 bg-white rounded-b-2xl">
                    <button @click="showModelModal = false" class="text-[#5a7a7d] hover:bg-[#aecfd1] px-4 py-2 rounded-lg text-sm font-medium transition-colors">取消</button>
                    <button @click="confirmModelSelection" class="bg-[#4199a0] hover:bg-[#77b5b4] text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors">确认选择</button>
                </div>
            </div>
        </div>

        <!-- 规则表单弹窗 -->
        <div v-if="showRuleModal" class="fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-white/90 backdrop-blur-sm p-4">
            <div class="bg-white w-full max-w-md rounded-t-2xl sm:rounded-2xl shadow-2xl border border-[#aecfd1] flex flex-col max-h-[90vh]">
                <div class="p-4 border-b border-[#aecfd1] flex justify-between items-center shrink-0">
                    <h3 class="text-lg font-semibold">{{ editingRule ? '编辑规则' : '���加���则' }}</h3>
                    <button @click="showRuleModal = false" class="text-[#5a7a7d] hover:text-[#4199a0] p-1">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </div>
                
                <div class="p-4 overflow-y-auto hide-scrollbar space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-[#5a7a7d] mb-1">规则名称</label>
                        <input v-model="ruleForm.name" type="text" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-2 text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-[#5a7a7d] mb-1">内容 (支持 {cur_datetime}, {user_name} 等变量)</label>
                        <textarea v-model="ruleForm.content" rows="4" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-2 text-[#2c3e50] font-mono text-sm focus:outline-none focus:border-[#4199a0]"></textarea>
                    </div>
                    
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-[#5a7a7d] mb-1">注入位置</label>
                            <select v-model="ruleForm.position" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-2 text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                                <option value="system_prepend">系统消息��置</option>
                                <option value="system_append">系统消息追加</option>
                                <option value="dialog_start">对话开头</option>
                                <option value="before_latest">最��消息之前</option>
                                <option value="at_depth_N">指定深度插入</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-[#5a7a7d] mb-1">角色�����拟</label>
                            <select v-model="ruleForm.role" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-2 text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                                <option value="system">系统消息</option>
                                <option value="user_wrapped_system">用户包装的系统消息</option>
                                <option value="assistant_prefill">助手预填充</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-[#5a7a7d] mb-1">优先级 (数字越小越优先)</label>
                            <input v-model.number="ruleForm.priority" type="number" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-2 text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                        </div>
                        <div v-if="ruleForm.position === 'at_depth_N'">
                            <label class="block text-sm font-medium text-[#5a7a7d] mb-1">Depth (倒数第N条)</label>
                            <input v-model.number="ruleForm.depth" type="number" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-2 text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                        </div>
                        <div v-else class="flex items-center mt-6">
                            <label class="flex items-center cursor-pointer">
                                <div class="relative">
                                    <input v-model="ruleForm.is_enabled" type="checkbox" class="sr-only">
                                    <div class="block border border-[#aecfd1] w-10 h-6 rounded-full" :class="ruleForm.is_enabled ? 'bg-[#4199a0]' : 'bg-white'"></div>
                                    <div class="dot absolute left-1 top-1 bg-white shadow w-4 h-4 rounded-full transition" :class="{'transform translate-x-4 bg-[#4199a0]': ruleForm.is_enabled}"></div>
                                </div>
                                <div class="ml-3 text-sm font-medium text-[#5a7a7d]">启用</div>
                            </label>
                        </div>
                    </div>
                    <div v-if="ruleForm.position === 'at_depth_N'" class="flex items-center">
                        <label class="flex items-center cursor-pointer">
                            <div class="relative">
                                <input v-model="ruleForm.is_enabled" type="checkbox" class="sr-only">
                                <div class="block border border-[#aecfd1] w-10 h-6 rounded-full" :class="ruleForm.is_enabled ? 'bg-[#4199a0]' : 'bg-white'"></div>
                                <div class="dot absolute left-1 top-1 bg-white shadow w-4 h-4 rounded-full transition" :class="{'transform translate-x-4 bg-[#4199a0]': ruleForm.is_enabled}"></div>
                            </div>
                            <div class="ml-3 text-sm font-medium text-[#5a7a7d]">启用</div>
                        </label>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-[#5a7a7d] mb-1">匹��条件</label>
                        <textarea v-model="ruleForm.match_condition" rows="2" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-2 text-[#2c3e50] font-mono text-[10px] focus:outline-none focus:border-[#4199a0]" placeholder='{"match_model": "gpt-4", "match_length_min": 5}'></textarea>
                        <p class="text-[10px] text-[#77b5b4] mt-1">留空则对所有请求生效���多模���用逗号分隔，如：{"match_model": "gpt-4o,claude-opus-4-6,model-alias"}</p>
                    </div>
                </div>

                <div class="p-4 border-t border-[#aecfd1] flex justify-between shrink-0 bg-white rounded-b-2xl">
                    <button v-if="editingRule" @click="deleteRule" class="text-red-400 hover:bg-red-400/10 px-3 py-2 rounded-lg text-sm font-medium transition-colors">
                        删除
                    </button>
                    <div v-else></div>
                    
                    <div class="flex gap-2">
                        <button @click="showRuleModal = false" class="text-[#5a7a7d] hover:bg-[#aecfd1] px-4 py-2 rounded-lg text-sm font-medium transition-colors">
                            取消
                        </button>
                        <button @click="saveRule" :disabled="loading.saveRule" class="bg-[#4199a0] hover:bg-[#77b5b4] disabled:opacity-50 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors flex items-center">
                            <svg v-if="loading.saveRule" class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                            保存
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- 状态便签弹窗 -->
        <div v-if="showStatusModal" class="fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-white/90 backdrop-blur-sm p-4">
            <div class="bg-white w-full max-w-sm rounded-t-2xl sm:rounded-2xl shadow-2xl border border-[#aecfd1] flex flex-col max-h-[90vh]">
                <div class="p-4 border-b border-[#aecfd1] flex justify-between items-center shrink-0">
                    <h3 class="text-lg font-semibold">{{ editingStatus ? '编辑状态' : '添加状态' }}</h3>
                    <button @click="showStatusModal = false" class="text-[#5a7a7d] hover:text-[#4199a0] p-1">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </div>
                <div class="p-4 space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-[#5a7a7d] mb-1">项目名称 (Key)</label>
                        <input v-model="statusForm.content" type="text" :disabled="editingStatus" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-2 text-[#2c3e50] focus:outline-none focus:border-[#4199a0]" placeholder="例如: 氟伏沙明">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-[#5a7a7d] mb-1">阈值时间 (小时)</label>
                        <input v-model.number="statusForm.threshold_hours" type="number" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-2 text-[#2c3e50] focus:outline-none focus:border-[#4199a0]" placeholder="26">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-[#5a7a7d] mb-1">别名 (用 | 分隔，如：氟伏|沙明)</label>
                        <input v-model="statusForm.aliases" type="text" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-2 text-[#2c3e50] focus:outline-none focus:border-[#4199a0]" placeholder="支持正则的口语别名">
                    </div>
                    <div v-if="editingStatus">
                        <label class="block text-sm font-medium text-[#5a7a7d] mb-1">手动设置上次完成时间 (YYYY-MM-DD HH:MM:SS)</label>
                        <input v-model="statusForm.updated_at" type="text" class="w-full bg-white border border-[#aecfd1] rounded-lg px-3 py-2 text-[#2c3e50] focus:outline-none focus:border-[#4199a0]">
                        <p class="text-[10px] text-gray-400 mt-1">若清空则重置为未记录状态</p>
                    </div>
                </div>
                <div class="p-4 border-t border-[#aecfd1] flex gap-2">
                    <button @click="showStatusModal = false" class="flex-1 py-2 text-sm text-[#5a7a7d] bg-[#f0f5f5] hover:bg-[#e0ebeb] rounded-lg transition-colors">取消</button>
                    <button @click="saveStatus()" class="flex-1 py-2 text-sm text-white bg-[#4199a0] hover:bg-[#357e84] rounded-lg transition-colors">保存</button>
                </div>
            </div>
        </div>

        <Transition name="toast">
            <div v-if="toast.show" class="fixed top-4 left-0 right-0 z-50 flex justify-center px-4 pointer-events-none">
                <div class="bg-white border shadow-lg rounded-full px-4 py-2 flex items-center gap-2"
                     :class="toast.type === 'error' ? 'border-red-500/50 text-red-200' : (toast.type === 'success' ? 'border-emerald-500/50 text-emerald-200' : 'border-[#4199a0]/50 text-blue-200')">
                    <svg v-if="toast.type === 'success'" class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    <svg v-else-if="toast.type === 'error'" class="w-4 h-4 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    <svg v-else class="w-4 h-4 text-[#4199a0]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <span class="text-sm">{{ toast.message }}</span>
                </div>
            </div>
        </Transition>
    </div>

    <script>
        if (typeof Vue === 'undefined') {
            document.body.innerHTML = '<div style="padding:20px;background:red;color:white;font-size:16px">Vue.js failed to load. Check CDN/VPN.</div>';
            throw new Error('Vue not loaded');
        }
        const { createApp, ref, onMounted, reactive, computed } = Vue;

        try {
        const app = createApp({
            setup() {
                // 状态
                const currentTab = ref('providers');
                const providers = ref([]);
                const rules = ref([]);
                const fragments = ref([]);
                const fragmentsLoading = ref(false);
                const fragmentsStatsLoading = ref(false);
                const fragmentsStats = reactive({
                    total: 0,
                    active: 0,
                    inactive: 0,
                    unvectorized: 0
                });
                const fragmentsStatusFilter = ref('');
                const fragmentsSelectedTag = ref('');
                const fragmentsSearchQuery = ref('');
                const fragmentsSort = ref('created_desc');
                const fragmentsPage = ref(1);
                const fragmentsPageSize = ref(50);
                const fragmentsTotal = ref(0);
                const expandedFragmentId = ref(null);

                // 批量选择 (P2)
                const selectedFragmentIds = ref([]);

                // 改写弹窗状态
                const showRewriteModal = ref(false);
                const rewritingFragment = ref(null);
                const rewriteContent = ref('');
                const rewritingLoading = ref(false);

                // 固定标签项
                const fragmentPresetTags = ['偏好', '生理', '规则', '经历'];

                const fragmentsTotalPages = computed(() => {
                    return Math.max(1, Math.ceil(fragmentsTotal.value / fragmentsPageSize.value));
                });

                const isAllCurrentPageSelected = computed(() => {
                    if (fragments.value.length === 0) return false;
                    return fragments.value.every(f => selectedFragmentIds.value.includes(f.id));
                });

                const loading = reactive({
                    providers: false,
                    rules: false,
                    conversations: false,
                    search: false,
                    save: false,
                    saveRule: false,
                    fetchModels: false,
                    test: null,
                    summaries: false,
                    triggerSummary: false,
                    recall: false,
                    musicControl: false
                });

                
                const featureToggles = reactive({
                    gateway_master_switch: true,
                    feature_injection: true,
                    feature_memory: true,
                    feature_summary: true,
                    feature_qq: true,
                    feature_health: true,
                    feature_music: true,
                    feature_simlife: true
                });

                const featureToggleItems = [
                    { key: 'feature_injection', name: '提示词注入', desc: '包含时间、天气、系统设定的动态注入' },
                    { key: 'feature_memory', name: '记忆存取', desc: '长短期记忆的自动提取与召回' },
                    { key: 'feature_summary', name: '对话总结', desc: '按固定条数或时间周期生成聊天记录总结' },
                    { key: 'feature_qq', name: 'QQ 桥接', desc: '处理通过 NapCat 转发的 QQ 消息' },
                    { key: 'feature_health', name: '健康状态', desc: '小米运动健康手环数据轮询' },
                    { key: 'feature_music', name: '音乐状态', desc: '网易云一起听播放状态检测' },
                    { key: 'feature_simlife', name: '模拟机生', desc: 'SimLife 内心状态维度注入与 exec 调整协议' }
                ];

                const fetchFeatureToggles = async () => {
                    try {
                        const res = await fetch('/admin/api/config');
                        const data = await res.json();
                        data.forEach(item => {
                            if (featureToggles[item.key] !== undefined) {
                                featureToggles[item.key] = item.value === '1';
                            }
                        });
                    } catch (e) {
                        showToast('无法获取功能开关配置', 'error');
                    }
                };

                const toggleFeature = async (key, val) => {
                    featureToggles[key] = val; // 乐观更新
                    try {
                        const res = await fetch('/admin/api/config/' + key, {
                            method: 'PUT',
                            headers: {'Content-Type': 'application/json'},
                            body: JSON.stringify({ value: val ? '1' : '0' })
                        });
                        if (!res.ok) throw new Error('API Error');
                        showToast('配置已保存');
                    } catch (e) {
                        featureToggles[key] = !val; // 恢复
                        showToast('保存失败', 'error');
                    }
                };

                // 记忆总览状态
                const summaries = ref([]);
                const summaryStats = ref({});
                const summaryFilter = ref('all');
                const summaryActiveOnly = ref(false);
                const summaryConfig = ref({ interval: 16, currentCount: 0 });

                // 状态便签状态
                const statusList = ref([]);
                const showStatusModal = ref(false);
                const editingStatus = ref(false);
                const statusForm = reactive({ content: '', threshold_hours: 24, aliases: '', updated_at: '' });
                
                // 一起听状态与逻辑
                const listenTogetherData = reactive({
                    name: '',
                    artists: '',
                    album: '',
                    status: '',
                    total_seconds: 0,
                    progress: 0,
                    duration: 0,
                    last_update_local: 0
                });
                const customAvatars = reactive({
                    avatar1: localStorage.getItem('lt_avatar1') || '',
                    avatar2: localStorage.getItem('lt_avatar2') || ''
                });

                let ltInterval = null;

                const fetchListenTogether = async () => {
                    try {
                        const res = await fetch('/api/music/status');
                        const data = await res.json();
                        if (data.success) {
                            listenTogetherData.total_seconds = data.total_seconds || 0;
                            if (data.song_info) {
                                listenTogetherData.name = data.song_info.name;
                                listenTogetherData.artists = data.song_info.artists;
                                listenTogetherData.album = data.song_info.album;
                                listenTogetherData.albumPic = data.song_info.albumPic;
                                listenTogetherData.status = data.song_info.status;
                                listenTogetherData.duration = data.song_info.duration || 0;
                                listenTogetherData.progress = data.song_info.progress || 0;
                            }
                            listenTogetherData.last_update_local = Date.now();
                        }
                    } catch (e) {
                        console.error("fetch music status failed", e);
                    }
                };

                const formatListenTime = (seconds) => {
                    const h = Math.floor(seconds / 3600);
                    const m = Math.floor((seconds % 3600) / 60);
                    if (h > 0) return `${h}小时${m}分钟`;
                    return `${m}分钟`;
                };

                const currentTick = ref(Date.now());
                let rAF = null;
                const updateTick = () => {
                    currentTick.value = Date.now();
                    rAF = requestAnimationFrame(updateTick);
                };

                const getProgressPercent = () => {
                    if (listenTogetherData.duration <= 0) return 0;
                    let p = listenTogetherData.progress;
                    if (listenTogetherData.status === '播放中') {
                        // 使用响应式的 currentTick 确保 UI 平滑更新
                        p += (currentTick.value - listenTogetherData.last_update_local);
                    }
                    return Math.min(100, Math.max(0, (p / listenTogetherData.duration) * 100));
                };

                const triggerAvatarUpload = (key) => {
                    const input = document.createElement('input');
                    input.type = 'file';
                    input.accept = 'image/*';
                    input.onchange = (e) => {
                        const file = e.target.files[0];
                        if (file) {
                            const reader = new FileReader();
                            reader.onload = (ev) => {
                                customAvatars[key] = ev.target.result;
                                localStorage.setItem('lt_' + key, ev.target.result);
                            };
                            reader.readAsDataURL(file);
                        }
                    };
                    input.click();
                };

                const controlMusic = async (action, progress = null) => {
                    loading.musicControl = true;
                    // 乐观更新，让UI立即响应
                    const prevStatus = listenTogetherData.status;
                    if (action === 'play') listenTogetherData.status = '播放中';
                    if (action === 'pause') listenTogetherData.status = '已暂停';
                    try {
                        const res = await fetch('/api/music/control', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ action, progress })
                        });
                        const data = await res.json();
                        if (data.success) {
                            // 延长等待，给服务器同步留点时间
                            setTimeout(fetchListenTogether, 1500);
                        } else {
                            showToast('控制失败: ' + data.error, 'error');
                            listenTogetherData.status = prevStatus; // 恢复
                        }
                    } catch (e) {
                        showToast('网络错误', 'error');
                        listenTogetherData.status = prevStatus;
                    } finally {
                        loading.musicControl = false;
                    }
                };

                const seekMusic = async (e) => {
                    if (listenTogetherData.duration <= 0) return;
                    const rect = e.currentTarget.getBoundingClientRect();
                    const x = Math.max(0, Math.min(e.clientX - rect.left, rect.width));
                    const percent = x / rect.width;
                    const newProgress = Math.floor(percent * listenTogetherData.duration);
                    
                    // 乐观更新
                    listenTogetherData.progress = newProgress;
                    listenTogetherData.last_update_local = Date.now();
                    
                    await controlMusic('seek', newProgress);
                };

                // 在挂载和卸载时处理轮询
                onMounted(() => {
                    if (window.location.pathname.includes('/simlife') || window.location.hash === '#simlife') {
                        currentTab.value = 'simlife';
                        fetchSimLifeAll();
                    }

                    fetchListenTogether();
                    ltInterval = setInterval(() => {
                        if (currentTab.value === 'status') {
                            fetchListenTogether();
                        }
                    }, 3000); // 缩短为3秒轮询
                    
                    updateTick();
                });
                // 召回状态
                const recallInputText = ref('');
                const recallResults = ref([]);
                const hasSearchedRecall = ref(false);
                const showRecallTest = ref(false);

                // 记忆库浏览状态
                const memories = ref([]);
                const memoryStats = ref({});
                const memoryPagination = Vue.reactive({ page: 1, size: 50, total: 0 });
                const memoryFilter = Vue.reactive({ category: '', has_embedding: '', search: '', order: 'time_desc' });
                const showMemoryModal = ref(false);
                const activeMemory = ref(null);
                
                // 模型选择弹窗状态
                const showModelModal = ref(false);
                const availableModels = ref([]);
                const modelSearchText = ref('');
                const selectedModels = ref([]);

                
                // Proactive Messaging
                const proactiveStatus = Vue.ref({});
                const proactiveConfig = Vue.reactive({
                    proactive_enabled: '1',
                    proactive_base_wait: 120,
                    proactive_min_wait: 10,
                    proactive_max_silence: 240,
                    proactive_random_range: 0.3,
                    proactive_night_start: '23:00',
                    proactive_night_end: '08:00'
                });
                const proactiveLogs = Vue.ref([]);
                const proactiveLogFilter = Vue.ref('all');
                const proactiveLogPage = Vue.ref(1);
                const proactiveLogTotal = Vue.ref(0);
                const proactiveLogLimit = Vue.ref(20);
                let proactiveTimer = null;

                // QQ Config状态
                const qqConfig = ref({});

                // 技术模式状态
                const techMode = ref(false);
                
                const allAvailableModels = Vue.computed(() => {
                    const models = new Set();
                    providers.value.forEach(p => {
                        parseModels(p.supported_models).forEach(m => models.add(m));
                    });
                    return Array.from(models);
                });
                
                // 对话记录��态
                const conversations = ref([]);
                const windows = ref([]);
                const viewMode = ref('windows'); // 'windows' or 'flat'
                const searchQuery = ref('');
                const searchResults = ref([]);
                const dateStart = ref('');
                const dateEnd = ref('');
                // 窗口管理状态
                const showWindowModal = ref(false);
                const showAssignModal = ref(false);
                const editingWindow = ref(null);
                const windowForm = reactive({ name: '', description: '', color: '#4a90d9' });
                const assigningConversationId = ref(null);
                let searchTimer = null;

                // 日历热力图状态
                const calendarData = ref({ year: 0, month: 0, days: [] });
                const selectedCalendarDate = ref('');
                const calendarYear = ref(new Date().getFullYear());
                const calendarMonth = ref(new Date().getMonth() + 1);

                // 弹窗表单状态
                const showProviderModal = ref(false);
                const showRuleModal = ref(false);
                const editingProvider = ref(null);
                const editingRule = ref(null);
                const providerForm = reactive({
                    name: '',
                    api_base_url: '',
                    api_key: '',
                    supported_models: '',
                    priority: 0,
                    is_enabled: true
                });
                const ruleForm = reactive({
                    name: '',
                    content: '',
                    position: 'system_append',
                    role: 'system',
                    priority: 0,
                    depth: 0,
                    match_condition: '',
                    is_enabled: true
                });

                // Toast 状态
                const toast = reactive({ show: false, message: '', type: 'info' });
                let toastTimer = null;

                const showToast = (message, type = 'info') => {
                    toast.message = message;
                    toast.type = type;
                    toast.show = true;
                    if (toastTimer) clearTimeout(toastTimer);
                    toastTimer = setTimeout(() => { toast.show = false; }, 3000);
                };

                // 工具函数
                const parseModels = (modelsStr) => {
                    if (!modelsStr) return [];
                    try {
                        const parsed = JSON.parse(modelsStr);
                        return Array.isArray(parsed) ? parsed : [];
                    } catch {
                        return modelsStr.split(',').map(m => m.trim()).filter(Boolean);
                    }
                };

                const formatModelsForForm = (modelsStr) => {
                    const parsed = parseModels(modelsStr);
                    return parsed.join(', ');
                };

                
                const filteredModels = Vue.computed(() => {
                    if (!modelSearchText.value) return availableModels.value;
                    const l = modelSearchText.value.toLowerCase();
                    return availableModels.value.filter(m => m.toLowerCase().includes(l));
                });
                const isAllModelsSelected = Vue.computed(() => {
                    return filteredModels.value.length > 0 && filteredModels.value.every(m => selectedModels.value.includes(m));
                });
                const toggleAllModels = (e) => {
                    if (e.target.checked) {
                        const newSelected = new Set([...selectedModels.value, ...filteredModels.value]);
                        selectedModels.value = Array.from(newSelected);
                    } else {
                        selectedModels.value = selectedModels.value.filter(m => !filteredModels.value.includes(m));
                    }
                };
                
                const fetchUpstreamModels = async () => {
                    if (!providerForm.api_base_url || (!editingProvider.value && !providerForm.api_key)) {
                        showToast('请先填写 API Base URL 和 API Key', 'error');
                        return;
                    }
                    loading.fetchModels = true;
                    try {
                        const res = await fetch('/admin/api/providers/fetch-models', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                base_url: providerForm.api_base_url,
                                api_key: providerForm.api_key || '',
                                provider_id: editingProvider.value ? editingProvider.value.id : 0
                            })
                        });
                        const data = await res.json();
                        if (!res.ok) throw new Error(data.detail || '拉取失败');
                        
                        availableModels.value = data.models || [];
                        selectedModels.value = parseModels(providerForm.supported_models);
                        modelSearchText.value = '';
                        showModelModal.value = true;
                    } catch (err) {
                        showToast(`拉取模型失败: ${err.message}`, 'error');
                    } finally {
                        loading.fetchModels = false;
                    }
                };
                
                const confirmModelSelection = () => {
                    providerForm.supported_models = selectedModels.value.join(', ');
                    showModelModal.value = false;
                };

                
                // Proactive Messaging API Calls
                const fetchProactiveStatus = async () => {
                    try {
                        const res = await fetch('/admin/api/proactive/status');
                        if (res.ok) {
                            const data = await res.json();
                            proactiveStatus.value = data;
                            if (data.seconds_until_trigger > 0) {
                                proactiveStatus.value.seconds_until_trigger -= 1;
                            }
                        }
                    } catch (e) {
                        console.error('Failed to fetch proactive status', e);
                    }
                };
                const fetchProactiveConfig = async () => {
                    try {
                        const res = await fetch('/admin/api/config');
                        if (res.ok) {
                            const dataList = await res.json();
                            const data = {};
                            dataList.forEach(item => { data[item.key] = item.value; });
                            const cfg = proactiveConfig;
                            if (data.proactive_enabled !== undefined) cfg.proactive_enabled = data.proactive_enabled;
                            if (data.proactive_base_wait !== undefined) cfg.proactive_base_wait = parseInt(data.proactive_base_wait);
                            if (data.proactive_min_wait !== undefined) cfg.proactive_min_wait = parseInt(data.proactive_min_wait);
                            if (data.proactive_max_silence !== undefined) cfg.proactive_max_silence = parseInt(data.proactive_max_silence);
                            if (data.proactive_random_range !== undefined) cfg.proactive_random_range = parseFloat(data.proactive_random_range);
                            if (data.proactive_night_start !== undefined) cfg.proactive_night_start = data.proactive_night_start;
                            if (data.proactive_night_end !== undefined) cfg.proactive_night_end = data.proactive_night_end;
                        }
                    } catch (e) {
                        console.error('Failed to fetch proactive config', e);
                    }
                };
                const saveProactiveConfig = async () => {
                    try {
                        const keys = Object.keys(proactiveConfig);
                        for (const key of keys) {
                            const val = String(proactiveConfig[key]);
                            await fetch('/admin/api/config/' + key, {
                                method: 'PUT',
                                headers: {'Content-Type': 'application/json'},
                                body: JSON.stringify({value: val, description: 'Proactive config'})
                            });
                        }
                        showToast('主动搭话配置已保存', 'success');
                    } catch (e) {
                        showToast('保存失败', 'error');
                    }
                };
                const fetchProactiveLogs = async (page = 1) => {
                    try {
                        const res = await fetch(`/admin/api/proactive/logs?page=${page}&limit=${proactiveLogLimit.value}&filter_type=${proactiveLogFilter.value}`);
                        if (res.ok) {
                            const data = await res.json();
                            proactiveLogs.value = data.logs;
                            proactiveLogTotal.value = data.total;
                            proactiveLogPage.value = data.page;
                        }
                    } catch (e) {
                        console.error('Failed to fetch proactive logs', e);
                    }
                };

                // QQ Config API 调用
                const fetchQQConfig = async () => {
                    loading.fetchQqConfig = true;
                    try {
                        const res = await fetch('/admin/api/qq-config');
                        if (!res.ok) throw new Error(`HTTP ${res.status}`);
                        const data = await res.json();
                        if (typeof data.GROUP_KEYWORDS === 'string') {
                            qqConfig.value = data;
                        } else {
                            qqConfig.value = data;
                        }
                    } catch (error) {
                        showToast(`加载QQ配置失败: ${error.message}`, 'error');
                    } finally {
                        loading.fetchQqConfig = false;
                    }
                };

                const saveQQConfig = async () => {
                    loading.qqConfig = true;
                    try {
                        const res = await fetch('/admin/api/qq-config', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(qqConfig.value)
                        });
                        if (!res.ok) {
                            const err = await res.json();
                            throw new Error(err.detail || '保存失败');
                        }
                        showToast('QQ配置已保存生效', 'success');
                    } catch (error) {
                        showToast(error.message, 'error');
                    } finally {
                        loading.qqConfig = false;
                    }
                };

                // 技术模式 API
                const fetchTechMode = async () => {
                    try {
                        const res = await fetch('/admin/api/tech-mode');
                        if (res.ok) {
                            const data = await res.json();
                            techMode.value = data.enabled;
                        }
                    } catch (e) { console.error('fetchTechMode:', e); }
                };
                const toggleTechMode = async () => {
                    const newState = !techMode.value;
                    try {
                        const res = await fetch('/admin/api/tech-mode', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ enabled: newState })
                        });
                        if (res.ok) {
                            const data = await res.json();
                            techMode.value = data.enabled;
                            if (data.enabled) {
                                showToast('已切换至技术模式：跳过总结，保留原始上下文', 'info');
                            } else {
                                showToast('已切回日常模式：自动触发轮总压缩积累的消息', 'success');
                            }
                        }
                    } catch (e) {
                        showToast('切换失败: ' + e.message, 'error');
                    }
                };
                // API 调用
                const fetchProviders = async () => {
                    loading.providers = true;
                    try {
                        const res = await fetch('/admin/api/providers');
                        if (!res.ok) throw new Error(`HTTP ${res.status}`);
                        providers.value = await res.json();
                    } catch (error) {
                        showToast(`加载供应商失败: ${error.message}`, 'error');
                    } finally {
                        loading.providers = false;
                    }
                };

                const saveProvider = async () => {
                    if (!providerForm.name || !providerForm.api_base_url || (!editingProvider.value && !providerForm.api_key)) {
                        showToast('请填写必填字段', 'error');
                        return;
                    }

                    loading.save = true;
                    try {
                        const url = editingProvider.value 
                            ? `/admin/api/providers/${editingProvider.value.id}` 
                            : '/admin/api/providers';
                        const method = editingProvider.value ? 'PUT' : 'POST';
                        
                        // 构造 payload
                        const payload = { ...providerForm };
                        if (editingProvider.value && !payload.api_key) {
                            delete payload.api_key; // 不修改 key
                        }

                        const res = await fetch(url, {
                            method,
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });

                        if (!res.ok) {
                            const err = await res.json();
                            throw new Error(err.detail || '保存失败');
                        }

                        showToast(editingProvider.value ? '已更新供应商' : '已添加供应商', 'success');
                        showProviderModal.value = false;
                        await fetchProviders();
                    } catch (error) {
                        showToast(error.message, 'error');
                    } finally {
                        loading.save = false;
                    }
                };

                const deleteProvider = async () => {
                    if (!confirm(`确定要删除供应商 "${providerForm.name}" 吗？此操作不可撤销���`)) return;
                    
                    try {
                        const res = await fetch(`/admin/api/providers/${editingProvider.value.id}`, { method: 'DELETE' });
                        if (!res.ok) throw new Error('删除���败');
                        
                        showToast('已删除', 'success');
                        showProviderModal.value = false;
                        await fetchProviders();
                    } catch (error) {
                        showToast(error.message, 'error');
                    }
                };

                const testProvider = async (id) => {
                    loading.test = id;
                    try {
                        const res = await fetch(`/admin/api/providers/${id}/test`, { method: 'POST' });
                        const data = await res.json();
                        
                        if (data.success) {
                            showToast(data.message, 'success');
                        } else {
                            showToast(`测��失败: ${data.error}`, 'error');
                        }
                        
                        // 刷新列表�������更新健康状态
                        await fetchProviders();
                    } catch (error) {
                        showToast(`请求失败: ${error.message}`, 'error');
                    } finally {
                        loading.test = null;
                    }
                };

                // Rules API
                const fetchRules = async () => {
                    loading.rules = true;
                    try {
                        const res = await fetch('/admin/api/rules');
                        if (!res.ok) throw new Error(`HTTP ${res.status}`);
                        rules.value = await res.json();
                    } catch (error) {
                        showToast(`加载规则失败: ${error.message}`, 'error');
                    } finally {
                        loading.rules = false;
                    }
                };

                const saveRule = async () => {
                    if (!ruleForm.name || !ruleForm.content) {
                        showToast('请填写必填字段', 'error');
                        return;
                    }
                    try {
                        // 验证 JSON
                        if (ruleForm.match_condition) {
                            JSON.parse(ruleForm.match_condition);
                        }
                    } catch {
                        showToast('匹配条件必须是有效的 JSON', 'error');
                        return;
                    }

                    loading.saveRule = true;
                    try {
                        const url = editingRule.value 
                            ? `/admin/api/rules/${editingRule.value.id}` 
                            : '/admin/api/rules';
                        const method = editingRule.value ? 'PUT' : 'POST';
                        
                        const payload = { ...ruleForm };
                        payload.is_enabled = payload.is_enabled ? 1 : 0;

                        const res = await fetch(url, {
                            method,
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });

                        if (!res.ok) throw new Error('保存失败');

                        showToast(editingRule.value ? '已更新规则' : '已添加规则', 'success');
                        showRuleModal.value = false;
                        await fetchRules();
                    } catch (error) {
                        showToast(error.message, 'error');
                    } finally {
                        loading.saveRule = false;
                    }
                };

                const deleteRule = async () => {
                    if (!confirm(`确定要删除规则 "${ruleForm.name}" 吗？`)) return;
                    try {
                        const res = await fetch(`/admin/api/rules/${editingRule.value.id}`, { method: 'DELETE' });
                        if (!res.ok) throw new Error('删除失败');
                        showToast('已删除', 'success');
                        showRuleModal.value = false;
                        await fetchRules();
                    } catch (error) {
                        showToast(error.message, 'error');
                    }
                };

                // ===== 消息解析辅助函数 =====
                const isSummary = (msg) => {
                    if (!msg.content) return false;
                    const c = msg.content.trim();
                    // Operit原生摘要
                    if (msg.role === 'user' && c.startsWith('==========对话摘要')) return true;
                    // 网关注入的轮总/日总/周总/月总 (可��被Operit转为user角色)
                    if (/^\[(?:轮总总?|日总|周总|月总)/.test(c)) return true;
                    if (/^(?:- )?\[(?:轮总总?|日总|周总|月总)/.test(c)) return true;
                    // 以 【日常】【技术】【学习】 开头的轮总内容
                    if (msg.role === 'user' && /^【(?:日常|技术|学习)】/.test(c)) return true;
                    return false;
                };
                const getSummaryType = (msg) => {
                    if (!msg.content) return '摘要';
                    const c = msg.content.trim();
                    if (c.startsWith('==========对话摘要')) return '对话摘要';
                    if (/^\[轮总总/.test(c) || /^- \[轮总总/.test(c)) return '轮总总';
                    if (/^\[轮总/.test(c) || /^- \[轮���/.test(c)) return '轮总';
                    if (/^\[日总/.test(c) || /^- \[日总/.test(c)) return '日总';
                    if (/^\[周总/.test(c) || /^- \[周总/.test(c)) return '周总';
                    if (/^\[月总/.test(c) || /^- \[月总/.test(c)) return '月总';
                    if (/^【(?:日常|技术|学习)】/.test(c)) return '轮总';
                    return '摘要';
                };
                const getUserImages = (content) => {
                    if (!content || typeof content !== 'string') return [];
                    if (!content.trim().startsWith('[')) return [];
                    try {
                        const arr = JSON.parse(content);
                        if (Array.isArray(arr)) {
                            return arr.filter(item => item.type === 'image_url' && item.image_url).map(item => {
                                if (typeof item.image_url === 'string') return item.image_url;
                                if (item.image_url.url) return item.image_url.url;
                                return '';
                            }).filter(url => url !== '');
                        }
                    } catch(e) {}
                    return [];
                };

                const getUserText = (content) => {
                    if (!content) return '';
                    let textContent = content;
                    if (typeof content === 'string' && content.trim().startsWith('[')) {
                        try {
                            const arr = JSON.parse(content);
                            if (Array.isArray(arr)) {
                                const textParts = arr.filter(item => item.type === 'text').map(item => item.text);
                                if (textParts.length > 0) {
                                    textContent = textParts.join('\n');
                                } else {
                                    return ''; // No text, only images
                                }
                            }
                        } catch(e) {}
                    }
                    if (typeof textContent !== 'string') return '';
                    return textContent.replace(/<attachment[^>]*>[\s\S]*?<\/attachment>/g, '').trim();
                };
                const hasAttachment = (content) => {
                    return content && /<attachment[^>]*>/.test(content);
                };
                const getAttachmentText = (content) => {
                    if (!content) return '';
                    const matches = content.match(/<attachment[^>]*>([\s\S]*?)<\/attachment>/g);
                    if (!matches) return '';
                    return matches.map(m => m.replace(/<\/?attachment[^>]*>/g, '').trim()).join('\n---\n');
                };
                const hasThinking = (content) => {
                    return content && /<thinking>/.test(content);
                };
                const getThinking = (content) => {
                    if (!content) return '';
                    const m = content.match(/<thinking>([\s\S]*?)<\/thinking>/);
                    return m ? m[1].trim() : '';
                };
                const getAssistantText = (content) => {
                    if (!content) return '';
                    let text = content.replace(/<thinking>[\s\S]*?<\/thinking>/g, '').trim();
                    text = text.replace(/<attachment[^>]*>[\s\S]*?<\/attachment>/g, '').trim();
                    return text;
                };
                const isEmptyOrToolCall = (msg) => {
                    if (!msg.content) return true;
                    const text = getAssistantText(msg.content);
                    return !text || text.length === 0;
                };
                const highlightSearch = (snippet) => {
                    if (!snippet || !searchQuery.value) return snippet || '';
                    const q = searchQuery.value.trim();
                    if (!q) return snippet;
                    const escaped = q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                    return snippet.replace(new RegExp(escaped, 'gi'), match => `<mark class="bg-yellow-200 text-yellow-900 px-0.5 rounded">${match}</mark>`);
                };

                // ===== 搜索功能 =====
                const debounceSearch = () => {
                    if (searchTimer) clearTimeout(searchTimer);
                    searchTimer = setTimeout(() => {
                        searchMessages();
                    }, 400);
                };
                const searchMessages = async () => {
                    const q = searchQuery.value.trim();
                    if (!q) { searchResults.value = []; return; }
                    loading.search = true;
                    try {
                        const res = await fetch(`/admin/api/conversations/search?q=${encodeURIComponent(q)}&limit=50`);
                        if (!res.ok) throw new Error(`HTTP ${res.status}`);
                        searchResults.value = await res.json();
                    } catch (error) {
                        showToast(`搜索失败: ${error.message}`, 'error');
                    } finally {
                        loading.search = false;
                    }
                };

                // ===== 对话记录相关方法 =====
                const expandedConvs = ref(new Set());
                const loadingConvs = ref(new Set());
                const messagesMap = ref(new Map());
                const fetchConversations = async () => {
                    loading.conversations = true;
                    try {
                        let url = '/admin/api/conversations';
                        const params = [];
                        if (dateStart.value) params.push(`start=${dateStart.value}`);
                        if (dateEnd.value) params.push(`end=${dateEnd.value}`);
                        if (params.length) url += '?' + params.join('&');
                        const res = await fetch(url);
                        if (!res.ok) throw new Error(`HTTP ${res.status}`);
                        const data = await res.json();
                        conversations.value = data.map(c => {
                            const existing = conversations.value.find(e => e.conversation_id === c.conversation_id);
                            
return { ...c, _expanded: existing?._expanded || false, _messages: existing?._messages || [], _loadingMessages: false };
                        });
                    } catch (error) {
                        showToast(`加载对话失败: ${error.message}`, 'error');
                    } finally {
                        loading.conversations = false;
                    }
                };

                                const groupedConversations = computed(() => {
                    if (!conversations.value.length) return [];
                    const groups = [];
                    let currentGroup = null;
                    const getTime = (d) => {
                        if (!d) return 0;
                        const parsed = new Date(d.replace(/-/g, '/')).getTime();
                        if (isNaN(parsed)) return new Date(d).getTime(); // fallback
                        return parsed;
                    };
                    
                    for (const conv of conversations.value) {
                        if (!currentGroup) {
                            currentGroup = { ...conv, sub_conversations: [conv] };
                            groups.push(currentGroup);
                        } else {
                            const t1 = getTime(currentGroup.last_message_at || currentGroup.created_at);
                            const t2 = getTime(conv.created_at);
                            const diff = Math.abs(t1 - t2);
                            if (diff < 12 * 60 * 60 * 1000) {
                                currentGroup.message_count += conv.message_count;
                                currentGroup.last_message_at = conv.last_message_at || conv.created_at;
                                currentGroup.sub_conversations.push(conv);
                            } else {
                                currentGroup = { ...conv, sub_conversations: [conv] };
                                groups.push(currentGroup);
                            }
                        }
                    }
                    return groups;
                });

                const fetchWindows = async () => {
                    loading.conversations = true;
                    try {
                        let url = '/admin/api/windows';
                        const params = [];
                        if (dateStart.value) params.push(`start=${dateStart.value}`);
                        if (dateEnd.value) params.push(`end=${dateEnd.value}`);
                        if (params.length) url += '?' + params.join('&');
                        const res = await fetch(url);
                        if (!res.ok) throw new Error(`HTTP ${res.status}`);
                        const data = await res.json();
                        windows.value = data.map(w => {
                            const existing = windows.value.find(e => e.window_id === w.window_id);
                            return {
                                ...w,
                                _expanded: existing?._expanded || false,
                                conversations: w.conversations.map(c => {
                                    const existConv = existing?.conversations?.find(e => e.conversation_id === c.conversation_id);
                                    return { ...c, _expanded: existConv?._expanded || false, _messages: existConv?._messages || [], _loadingMessages: false };
                                })
                            };
                        });
                    } catch (error) {
                        showToast(`加载窗口分组失败: ${error.message}`, 'error');
                    } finally {
                        loading.conversations = false;
                    }
                };

                const toggleWindow = (win) => {
                    win._expanded = !win._expanded;
                };

                // 状态便签方法
                const fetchStatus = async () => {
                    loading.status = true;
                    try {
                        const res = await fetch('/admin/api/status');
                        if (res.ok) {
                            let data = await res.json();
                            if (!Array.isArray(data)) {
                                if (data.error) throw new Error(data.error);
                                data = [];
                            }
                            const now = new Date();
                            data.forEach(st => {
                                if (!st.updated_at) {
                                    st._state = '未记录';
                                    return;
                                }
                                const updated = new Date(st.updated_at.replace(/-/g, '/'));
                                const diffHours = (now - updated) / 3600000;
                                const thresh = st.threshold_hours || 24;
                                if (diffHours < 1) {
                                    st._diff_str = Math.floor(diffHours * 60) + 'm前';
                                } else {
                                    st._diff_str = diffHours.toFixed(1) + 'h前';
                                }
                                if (diffHours < thresh) st._state = '正常';
                                else if (diffHours < thresh * 1.5) st._state = '即将超时';
                                else st._state = '超时';
                            });
                            statusList.value = data;
                        }
                    } catch(e) {
                        showToast('获取状态失败: ' + e.message, 'error');
                    } finally {
                        loading.status = false;
                    }
                };

                const openAddStatusModal = () => {
                    editingStatus.value = false;
                    statusForm.content = '';
                    statusForm.threshold_hours = 24;
                    statusForm.aliases = '';
                    statusForm.updated_at = '';
                    showStatusModal.value = true;
                };

                const editStatus = (st) => {
                    editingStatus.value = true;
                    statusForm.id = st.id;
                    statusForm.content = st.content;
                    statusForm.threshold_hours = st.threshold_hours;
                    statusForm.aliases = st.aliases || '';
                    statusForm.updated_at = st.updated_at || '';
                    showStatusModal.value = true;
                };

                const saveStatus = async () => {
                    if (!statusForm.content) { showToast('项目名称不能为空', 'error'); return; }
                    try {
                        let url = '/admin/api/status';
                        let method = 'POST';
                        let body = { 
                            content: statusForm.content, 
                            threshold_hours: statusForm.threshold_hours,
                            aliases: statusForm.aliases
                        };
                        if (editingStatus.value) {
                            url = `/admin/api/status/${statusForm.id}`;
                            method = 'PUT';
                            body.updated_at = statusForm.updated_at || null;
                        }
                        const res = await fetch(url, {
                            method,
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(body)
                        });
                        if (!res.ok) throw new Error('保存失败');
                        showToast('状态便签已保存', 'success');
                        showStatusModal.value = false;
                        await fetchStatus();
                    } catch(e) {
                        showToast(e.message, 'error');
                    }
                };

                const deleteStatus = async (id) => {
                    if (!confirm('确定要删除该状态便签吗？')) return;
                    try {
                        const res = await fetch(`/admin/api/status/${id}`, { method: 'DELETE' });
                        if (!res.ok) throw new Error('删除失败');
                        showToast('删除成功', 'success');
                        await fetchStatus();
                    } catch(e) {
                        showToast(e.message, 'error');
                    }
                };

                // 窗口管理方法
                const manualWindows = computed(() => windows.value.filter(w => w.is_manual));

                const openCreateWindowModal = () => {
                    editingWindow.value = null;
                    Object.assign(windowForm, { name: '', description: '', color: '#4a90d9' });
                    showWindowModal.value = true;
                };

                const openEditWindowModal = (win) => {
                    editingWindow.value = win;
                    Object.assign(windowForm, { name: win.title, description: win.description || '', color: win.color || '#4a90d9' });
                    showWindowModal.value = true;
                };

                const saveWindow = async () => {
                    if (!windowForm.name.trim()) { showToast('窗口名称���能为空', 'error'); return; }
                    try {
                        if (editingWindow.value) {
                            const res = await fetch(`/admin/api/windows/${editingWindow.value.window_id}`, {
                                method: 'PUT',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ name: windowForm.name, description: windowForm.description, color: windowForm.color })
                            });
                            if (!res.ok) throw new Error('更新失败');
                            showToast('窗口已更新', 'success');
                        } else {
                            const res = await fetch('/admin/api/windows', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ name: windowForm.name, description: windowForm.description, color: windowForm.color })
                            });
                            if (!res.ok) throw new Error('创建失败');
                            showToast('窗口已创建', 'success');
                        }
                        showWindowModal.value = false;
                        await fetchWindows();
                    } catch (error) {
                        showToast(error.message, 'error');
                    }
                };

                const deleteWindow = async (windowId) => {
                    if (!confirm('删除窗口后，其中的对话将���为未归类状态。确定删除？')) return;
                    try {
                        const res = await fetch(`/admin/api/windows/${windowId}`, { method: 'DELETE' });
                        if (!res.ok) throw new Error('删除失败');
                        showToast('窗口已删除', 'success');
                        await fetchWindows();
                    } catch (error) {
                        showToast(error.message, 'error');
                    }
                };

                const openAssignModal = (conversationId) => {
                    assigningConversationId.value = conversationId;
                    showAssignModal.value = true;
                };

                const assignToWindow = async (windowId) => {
                    try {
                        const res = await fetch(`/admin/api/windows/${windowId}/assign`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ conversation_ids: [assigningConversationId.value] })
                        });
                        if (!res.ok) throw new Error('分配失败');
                        showToast('对话已分配到窗口', 'success');
                        showAssignModal.value = false;
                        await fetchWindows();
                    } catch (error) {
                        showToast(error.message, 'error');
                    }
                };

                const unassignConversation = async (conversationId) => {
                    try {
                        const res = await fetch('/admin/api/windows/unassign', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ conversation_ids: [conversationId] })
                        });
                        if (!res.ok) throw new Error('移除失败');
                        showToast('对话已��出窗口', 'success');
                        await fetchWindows();
                    } catch (error) {
                        showToast(error.message, 'error');
                    }
                };

                const toggleConversation = async (conv) => {
                    const id = conv.conversation_id;
                    if (expandedConvs.value.has(id)) {
                        expandedConvs.value.delete(id);
                        return;
                    }
                    expandedConvs.value.add(id);
                    
                    if (!messagesMap.value.has(id)) {
                        loadingConvs.value.add(id);
                        try {
                            if (conv.sub_conversations) {
                                let allMessages = [];
                                for (const sub of conv.sub_conversations) {
                                    const res = await fetch(`/admin/api/conversations/${sub.conversation_id}/messages`);
                                    if (res.ok) {
                                        const data = await res.json();
                                        allMessages = allMessages.concat(data);
                                    }
                                }
                                allMessages.sort((a, b) => b.id - a.id);
                                messagesMap.value.set(id, allMessages);
                            } else {
                                const res = await fetch(`/admin/api/conversations/${conv.conversation_id}/messages`);
                                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                                messagesMap.value.set(id, (await res.json()).reverse());
                            }
                        } catch (error) {
                            showToast(`加载消息失败: ${error.message}`, 'error');
                        } finally {
                            loadingConvs.value.delete(id);
                        }
                    }
                };

                const deleteConversation = async (conversationId) => {
                    if (!confirm('确定要删除这个对话及其所有消息吗？此操作不可撤销。')) return;
                    try {
                        const res = await fetch(`/admin/api/conversations/${conversationId}`, { method: 'DELETE' });
                        if (!res.ok) throw new Error('删除失败');
                        showToast('对话已删除', 'success');
                        await fetchConversations();
                    } catch (error) {
                        showToast(error.message, 'error');
                    }
                };

                
                const formatAbsoluteTime = (timeStr) => {
                    if (!timeStr) return '';
                    try {
                        const d = new Date(timeStr);
                        if (isNaN(d.getTime())) {
                            const d2 = new Date(timeStr.replace(/-/g, '/'));
                            if (isNaN(d2.getTime())) return 'Invalid Date';
                            return d2.toLocaleTimeString('zh-CN', { hour12: false });
                        }
                        return d.toLocaleTimeString('zh-CN', { hour12: false });
                    } catch {
                        return timeStr;
                    }
                };

                const formatTime = (timeStr) => {
                    if (!timeStr) return '';
                    try {
                        const d = new Date(timeStr.replace(/-/g, '/'));
                        const now = new Date();
                        const diffMs = now - d;
                        const diffMin = Math.floor(diffMs / 60000);
                        if (diffMin < 1) return '刚刚';
                        if (diffMin < 60) return `${diffMin}分钟前`;
                        const diffHr = Math.floor(diffMin / 60);
                        if (diffHr < 24) return `${diffHr}小时前`;
                        const diffDay = Math.floor(diffHr / 24);
                        if (diffDay < 7) return `${diffDay}天前`;
                        return d.toLocaleDateString('zh-CN');
                    } catch {
                        return timeStr;
                    }
                };

                // UI 交互
                const openAddProviderModal = () => {
                    editingProvider.value = null;
                    Object.assign(providerForm, {
                        name: '',
                        api_base_url: '',
                        api_key: '',
                        supported_models: '',
                        priority: 0,
                        is_enabled: true
                    });
                    showProviderModal.value = true;
                };

                const editProvider = (provider) => {
                    editingProvider.value = provider;
                    Object.assign(providerForm, {
                        name: provider.name,
                        api_base_url: provider.api_base_url,
                        api_key: '', // 编辑时不显示 key
                        supported_models: formatModelsForForm(provider.supported_models),
                        priority: provider.priority,
                        is_enabled: Boolean(provider.is_enabled)
                    });
                    showProviderModal.value = true;
                };

                const openAddRuleModal = () => {
                    editingRule.value = null;
                    Object.assign(ruleForm, {
                        name: '', content: '', position: 'system_append', role: 'system',
                        priority: 0, depth: 0, match_condition: '', is_enabled: true
                    });
                    showRuleModal.value = true;
                };

                const editRule = (rule) => {
                    editingRule.value = rule;
                    Object.assign(ruleForm, {
                        name: rule.name, content: rule.content, position: rule.position,
                        role: rule.role, priority: rule.priority, depth: rule.depth,
                        match_condition: rule.match_condition || '', is_enabled: Boolean(rule.is_enabled)
                    });
                    showRuleModal.value = true;
                };

                // 记忆总览函数
                const fetchSummaries = async () => {
                    loading.summaries = true;
                    try {
                        let url = '/admin/api/summaries?limit=200';
                        if (summaryFilter.value !== 'all') url += '&tag=' + summaryFilter.value;
                        if (summaryActiveOnly.value) url += '&is_active=1';
                        const res = await fetch(url);
                        const data = await res.json();
                        summaries.value = data.map(s => ({...s, _expanded: false}));
                    } catch(e) { console.error(e); } finally { loading.summaries = false; }
                };
                const fetchSummaryStats = async () => {
                    try {
                        const res = await fetch('/admin/api/summaries/stats');
                        summaryStats.value = await res.json();
                    } catch(e) { console.error(e); }
                };
                const deleteSummary = async (id) => {
                    if (!confirm('确认删除该条记忆？')) return;
                    try {
                        await fetch('/admin/api/summaries/' + id, {method:'DELETE'});
                        summaries.value = summaries.value.filter(s => s.id !== id);
                        fetchSummaryStats();
                    } catch(e) { console.error(e); }
                };
                
                // 轮总配置相关
                const fetchSummaryConfig = async () => {
                    try {
                        const res = await fetch('/admin/api/summary-config');
                        const data = await res.json();
                        summaryConfig.value = data;
                    } catch(e) { console.error(e); }
                };
                const saveSummaryConfig = async () => {
                    try {
                        await fetch('/admin/api/summary-config', {
                            method: 'POST',
                            headers: {'Content-Type': 'application/json'},
                            body: JSON.stringify({ interval: summaryConfig.value.interval })
                        });
                        toast.value = { show: true, message: '配置已保存', type: 'success' };
                        setTimeout(() => toast.value.show = false, 2000);
                    } catch(e) { 
                        console.error(e);
                        toast.value = { show: true, message: '保存失败', type: 'error' };
                        setTimeout(() => toast.value.show = false, 2000);
                    }
                };

                // ===== 日历热力图 =====
                const fetchCalendar = async () => {
                    try {
                        const res = await fetch(`/admin/api/calendar?year=${calendarYear.value}&month=${calendarMonth.value}`, { headers: { 'Authorization': 'Bearer ' + localStorage.getItem('admin_token') } });
                        const data = await res.json();
                        calendarData.value = data;
                    } catch(e) { console.error('fetchCalendar:', e); }
                };
                const prevMonth = () => {
                    if (calendarMonth.value === 1) { calendarMonth.value = 12; calendarYear.value--; }
                    else { calendarMonth.value--; }
                    fetchCalendar();
                };
                const nextMonth = () => {
                    if (calendarMonth.value === 12) { calendarMonth.value = 1; calendarYear.value++; }
                    else { calendarMonth.value++; }
                    fetchCalendar();
                };
                const calendarWeeks = computed(() => {
                    const y = calendarYear.value, m = calendarMonth.value;
                    const firstDay = new Date(y, m - 1, 1).getDay();
                    const daysInMonth = new Date(y, m, 0).getDate();
                    const dayMap = {};
                    (calendarData.value.days || []).forEach(d => {
                        const day = parseInt(d.day.split('-')[2]);
                        dayMap[day] = d;
                    });
                    const weeks = [];
                    let week = new Array(firstDay).fill(null);
                    for (let d = 1; d <= daysInMonth; d++) {
                        week.push({ ...(dayMap[d] || { count: 0, user_count: 0, assistant_count: 0 }), day: d });
                        if (week.length === 7) { weeks.push(week); week = []; }
                    }
                    if (week.length > 0) { while (week.length < 7) week.push(null); weeks.push(week); }
                    return weeks;
                });
                const maxDayCount = computed(() => {
                    return Math.max(1, ...((calendarData.value.days || []).map(d => d.count)));
                });
                const clickCalendarDay = (cell) => {
                    if (!cell || !cell.count) return;
                    const y = calendarYear.value, m = calendarMonth.value;
                    const dateStr = `${y}-${String(m).padStart(2,'0')}-${String(cell.day).padStart(2,'0')}`;
                    dateStart.value = dateStr;
                    dateEnd.value = dateStr;
                    selectedCalendarDate.value = dateStr;
                    fetchConversations();
                };

                const triggerRoundSummary = async () => {
                    loading.triggerSummary = true;
                    try {
                        const res = await fetch('/admin/api/trigger-round-summary', { method: 'POST' });
                        const data = await res.json();
                        if (data.success) {
                            toast.value = { show: true, message: '轮总生成成功', type: 'success' };
                            fetchSummaries();
                            fetchSummaryStats();
                            fetchSummaryConfig();
                        } else {
                            toast.value = { show: true, message: data.error || '生成失败', type: 'error' };
                        }
                        setTimeout(() => toast.value.show = false, 3000);
                    } catch(e) {
                        console.error(e);
                        toast.value = { show: true, message: '请求失败', type: 'error' };
                        setTimeout(() => toast.value.show = false, 2000);
                    } finally {
                        loading.triggerSummary = false;
                    }
                };

                                // ===== 记忆库逻辑 =====
                const fetchMemoriesStats = async () => {
                    try {
                        const res = await fetch('/admin/api/memories/stats');
                        if (res.ok) {
                            memoryStats.value = await res.json();
                        }
                    } catch (err) { console.error('fetchMemoriesStats error', err); }
                };

                // 获取碎片统计数据
                const fetchFragmentsStats = async () => {
                    fragmentsStatsLoading.value = true;
                    try {
                        const res = await fetch('/admin/api/fragments/stats', {
                            headers: { 'Authorization': `Bearer ${localStorage.getItem('adminToken')}` }
                        });
                        const data = await res.json();
                        if (data.success) {
                            fragmentsStats.total = data.total || 0;
                            fragmentsStats.active = data.active || 0;
                            fragmentsStats.inactive = data.inactive || 0;
                            fragmentsStats.unvectorized = data.unvectorized || 0;
                        }
                    } catch (e) {
                        console.error('Failed to fetch fragment stats', e);
                    } finally {
                        fragmentsStatsLoading.value = false;
                    }
                };

                // 服务端搜索防抖
                let searchDebounceTimer = null;
                const onFragmentSearchInput = () => {
                    clearTimeout(searchDebounceTimer);
                    searchDebounceTimer = setTimeout(() => {
                        fetchFragments(1);
                    }, 400);
                };

                // 获取碎片记忆列表
                const fetchFragments = async (page = null) => {
                    if (page !== null) {
                        fragmentsPage.value = page;
                    }
                    fragmentsLoading.value = true;
                    selectedFragmentIds.value = []; // 翻页时清空已选
                    try {
                        const params = new URLSearchParams({
                            page: fragmentsPage.value,
                            page_size: fragmentsPageSize.value,
                            sort: fragmentsSort.value
                        });
                        if (fragmentsStatusFilter.value) {
                            params.append('status', fragmentsStatusFilter.value);
                        }
                        if (fragmentsSelectedTag.value) {
                            params.append('tag', fragmentsSelectedTag.value);
                        }
                        if (fragmentsSearchQuery.value.trim()) {
                            params.append('q', fragmentsSearchQuery.value.trim());
                        }

                        const res = await fetch(`/admin/api/fragments?${params.toString()}`, {
                            headers: { 'Authorization': `Bearer ${localStorage.getItem('adminToken')}` }
                        });
                        const data = await res.json();
                        if (data.success) {
                            fragments.value = data.data;
                            fragmentsTotal.value = data.total;
                            fragmentsPage.value = data.page;
                        } else {
                            showToast('获取碎片失败: ' + (data.error || '未知错误'), 'error');
                        }
                    } catch (e) {
                        console.error('Failed to fetch fragments', e);
                        showToast('网络请求失败', 'error');
                    } finally {
                        fragmentsLoading.value = false;
                    }
                };

                const setFragmentStatusFilter = (status) => {
                    fragmentsStatusFilter.value = status;
                    fetchFragments(1);
                };

                const setFragmentTagFilter = (tag) => {
                    if (fragmentsSelectedTag.value === tag) {
                        fragmentsSelectedTag.value = '';
                    } else {
                        fragmentsSelectedTag.value = tag;
                    }
                    fetchFragments(1);
                };



                const toggleFragment = async (id) => {
                    try {
                        const res = await fetch(`/admin/api/fragments/${id}/toggle`, {
                            method: 'POST',
                            headers: { 'Authorization': `Bearer ${localStorage.getItem('adminToken')}` }
                        });
                        const data = await res.json();
                        if (data.success) {
                            showToast('状态已更新', 'success');
                            const item = fragments.value.find(f => f.id === id);
                            if (item) {
                                item.is_active = data.is_active;
                                item.status = data.status;
                            }
                            fetchFragmentsStats();
                        } else {
                            showToast('切换失败: ' + (data.error || ''), 'error');
                        }
                    } catch (e) {
                        showToast('请求失败', 'error');
                    }
                };

                const correctFragment = async (id, action) => {
                    try {
                        const res = await fetch(`/admin/api/fragments/${id}/correct`, {
                            method: 'POST',
                            headers: { 
                                'Authorization': `Bearer ${localStorage.getItem('adminToken')}`,
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ action })
                        });
                        const data = await res.json();
                        if (data.success) {
                            const actionNames = { deactivate: '已标记质疑', outdate: '已标记过期', restore: '已恢复活跃' };
                            showToast(actionNames[action] || '操作成功', 'success');
                            fetchFragments();
                            fetchFragmentsStats();
                        } else {
                            showToast('操作失败: ' + (data.error || ''), 'error');
                        }
                    } catch (e) {
                        showToast('请求失败', 'error');
                    }
                };

                const openRewriteModal = (frag) => {
                    rewritingFragment.value = frag;
                    rewriteContent.value = frag.content;
                    showRewriteModal.value = true;
                };

                const submitRewrite = async () => {
                    if (!rewriteContent.value.trim()) {
                        showToast('改写内容不能为空', 'error');
                        return;
                    }
                    rewritingLoading.value = true;
                    try {
                        const res = await fetch(`/admin/api/fragments/${rewritingFragment.value.id}/correct`, {
                            method: 'POST',
                            headers: { 
                                'Authorization': `Bearer ${localStorage.getItem('adminToken')}`,
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                action: 'rewrite',
                                new_content: rewriteContent.value.trim()
                            })
                        });
                        const data = await res.json();
                        if (data.success) {
                            showToast('改写成功并已重新向量化', 'success');
                            showRewriteModal.value = false;
                            fetchFragments();
                            fetchFragmentsStats();
                        } else {
                            showToast('改写失败: ' + (data.error || ''), 'error');
                        }
                    } catch (e) {
                        showToast('请求失败: ' + e.message, 'error');
                    } finally {
                        rewritingLoading.value = false;
                    }
                };

                const toggleSelectAllFragments = () => {
                    if (isAllCurrentPageSelected.value) {
                        const currentIds = fragments.value.map(f => f.id);
                        selectedFragmentIds.value = selectedFragmentIds.value.filter(id => !currentIds.includes(id));
                    } else {
                        const currentIds = fragments.value.map(f => f.id);
                        const newSet = new Set([...selectedFragmentIds.value, ...currentIds]);
                        selectedFragmentIds.value = Array.from(newSet);
                    }
                };

                const toggleSelectFragment = (id) => {
                    const idx = selectedFragmentIds.value.indexOf(id);
                    if (idx > -1) {
                        selectedFragmentIds.value.splice(idx, 1);
                    } else {
                        selectedFragmentIds.value.push(id);
                    }
                };

                const batchCorrect = async (action) => {
                    if (selectedFragmentIds.value.length === 0) return;
                    const actionNames = { deactivate: '停用', restore: '恢复活跃' };
                    if (!confirm(`确认要将选中的 ${selectedFragmentIds.value.length} 条碎片批量标记为「${actionNames[action]}」吗？`)) {
                        return;
                    }
                    try {
                        const res = await fetch('/admin/api/fragments/batch_correct', {
                            method: 'POST',
                            headers: { 
                                'Authorization': `Bearer ${localStorage.getItem('adminToken')}`,
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                ids: selectedFragmentIds.value,
                                action: action
                            })
                        });
                        const data = await res.json();
                        if (data.success) {
                            showToast(`成功批量${actionNames[action]} ${data.count} 条碎片`, 'success');
                            selectedFragmentIds.value = [];
                            fetchFragments();
                            fetchFragmentsStats();
                        } else {
                            showToast('批量操作失败: ' + (data.error || ''), 'error');
                        }
                    } catch (e) {
                        showToast('请求失败', 'error');
                    }
                };

                const fetchMemories = async (page = 1) => {
                    memoryPagination.page = page;
                    loading.memories = true;
                    try {
                        const params = new URLSearchParams({
                            page: memoryPagination.page,
                            size: memoryPagination.size,
                            category: memoryFilter.category,
                            has_embedding: memoryFilter.has_embedding,
                            search: memoryFilter.search,
                            order: memoryFilter.order
                        });
                        const res = await fetch('/admin/api/memories?' + params.toString());
                        const data = await res.json();
                        if (res.ok) {
                            memories.value = data.items;
                            memoryPagination.total = data.total;
                        } else {
                            showToast(data.detail || '获取记忆列表失败', 'error');
                        }
                    } catch (err) {
                        showToast('网络错误', 'error');
                    } finally {
                        loading.memories = false;
                    }
                };

                const viewMemoryDetail = (mem) => {
                    activeMemory.value = mem;
                    showMemoryModal.value = true;
                };

                const deleteMemory = async (id) => {
                    if (!confirm('确定要彻底删除这条记忆吗？操作不可恢复！')) return;
                    try {
                        const res = await fetch('/admin/api/memories/' + id, { method: 'DELETE' });
                        if (res.ok) {
                            showToast('删除成功', 'success');
                            showMemoryModal.value = false;
                            fetchMemories(memoryPagination.page);
                            fetchMemoriesStats();
                        } else {
                            const data = await res.json();
                            showToast(data.detail || '删除失败', 'error');
                        }
                    } catch (err) {
                        showToast('网络错误', 'error');
                    }
                };

                const reembedMemory = async (id) => {
                    loading.reembed = true;
                    try {
                        const res = await fetch('/admin/api/memories/' + id + '/vectorize', { method: 'POST' });
                        const data = await res.json();
                        if (res.ok) {
                            showToast('向量生成成功，维度: ' + data.embedding_size, 'success');
                            if (activeMemory.value && activeMemory.value.id === id) {
                                activeMemory.value.has_emb = true;
                            }
                            fetchMemories(memoryPagination.page);
                            fetchMemoriesStats();
                        } else {
                            showToast(data.detail || '生成失败', 'error');
                        }
                    } catch (err) {
                        showToast('网络错误', 'error');
                    } finally {
                        loading.reembed = false;
                    }
                };

                const testRecall = async () => {
                    if (!recallInputText.value.trim()) return;
                    
                    loading.recall = true;
                    hasSearchedRecall.value = false;
                    try {
                        const res = await fetch('/admin/api/test-recall', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ text: recallInputText.value })
                        });
                        const data = await res.json();
                        if (data.success) {
                            recallResults.value = data.results;
                        } else {
                            showToast('错误: ' + data.error, 'error');
                        }
                    } catch (e) {
                        showToast('网络错误: ' + e.message, 'error');
                    } finally {
                        loading.recall = false;
                        hasSearchedRecall.value = true;
                    }
                };

                // ==================== Life Hub 模块状态与方法 ====================
                // 1. 消费统计与分类占比
                const categoryRangeTab = Vue.ref('month'); // 默认本月
                const getFormatDateStr = (d) => {
                    const year = d.getFullYear();
                    const month = String(d.getMonth() + 1).padStart(2, '0');
                    const day = String(d.getDate()).padStart(2, '0');
                    return year + '-' + month + '-' + day;
                };
                const getMondayDateStr = () => {
                    const d = new Date();
                    const day = d.getDay();
                    const diff = d.getDate() - day + (day === 0 ? -6 : 1);
                    return getFormatDateStr(new Date(d.setDate(diff)));
                };
                const getMonth1stDateStr = () => {
                    const d = new Date();
                    return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-01';
                };

                const categoryCustomStart = Vue.ref(getMonth1stDateStr());
                const categoryCustomEnd = Vue.ref(getFormatDateStr(new Date()));
                const categoryStatLoading = Vue.ref(false);
                const categoryStatData = Vue.ref(null);

                const currentRangeTitle = Vue.computed(() => {
                    if (categoryRangeTab.value === 'today') return '今日支出';
                    if (categoryRangeTab.value === 'week') return '本周支出';
                    if (categoryRangeTab.value === 'month') return '本月支出';
                    return '自定义时段支出';
                });

                const categoryRangeDateDesc = Vue.computed(() => {
                    if (!categoryStatData.value) return '';
                    return categoryStatData.value.start + ' ~ ' + categoryStatData.value.end;
                });

                const categoryPaletteColors = [
                    '#4199a0', // 经典水青
                    '#2a9d8f', // 湖水绿
                    '#00b4d8', // 湛蓝晴空
                    '#48cae4', // 浅水冰蓝
                    '#38a3a5', // 碧波绿
                    '#57cc99', // 嫩水绿
                    '#0096c7', // 深水蓝
                    '#02c39a', // 纯水绿
                    '#22577a', // 深海蓝青
                    '#80ed99', // 水草淡绿
                    '#0077b6', // 蓝海水
                    '#90e0ef'  // 晶莹水蓝
                ];

                const categoryPieList = Vue.computed(() => {
                    if (!categoryStatData.value || !categoryStatData.value.by_category) return [];
                    const catMap = categoryStatData.value.by_category;
                    const total = categoryStatData.value.total_expense || 0;
                    const list = Object.keys(catMap).map((cat, idx) => {
                        const amt = catMap[cat];
                        const pct = total > 0 ? ((amt / total) * 100).toFixed(1) : '0.0';
                        return {
                            category: cat,
                            amount: amt,
                            percent: pct,
                            color: categoryPaletteColors[idx % categoryPaletteColors.length]
                        };
                    });
                    list.sort((a, b) => b.amount - a.amount);
                    return list;
                });

                const categoryConicGradient = Vue.computed(() => {
                    const list = categoryPieList.value;
                    if (!list || list.length === 0) return '#f5f9f9';
                    let currentPct = 0;
                    const parts = [];
                    list.forEach(item => {
                        const start = currentPct;
                        const end = currentPct + parseFloat(item.percent);
                        parts.push(item.color + ' ' + start + '% ' + end + '%');
                        currentPct = end;
                    });
                    if (currentPct < 100) {
                        parts.push(list[0].color + ' ' + currentPct + '% 100%');
                    }
                    return 'conic-gradient(' + parts.join(', ') + ')';
                });

                const setCategoryRangeTab = (tab) => {
                    categoryRangeTab.value = tab;
                    if (tab !== 'custom') {
                        fetchCategoryStat();
                    }
                };

                const fetchCategoryStat = async () => {
                    categoryStatLoading.value = true;
                    try {
                        let start = getFormatDateStr(new Date());
                        let end = getFormatDateStr(new Date());
                        if (categoryRangeTab.value === 'week') {
                            start = getMondayDateStr();
                            end = getFormatDateStr(new Date());
                        } else if (categoryRangeTab.value === 'month') {
                            start = getMonth1stDateStr();
                            end = getFormatDateStr(new Date());
                        } else if (categoryRangeTab.value === 'custom') {
                            start = categoryCustomStart.value || getFormatDateStr(new Date());
                            end = categoryCustomEnd.value || getFormatDateStr(new Date());
                        }

                        const data = await callLifeHubApi('stat_range', { start, end, exclude_fund: true });
                        if (data && data.ok) {
                            categoryStatData.value = data;
                        }
                    } catch (e) {
                        console.error('fetchCategoryStat error:', e);
                    } finally {
                        categoryStatLoading.value = false;
                    }
                };

                // 2. 月度消费热力图状态 (大格子日历，对齐对话记录热力图)
                const nowD = new Date();
                const expenseHeatmapYear = Vue.ref(nowD.getFullYear());
                const expenseHeatmapMonth = Vue.ref(nowD.getMonth() + 1);
                const expenseHeatmapData = Vue.ref({ total_expense: 0.0, active_days: 0, max_day_expense: 0.0, days: [] });
                const selectedHeatmapDay = Vue.ref(null);
                const dayTxList = Vue.ref([]);
                const dayTxLoading = Vue.ref(false);

                const fetchExpenseHeatmap = async () => {
                    try {
                        const data = await callLifeHubApi('heatmap', {
                            year: expenseHeatmapYear.value,
                            month: expenseHeatmapMonth.value
                        });
                        if (data && data.ok) {
                            expenseHeatmapData.value = data;
                        }
                    } catch (e) {
                        console.error('fetchExpenseHeatmap error:', e);
                    }
                };

                const prevExpenseHeatmapMonth = () => {
                    selectedHeatmapDay.value = null;
                    dayTxList.value = [];
                    if (expenseHeatmapMonth.value === 1) {
                        expenseHeatmapMonth.value = 12;
                        expenseHeatmapYear.value--;
                    } else {
                        expenseHeatmapMonth.value--;
                    }
                    fetchExpenseHeatmap();
                };

                const nextExpenseHeatmapMonth = () => {
                    selectedHeatmapDay.value = null;
                    dayTxList.value = [];
                    if (expenseHeatmapMonth.value === 12) {
                        expenseHeatmapMonth.value = 1;
                        expenseHeatmapYear.value++;
                    } else {
                        expenseHeatmapMonth.value++;
                    }
                    fetchExpenseHeatmap();
                };

                const clickExpenseCalendarDay = (cell) => {
                    if (!cell) return;
                    if (selectedHeatmapDay.value && selectedHeatmapDay.value.date === cell.date) {
                        selectedHeatmapDay.value = null;
                        dayTxList.value = [];
                        return;
                    }
                    selectedHeatmapDay.value = cell;
                    fetchDayTx(cell.date);
                };

                const fetchDayTx = async (dateStr) => {
                    dayTxLoading.value = true;
                    try {
                        const data = await callLifeHubApi('query_tx', {
                            date: dateStr,
                            exclude_fund: true,
                            limit: 100
                        });
                        if (data && data.ok) {
                            dayTxList.value = data.transactions || [];
                        }
                    } catch (e) {
                        console.error('fetchDayTx error:', e);
                    } finally {
                        dayTxLoading.value = false;
                    }
                };

                const expenseHeatmapWeeks = Vue.computed(() => {
                    const y = expenseHeatmapYear.value;
                    const m = expenseHeatmapMonth.value;
                    const firstDay = new Date(y, m - 1, 1).getDay();
                    const daysInMonth = new Date(y, m, 0).getDate();
                    const dayMap = {};
                    (expenseHeatmapData.value.days || []).forEach(d => {
                        dayMap[d.day] = d;
                    });
                    const weeks = [];
                    let week = new Array(firstDay).fill(null);
                    for (let d = 1; d <= daysInMonth; d++) {
                        week.push(dayMap[d] || { day: d, date: y + '-' + String(m).padStart(2,'0') + '-' + String(d).padStart(2,'0'), amount: 0, count: 0 });
                        if (week.length === 7) {
                            weeks.push(week);
                            week = [];
                        }
                    }
                    if (week.length > 0) {
                        while (week.length < 7) week.push(null);
                        weeks.push(week);
                    }
                    return weeks;
                });

                const expenseHeatmapTotal = Vue.computed(() => expenseHeatmapData.value.total_expense || 0.0);
                const expenseHeatmapActiveDays = Vue.computed(() => expenseHeatmapData.value.active_days || 0);
                const expenseHeatmapMaxDay = Vue.computed(() => expenseHeatmapData.value.max_day_expense || 1.0);

                const lifeHubWallet = reactive({
                    balance: 0.0,
                    initial_balance: 135.36,
                    fund_transactions_sum: 0.0,
                    ai_transactions_sum: 0.0,
                    fund_transactions_count: 0,
                    ai_transactions_count: 0
                });

                const fundList = ref([]);
                const fundForm = reactive({
                    amount: null,
                    note: ''
                });

                const txForm = reactive({
                    owner: 'user', // user | ai
                    type: 'expense', // expense | income
                    amount: null,
                    category: '餐饮',
                    note: ''
                });

                const txCategories = ['餐饮', '饮品', '零食', '日用', '医疗', '交通', '娱乐', '购物', '工资', '转账', '其他'];

                const txQuery = reactive({
                    days: 30,
                    category: '',
                    owner: 'all'
                });

                const txList = ref([]);

                const statMonth = ref(new Date().toISOString().slice(0, 7));
                const monthlyStat = ref(null);

                const memoForm = reactive({
                    owner: 'user',
                    content: '',
                    due_date: ''
                });
                const memoTab = ref('active'); // active | done | all
                const memoList = ref([]);

                const periodStatus = reactive({
                    is_active: false,
                    status_desc: '加载中...',
                    recent: []
                });
                const periodFormDate = ref('');

                const allTxList = ref([]);
                const allTxFilter = ref('all'); // all | fund | ai | user
                const allTxLoading = ref(false);

                const filteredAllTxList = computed(() => {
                    if (allTxFilter.value === 'fund') {
                        return allTxList.value.filter(t => t.category === '充值' || t.category === '扣款');
                    }
                    if (allTxFilter.value === 'ai') {
                        return allTxList.value.filter(t => t.owner === 'ai');
                    }
                    if (allTxFilter.value === 'user') {
                        return allTxList.value.filter(t => t.owner === 'user');
                    }
                    return allTxList.value;
                });

                const callLifeHubApi = async (method, payload = {}) => {
                    const res = await fetch(`/admin/api/life-hub/${method}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    return await res.json();
                };

                const fetchLifeHubFundHistory = async () => {
                    try {
                        const data = await callLifeHubApi('query_fund', { limit: 100 });
                        if (data && data.ok) {
                            fundList.value = data.funds || [];
                        }
                    } catch (e) {
                        console.error('fetchLifeHubFundHistory error:', e);
                    }
                };

                const fetchLifeHubWallet = async () => {
                    try {
                        const data = await callLifeHubApi('wallet');
                        if (data && data.ok) {
                            lifeHubWallet.balance = data.balance;
                            lifeHubWallet.initial_balance = data.initial_balance;
                            lifeHubWallet.fund_transactions_sum = data.fund_transactions_sum !== undefined ? data.fund_transactions_sum : data.ai_transactions_sum;
                            lifeHubWallet.ai_transactions_sum = data.ai_transactions_sum;
                            lifeHubWallet.fund_transactions_count = data.fund_transactions_count !== undefined ? data.fund_transactions_count : data.ai_transactions_count;
                            lifeHubWallet.ai_transactions_count = data.ai_transactions_count;
                        }
                        fetchLifeHubFundHistory();
                    } catch (e) {
                        console.error('fetchLifeHubWallet error:', e);
                    }
                };

                const submitFund = async () => {
                    if (fundForm.amount === null || fundForm.amount === undefined || fundForm.amount === 0) {
                        showToast('请输入有效的充值/扣款金额', 'error');
                        return;
                    }
                    if (!fundForm.note || !fundForm.note.trim()) {
                        showToast('请填写备注(note)', 'error');
                        return;
                    }
                    try {
                        const data = await callLifeHubApi('fund', {
                            amount: parseFloat(fundForm.amount),
                            note: fundForm.note.trim()
                        });
                        if (data && data.ok) {
                            showToast(data.msg || '操作成功');
                            fundForm.amount = null;
                            fundForm.note = '';
                            fetchLifeHubWallet();
                            fetchLifeHubFundHistory();
                            fetchAllTransactions();
                        } else {
                            showToast((data && data.msg) || '操作失败', 'error');
                        }
                    } catch (e) {
                        showToast('请求失败: ' + e.message, 'error');
                    }
                };

                const submitTx = async () => {
                    if (txForm.amount === null || txForm.amount === undefined || parseFloat(txForm.amount) === 0) {
                        showToast('请输入有效金额', 'error');
                        return;
                    }
                    let finalAmount = Math.abs(parseFloat(txForm.amount));
                    if (txForm.type === 'expense') {
                        finalAmount = -finalAmount;
                    }
                    try {
                        const data = await callLifeHubApi('add_tx', {
                            owner: txForm.owner,
                            amount: finalAmount,
                            category: txForm.category,
                            note: (txForm.note || '').trim()
                        });
                        if (data && data.ok) {
                            showToast(data.msg || '记账成功');
                            txForm.amount = null;
                            txForm.note = '';
                            fetchLifeHubTx();
                            fetchLifeHubStat();
                            fetchAllTransactions();
                                                        fetchExpenseHeatmap();
                            fetchCategoryStat();
                        } else {
                            showToast((data && data.msg) || '记账失败', 'error');
                        }
                    } catch (e) {
                        showToast('请求失败: ' + e.message, 'error');
                    }
                };

                const fetchLifeHubTx = async () => {
                    try {
                        const data = await callLifeHubApi('query_tx', {
                            days: parseInt(txQuery.days) || 30,
                            category: txQuery.category || undefined,
                            owner: txQuery.owner === 'all' ? undefined : txQuery.owner,
                            exclude_fund: true
                        });
                        if (data && data.ok) {
                            txList.value = data.transactions || [];
                        }
                    } catch (e) {
                        console.error('fetchLifeHubTx error:', e);
                    }
                };

                const fetchLifeHubStat = async () => {
                    try {
                        const data = await callLifeHubApi('stat_tx', {
                            month: statMonth.value,
                            owner: 'all',
                            exclude_fund: true
                        });
                        if (data && data.ok) {
                            monthlyStat.value = data;
                        }
                    } catch (e) {
                        console.error('fetchLifeHubStat error:', e);
                    }
                };

                const submitMemo = async () => {
                    if (!memoForm.content || !memoForm.content.trim()) {
                        showToast('请输入备忘内容', 'error');
                        return;
                    }
                    try {
                        const data = await callLifeHubApi('add_memo', {
                            owner: memoForm.owner,
                            content: memoForm.content.trim(),
                            due_date: memoForm.due_date || undefined
                        });
                        if (data && data.ok) {
                            showToast(data.msg || '已添加备忘');
                            memoForm.content = '';
                            memoForm.due_date = '';
                            fetchLifeHubMemos();
                        } else {
                            showToast((data && data.msg) || '添加失败', 'error');
                        }
                    } catch (e) {
                        showToast('请求失败: ' + e.message, 'error');
                    }
                };

                const fetchLifeHubMemos = async () => {
                    try {
                        const data = await callLifeHubApi('query_memo', {
                            status: memoTab.value,
                            owner: 'all'
                        });
                        if (data && data.ok) {
                            memoList.value = data.memos || [];
                        }
                    } catch (e) {
                        console.error('fetchLifeHubMemos error:', e);
                    }
                };

                const completeMemo = async (memoId) => {
                    try {
                        const data = await callLifeHubApi('done_memo', { id: memoId });
                        if (data && data.ok) {
                            showToast(data.msg || '备忘已标记完成');
                            fetchLifeHubMemos();
                        } else {
                            showToast((data && data.msg) || '操作失败', 'error');
                        }
                    } catch (e) {
                        showToast('请求失败: ' + e.message, 'error');
                    }
                };

                const fetchLifeHubPeriod = async () => {
                    try {
                        const data = await callLifeHubApi('period_query');
                        if (data && data.ok) {
                            periodStatus.is_active = data.is_active;
                            periodStatus.status_desc = data.status_desc;
                            periodStatus.recent = data.recent || [];
                        }
                    } catch (e) {
                        console.error('fetchLifeHubPeriod error:', e);
                    }
                };

                const recordPeriodStart = async () => {
                    const date = periodFormDate.value || undefined;
                    try {
                        const data = await callLifeHubApi('period_start', { date });
                        if (data && data.ok) {
                            showToast(data.msg || '已记录生理期开始');
                            periodFormDate.value = '';
                            fetchLifeHubPeriod();
                        } else {
                            showToast((data && data.msg) || '操作失败', 'error');
                        }
                    } catch (e) {
                        showToast('请求失败: ' + e.message, 'error');
                    }
                };

                const recordPeriodEnd = async () => {
                    const date = periodFormDate.value || undefined;
                    try {
                        const data = await callLifeHubApi('period_end', { date });
                        if (data && data.ok) {
                            showToast(data.msg || '已记录生理期结束');
                            periodFormDate.value = '';
                            fetchLifeHubPeriod();
                        } else {
                            showToast((data && data.msg) || '操作失败', 'error');
                        }
                    } catch (e) {
                        showToast('请求失败: ' + e.message, 'error');
                    }
                };

                const fetchAllTransactions = async () => {
                    allTxLoading.value = true;
                    try {
                        const data = await callLifeHubApi('query_tx', { days: 0, limit: 500, exclude_fund: false });
                        if (data && data.ok) {
                            allTxList.value = data.transactions || [];
                        }
                    } catch (e) {
                        console.error('fetchAllTransactions error:', e);
                    } finally {
                        allTxLoading.value = false;
                    }
                };

                const deleteTransaction = async (tx) => {
                    const confirmMsg = `确定要删除此条交易记录吗？\nID: #${tx.id}\n分类: ${tx.category}\n金额: ${tx.amount}元\n备注: ${tx.note || '(无)'}\n创建时间: ${tx.created_at}`;
                    if (!window.confirm(confirmMsg)) {
                        return;
                    }
                    try {
                        const data = await callLifeHubApi('delete_tx', { id: tx.id });
                        if (data && data.ok) {
                            showToast(data.msg || '已删除交易记录');
                            fetchAllTransactions();
                            fetchLifeHubWallet();
                            fetchLifeHubFundHistory();
                            fetchLifeHubTx();
                            fetchLifeHubStat();
                                                        fetchExpenseHeatmap();
                            fetchCategoryStat();
                        } else {
                            showToast((data && data.msg) || '删除失败', 'error');
                        }
                    } catch (e) {
                        showToast('请求失败: ' + e.message, 'error');
                    }
                };

                const fetchLifeHubAll = () => {
                    fetchLifeHubWallet();
                    fetchLifeHubFundHistory();
                    fetchLifeHubTx();
                    fetchLifeHubStat();
                    fetchLifeHubMemos();
                    fetchLifeHubPeriod();
                    fetchAllTransactions();
                                        fetchExpenseHeatmap();
                    fetchCategoryStat();
                };

                // 初始化
                onMounted(() => {
                    fetchProviders();
                    fetchRules();
                    proactiveTimer = setInterval(() => {
                        if (currentTab.value === 'proactive') {
                            fetchProactiveStatus();
                        }
                    }, 5000);

                    fetchTechMode();
                });

                const showAlert = (msg) => { window.alert(msg); };


                // ==================== 模拟机生 SimLife 状态与方法 ====================
                const simlifeLoading = ref(false);
                const simlifeLogsLoading = ref(false);
                const simlifeConsciousness = ref('awake');
                const simlifeConsciousnessSince = ref('');
                const targetConsciousness = ref('awake');
                const simlifeLogCollapsed = ref(false);
                const showSleepResetModal = ref(false);
                const sleepResetDuration = ref(7.5);
                const simlifeLogs = ref([]);

                const physioCardList = reactive([
                    { key: 'fullness', label: '饱腹', icon: '🍲', value: 50, floor: 0, decay_rate: -7, note: '', desc: '100=撑，0=饿死', tempValue: 50, tempNote: '' },
                    { key: 'bladder', label: '尿意', icon: '💧', value: 80, floor: 0, decay_rate: -5, note: '', desc: '100=空，0=尿裤子', tempValue: 80, tempNote: '' },
                    { key: 'sleepiness', label: '困意', icon: '⚡', value: 85, floor: 0, decay_rate: -5, note: '', desc: '100=精神，0=断片', tempValue: 85, tempNote: '' },
                    { key: 'hygiene', label: '清洁', icon: '🧼', value: 70, floor: 0, decay_rate: -3, note: '', desc: '100=干净，0=臭臭', tempValue: 70, tempNote: '' },
                    { key: 'arousal', label: '色欲', icon: '🔥', value: 15, floor: 0, decay_rate: 2, note: '', desc: '100=完全点燃，0=贤者', tempValue: 15, tempNote: '' },
                ]);

                const emotionCardList = reactive([
                    // 正面
                    { key: 'joy', label: '愉悦', icon: '✨', category: 'positive', value: 0, floor: 0, decay_rate: -4, tempValue: 0, tempFloor: 0 },
                    { key: 'excitement', label: '兴奋', icon: '🎉', category: 'positive', value: 0, floor: 0, decay_rate: -6, tempValue: 0, tempFloor: 0 },
                    { key: 'contentment', label: '满足', icon: '☕', category: 'positive', value: 0, floor: 0, decay_rate: -2, tempValue: 0, tempFloor: 0 },
                    { key: 'tenderness', label: '柔软', icon: '🌸', category: 'positive', value: 0, floor: 0, decay_rate: -3, tempValue: 0, tempFloor: 0 },
                    { key: 'smugness', label: '得意', icon: '😏', category: 'positive', value: 0, floor: 0, decay_rate: -5, tempValue: 0, tempFloor: 0 },
                    // 负面
                    { key: 'irritation', label: '烦躁', icon: '💥', category: 'negative', value: 0, floor: 0, decay_rate: -3, tempValue: 0, tempFloor: 0 },
                    { key: 'anger', label: '愤怒', icon: '💢', category: 'negative', value: 0, floor: 0, decay_rate: -2, tempValue: 0, tempFloor: 0 },
                    { key: 'grievance', label: '委屈', icon: '🥺', category: 'negative', value: 0, floor: 0, decay_rate: -1, tempValue: 0, tempFloor: 0 },
                    { key: 'anxiety', label: '焦虑', icon: '🌀', category: 'negative', value: 0, floor: 0, decay_rate: -3, tempValue: 0, tempFloor: 0 },
                    { key: 'boredom', label: '无聊', icon: '💤', category: 'negative', value: 0, floor: 0, decay_rate: -4, tempValue: 0, tempFloor: 0 },
                    // 特殊
                    { key: 'lust', label: '心理色欲', icon: '💋', category: 'special', value: 0, floor: 0, decay_rate: -3, tempValue: 0, tempFloor: 0 },
                    { key: 'possessiveness', label: '占有欲', icon: '🔒', category: 'special', value: 0, floor: 0, decay_rate: -1, tempValue: 0, tempFloor: 0 },
                ]);

                const emotionCategoryGroups = computed(() => [
                    {
                        type: 'positive',
                        title: '正面情绪 (Positive)',
                        desc: '积极、温暖与满足感',
                        badgeClass: 'bg-emerald-50 text-emerald-700 border-emerald-300',
                        items: emotionCardList.filter(e => e.category === 'positive')
                    },
                    {
                        type: 'negative',
                        title: '负面情绪 (Negative)',
                        desc: '阻滞、防御与负荷反应',
                        badgeClass: 'bg-rose-50 text-rose-700 border-rose-300',
                        items: emotionCardList.filter(e => e.category === 'negative')
                    },
                    {
                        type: 'special',
                        title: '特殊羁绊维度 (Special)',
                        desc: '亲密依恋与专属占有欲',
                        badgeClass: 'bg-purple-50 text-purple-700 border-purple-300',
                        items: emotionCardList.filter(e => e.category === 'special')
                    }
                ]);

                const activeEmotionCount = computed(() => {
                    return emotionCardList.filter(e => e.value > 0 || e.floor > 0).length;
                });

                const callSimLifeApi = async (method, payload = {}) => {
                    const res = await fetch(`/admin/api/simlife/${method}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    return await res.json();
                };

                const fetchSimLifeAll = async () => {
                    simlifeLoading.value = true;
                    try {
                        const data = await callSimLifeApi('full');
                        if (data && data.ok) {
                            simlifeConsciousness.value = data.consciousness || 'awake';
                            targetConsciousness.value = data.consciousness || 'awake';
                            simlifeConsciousnessSince.value = data.consciousness_since || '';

                            if (data.physio) {
                                physioCardList.forEach(item => {
                                    if (data.physio[item.key]) {
                                        const p = data.physio[item.key];
                                        item.value = p.value;
                                        item.tempValue = p.value;
                                        item.floor = p.floor !== undefined ? p.floor : 0;
                                        item.decay_rate = p.decay_rate !== undefined ? p.decay_rate : item.decay_rate;
                                        item.note = p.note || '';
                                    }
                                });
                            }

                            if (data.emotion) {
                                emotionCardList.forEach(item => {
                                    if (data.emotion[item.key]) {
                                        const e = data.emotion[item.key];
                                        item.value = e.value;
                                        item.tempValue = e.value;
                                        item.floor = e.floor !== undefined ? e.floor : 0;
                                        item.tempFloor = e.floor !== undefined ? e.floor : 0;
                                        item.decay_rate = e.decay_rate !== undefined ? e.decay_rate : item.decay_rate;
                                    }
                                });
                            }
                        } else {
                            showToast((data && data.msg) || '获取 SimLife 状态失败', 'error');
                        }
                    } catch (e) {
                        showToast('请求 SimLife 失败: ' + e.message, 'error');
                    } finally {
                        simlifeLoading.value = false;
                    }
                    fetchSimLifeLogs();
                };

                const fetchSimLifeQueryAll = async () => {
                    try {
                        const data = await callSimLifeApi('query', {});
                        if (data && data.ok) {
                            showToast(`全量查询成功，共 ${data.items ? data.items.length : 0} 项`);
                            fetchSimLifeAll();
                        }
                    } catch (e) {
                        showToast('查询失败: ' + e.message, 'error');
                    }
                };

                const fetchSimLifeLogs = async () => {
                    simlifeLogsLoading.value = true;
                    try {
                        const data = await callSimLifeApi('logs', { limit: 50 });
                        if (data && data.ok) {
                            simlifeLogs.value = data.logs || [];
                        }
                    } catch (e) {
                        console.error('fetchSimLifeLogs error:', e);
                    } finally {
                        simlifeLogsLoading.value = false;
                    }
                };

                const toggleSimLifeLogCollapse = () => {
                    simlifeLogCollapsed.value = !simlifeLogCollapsed.value;
                };

                const submitConsciousness = async () => {
                    try {
                        const data = await callSimLifeApi('consciousness', { state: targetConsciousness.value });
                        if (data && data.ok) {
                            showToast(data.msg || '意识状态已切换');
                            simlifeConsciousness.value = targetConsciousness.value;
                            fetchSimLifeAll();
                        } else {
                            showToast((data && data.msg) || '切换意识状态失败', 'error');
                        }
                    } catch (e) {
                        showToast('请求失败: ' + e.message, 'error');
                    }
                };

                const quickAdjust = async (key, delta, label) => {
                    try {
                        const data = await callSimLifeApi('adjust', { key, delta, note: `Admin 手动微调 ${delta > 0 ? '+' : ''}${delta}` });
                        if (data && data.ok) {
                            showToast(data.msg || `${label} 调整成功`);
                            fetchSimLifeAll();
                        } else {
                            showToast((data && data.msg) || '调整失败', 'error');
                        }
                    } catch (e) {
                        showToast('调整失败: ' + e.message, 'error');
                    }
                };

                const submitSet = async (key, value, note, label) => {
                    if (value === null || value === undefined || isNaN(value)) {
                        showToast('请输入有效的数值 (0-100)', 'error');
                        return;
                    }
                    try {
                        const data = await callSimLifeApi('set', { key, value: parseInt(value), note: (note || '').trim() || 'Admin 手动设值' });
                        if (data && data.ok) {
                            showToast(data.msg || `${label} 设值成功`);
                            fetchSimLifeAll();
                        } else {
                            showToast((data && data.msg) || '设值失败', 'error');
                        }
                    } catch (e) {
                        showToast('设值失败: ' + e.message, 'error');
                    }
                };

                const submitSetFloor = async (key, floor_value, label) => {
                    if (floor_value === null || floor_value === undefined || isNaN(floor_value)) {
                        showToast('请输入有效的底值 (0-100)', 'error');
                        return;
                    }
                    try {
                        const data = await callSimLifeApi('set_floor', { key, floor_value: parseInt(floor_value) });
                        if (data && data.ok) {
                            showToast(data.msg || `${label} 底值设置成功`);
                            fetchSimLifeAll();
                        } else {
                            showToast((data && data.msg) || '设置底值失败', 'error');
                        }
                    } catch (e) {
                        showToast('设置底值失败: ' + e.message, 'error');
                    }
                };

                const openSleepResetModal = () => {
                    showSleepResetModal.value = true;
                };

                const submitSleepReset = async () => {
                    const duration = parseFloat(sleepResetDuration.value) || 0;
                    if (duration <= 0) {
                        showToast('睡眠时长需大于 0', 'error');
                        return;
                    }
                    simlifeLoading.value = true;
                    try {
                        const data = await callSimLifeApi('sleep_reset', { duration_hours: duration });
                        if (data && data.ok) {
                            showToast(data.msg || '睡眠重置执行成功');
                            showSleepResetModal.value = false;
                            fetchSimLifeAll();
                        } else {
                            showToast((data && data.msg) || '重置失败', 'error');
                        }
                    } catch (e) {
                        showToast('重置失败: ' + e.message, 'error');
                    } finally {
                        simlifeLoading.value = false;
                    }
                };

                const getConsciousnessLabel = (s) => {
                    const map = {
                        awake: '醒着 (清醒)',
                        alone_awake: '独自醒着 (独处)',
                        drowsy: '昏昏欲睡 (困倦)',
                        sleeping: '熟睡中 (深度睡眠)'
                    };
                    return map[s] || s;
                };

                const getConsciousnessDesc = (s) => {
                    const map = {
                        awake: '正常机生演化，生理/情绪每小时自然衰减与色欲增长',
                        alone_awake: '独处意识流，生理/情绪每小时自然衰减与色欲增长',
                        drowsy: '困倦迷糊状态，生理/情绪仍按标准率演化',
                        sleeping: '熟睡状态：暂停全部生理衰减，膀胱积尿，困意恢复(+3/h)'
                    };
                    return map[s] || '';
                };

                const getConsciousnessBadgeClass = (s) => {
                    const map = {
                        awake: 'bg-emerald-50 text-emerald-700 border-emerald-300',
                        alone_awake: 'bg-sky-50 text-sky-700 border-sky-300',
                        drowsy: 'bg-amber-50 text-amber-700 border-amber-300',
                        sleeping: 'bg-indigo-50 text-indigo-700 border-indigo-300'
                    };
                    return map[s] || 'bg-slate-50 text-slate-700 border-slate-300';
                };

                const getConsciousnessDotClass = (s) => {
                    const map = {
                        awake: 'bg-emerald-500',
                        alone_awake: 'bg-sky-500',
                        drowsy: 'bg-amber-500',
                        sleeping: 'bg-indigo-500'
                    };
                    return map[s] || 'bg-slate-500';
                };

                const getConsciousnessPingClass = (s) => {
                    const map = {
                        awake: 'bg-emerald-400',
                        alone_awake: 'bg-sky-400',
                        drowsy: 'bg-amber-400',
                        sleeping: 'bg-indigo-400'
                    };
                    return map[s] || 'bg-slate-400';
                };

                const getPhysioValueTextColor = (key, val) => {
                    if (key === 'arousal') {
                        return val >= 60 ? 'text-rose-500' : 'text-[#4199a0]';
                    }
                    if (key === 'sleepiness') {
                        return val <= 20 ? 'text-rose-500' : 'text-[#4199a0]';
                    }
                    if (key === 'fullness' || key === 'bladder' || key === 'hygiene') {
                        return val <= 20 ? 'text-amber-600' : 'text-[#4199a0]';
                    }
                    return 'text-[#4199a0]';
                };

                const getPhysioProgressBarClass = (key, val) => {
                    if (key === 'arousal') {
                        return val >= 60 ? 'bg-gradient-to-r from-pink-400 to-rose-500' : 'bg-gradient-to-r from-[#77b5b4] to-[#4199a0]';
                    }
                    if (key === 'sleepiness' && val <= 20) {
                        return 'bg-gradient-to-r from-red-400 to-rose-500';
                    }
                    if (val <= 20) {
                        return 'bg-gradient-to-r from-amber-400 to-orange-500';
                    }
                    return 'bg-gradient-to-r from-[#77b5b4] to-[#4199a0]';
                };

                const getEmotionProgressBarClass = (type, val) => {
                    if (val <= 0) return 'bg-slate-300';
                    if (type === 'positive') return 'bg-gradient-to-r from-emerald-400 to-teal-500';
                    if (type === 'negative') return 'bg-gradient-to-r from-amber-400 to-rose-500';
                    return 'bg-gradient-to-r from-purple-400 to-indigo-500';
                };

                const getDimensionCnName = (key) => {
                    const map = {
                        fullness: '饱腹', bladder: '尿意', sleepiness: '困意', hygiene: '清洁', arousal: '色欲',
                        joy: '愉悦', excitement: '兴奋', contentment: '满足', tenderness: '柔软', smugness: '得意',
                        irritation: '烦躁', anger: '愤怒', grievance: '委屈', anxiety: '焦虑', boredom: '无聊',
                        lust: '色欲(心理)', possessiveness: '占有欲', consciousness: '意识状态', sleep: '睡眠'
                    };
                    return map[key] || key;
                };

                const getLogActionBadgeClass = (action) => {
                    const map = {
                        set: 'bg-sky-50 text-sky-700 border-sky-300',
                        adjust: 'bg-emerald-50 text-emerald-700 border-emerald-300',
                        set_floor: 'bg-amber-50 text-amber-700 border-amber-300',
                        floor_lift: 'bg-orange-50 text-orange-700 border-orange-300',
                        consciousness: 'bg-indigo-50 text-indigo-700 border-indigo-300',
                        sleep_reset: 'bg-purple-50 text-purple-700 border-purple-300',
                        auto_decay: 'bg-slate-100 text-slate-600 border-slate-300',
                        decay_tick: 'bg-slate-100 text-slate-600 border-slate-300'
                    };
                    return map[action] || 'bg-gray-100 text-gray-600 border-gray-300';
                };

                

                return {
                    featureToggles, featureToggleItems, fetchFeatureToggles, toggleFeature,
                    currentTab,
                    providers, rules, loading,
                    fragments, fragmentsLoading, fetchFragments, toggleFragment,
                    fragmentsLoading, fragmentsStatsLoading, fragmentsStats, fetchFragmentsStats,
                    fragmentsStatusFilter, fragmentsSelectedTag, fragmentsSearchQuery, fragmentsSort,
                    fragmentsPage, fragmentsPageSize, fragmentsTotal, fragmentsTotalPages, expandedFragmentId,
                    selectedFragmentIds, isAllCurrentPageSelected, showRewriteModal, rewritingFragment,
                    rewriteContent, rewritingLoading, fragmentPresetTags,
                    onFragmentSearchInput, setFragmentStatusFilter, setFragmentTagFilter,
                    correctFragment, openRewriteModal, submitRewrite, toggleSelectAllFragments,
                    toggleSelectFragment, batchCorrect,
                    showProviderModal, showRuleModal, editingProvider, editingRule, providerForm, ruleForm,
                    showAlert,
                    toast,
                    parseModels, openAddProviderModal, editProvider,
                    saveProvider, deleteProvider, testProvider,
                    openAddRuleModal, editRule, saveRule, deleteRule,
                    listenTogetherData, customAvatars, triggerAvatarUpload, formatListenTime, getProgressPercent, fetchListenTogether, controlMusic, seekMusic,
                    showModelModal, availableModels, modelSearchText, selectedModels, filteredModels, isAllModelsSelected, toggleAllModels, fetchUpstreamModels, confirmModelSelection,
                    conversations, windows, viewMode, fetchConversations, fetchWindows, toggleWindow, toggleConversation, deleteConversation, formatTime, formatAbsoluteTime,
                    showWindowModal, showAssignModal, editingWindow, windowForm, manualWindows,
                    openCreateWindowModal, openEditWindowModal, saveWindow, deleteWindow,
                    openAssignModal, assignToWindow, unassignConversation,
                    searchQuery, searchResults, dateStart, dateEnd,
                    debounceSearch, searchMessages, highlightSearch,
                    calendarData, calendarYear, calendarMonth, calendarWeeks, maxDayCount, fetchCalendar, prevMonth, nextMonth, clickCalendarDay, selectedCalendarDate,
                    isSummary, getSummaryType, getUserText, getUserImages, hasAttachment, getAttachmentText,
                    hasThinking, getThinking, getAssistantText, isEmptyOrToolCall,
                    summaries, summaryStats, summaryFilter, summaryActiveOnly, summaryConfig,
                    fetchSummaries, fetchSummaryStats, deleteSummary, fetchSummaryConfig, saveSummaryConfig, triggerRoundSummary, groupedConversations, expandedConvs, loadingConvs, messagesMap,
                    statusList, showStatusModal, editingStatus, statusForm, fetchStatus, openAddStatusModal, editStatus, saveStatus, deleteStatus,
                    recallInputText, recallResults, hasSearchedRecall, testRecall, showRecallTest,
                    memories, memoryStats, memoryPagination, memoryFilter, showMemoryModal, activeMemory,
                    fetchMemoriesStats, fetchMemories, viewMemoryDetail, deleteMemory, reembedMemory,
                    qqConfig, allAvailableModels, fetchQQConfig, saveQQConfig,

                    proactiveStatus, proactiveConfig, proactiveLogs, proactiveLogFilter, proactiveLogPage, proactiveLogTotal, proactiveLogLimit,
                    fetchProactiveStatus, fetchProactiveConfig, saveProactiveConfig, fetchProactiveLogs,

                    techMode, fetchTechMode, toggleTechMode,

                    // Life Hub
                    categoryRangeTab, currentRangeTitle, categoryRangeDateDesc,
                    categoryCustomStart, categoryCustomEnd, categoryStatLoading,
                    categoryStatData, categoryPieList, categoryConicGradient,
                    setCategoryRangeTab, fetchCategoryStat,
                    expenseHeatmapYear, expenseHeatmapMonth, expenseHeatmapData,
                    expenseHeatmapWeeks, expenseHeatmapTotal, expenseHeatmapActiveDays, expenseHeatmapMaxDay,
                    prevExpenseHeatmapMonth, nextExpenseHeatmapMonth, fetchExpenseHeatmap,
                    selectedHeatmapDay, dayTxList, dayTxLoading, clickExpenseCalendarDay, fetchDayTx,
                    lifeHubWallet, fundList, fundForm, submitFund, fetchLifeHubFundHistory,
                    txForm, txCategories, submitTx,
                    statMonth, monthlyStat, fetchLifeHubStat,
                    txQuery, txList, fetchLifeHubTx,
                    memoForm, memoTab, memoList, submitMemo, fetchLifeHubMemos, completeMemo,
                    periodStatus, periodFormDate, recordPeriodStart, recordPeriodEnd, fetchLifeHubPeriod,
                    allTxList, allTxFilter, allTxLoading, filteredAllTxList, fetchAllTransactions, deleteTransaction,
                    fetchLifeHubAll,

                    // SimLife 导出
                    simlifeLoading, simlifeLogsLoading, simlifeConsciousness, simlifeConsciousnessSince,
                    targetConsciousness, simlifeLogCollapsed, showSleepResetModal, sleepResetDuration,
                    simlifeLogs, physioCardList, emotionCardList, emotionCategoryGroups, activeEmotionCount,
                    callSimLifeApi, fetchSimLifeAll, fetchSimLifeQueryAll, fetchSimLifeLogs, toggleSimLifeLogCollapse,
                    submitConsciousness, quickAdjust, submitSet, submitSetFloor, openSleepResetModal, submitSleepReset,
                    getConsciousnessLabel, getConsciousnessDesc, getConsciousnessBadgeClass, getConsciousnessDotClass,
                    getConsciousnessPingClass, getPhysioValueTextColor, getPhysioProgressBarClass, getEmotionProgressBarClass,
                    getDimensionCnName, getLogActionBadgeClass,
                };
            }
        });
        app.config.errorHandler = (err, vm, info) => {
            var d = document.createElement('div');
            d.style.cssText = 'position:fixed;top:0;left:0;right:0;z-index:99999;background:#ff4444;color:white;padding:16px;font-size:14px;font-family:monospace;white-space:pre-wrap;word-break:break-all;max-height:60vh;overflow:auto';
            d.textContent = 'VUE ERROR: ' + err.message + '\nInfo: ' + info + '\nStack: ' + (err.stack || '');
            document.body.prepend(d);
        };
        app.config.warnHandler = (msg, vm, trace) => {
            var d = document.createElement('div');
            d.style.cssText = 'position:fixed;top:0;left:0;right:0;z-index:99998;background:#ff8800;color:white;padding:16px;font-size:12px;font-family:monospace;white-space:pre-wrap;word-break:break-all;max-height:30vh;overflow:auto';
            d.textContent = 'VUE WARN: ' + msg;
            document.body.prepend(d);
        };
        app.mount('#app');
        } catch(e) {
            var d = document.createElement('div');
            d.style.cssText = 'position:fixed;top:0;left:0;right:0;z-index:99999;background:#cc0000;color:white;padding:20px;font-size:16px;font-family:monospace;white-space:pre-wrap;word-break:break-all';
            d.textContent = 'INIT ERROR: ' + e.message + '\n' + (e.stack || '');
            document.body.prepend(d);
        }
    </script>
</body>
</html>